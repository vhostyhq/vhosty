#!/usr/bin/env bash
#
# vhosty: Herd for your tailnet.
# Every folder becomes a private HTTPS site on your own domain,
# reachable from any device on your Tailscale network.
#
#   vhosty setup      first-time setup (domain, DNS, Caddy, PHP-FPM, services)
#   vhosty help       everything else
#
# https://github.com/vhostyhq/vhosty
#
# Runs on Linux (systemd user services) and macOS (launchd).
# Written for the bash that ships with macOS (3.2), so no bash 4+ features.

set -euo pipefail

VHOSTY_VERSION="0.5.0"
VHOSTY_REPO="${VHOSTY_REPO:-vhostyhq/vhosty}"   # where `vhosty update self` gets releases

# ---------------------------------------------------------------------------
# Platform and locations
# ---------------------------------------------------------------------------
if [ "$(uname -s)" = "Darwin" ]; then PLATFORM="macos"; else PLATFORM="linux"; fi
is_macos() { [ "$PLATFORM" = "macos" ]; }
is_linux() { [ "$PLATFORM" = "linux" ]; }

VHOSTY_USER="${SUDO_USER:-${USER:-$(id -un)}}"
if [ -n "${SUDO_USER:-}" ]; then
  VHOSTY_HOME_DIR="$(eval echo "~$SUDO_USER")"
else
  VHOSTY_HOME_DIR="${HOME:-$(eval echo "~$VHOSTY_USER")}"
fi
VHOSTY_DIR="${VHOSTY_DIR:-$VHOSTY_HOME_DIR/.vhosty}"

CONFIG_FILE="$VHOSTY_DIR/config"
SECRETS_FILE="$VHOSTY_DIR/.env"
PHP_INI="$VHOSTY_DIR/php.ini"
BIN_DIR="$VHOSTY_DIR/bin"
CADDY_BIN="$BIN_DIR/caddy"
CADDYFILE="$VHOSTY_DIR/Caddyfile"
ERROR_PAGE="$VHOSTY_DIR/error.html"   # Caddy template for vhosty's own error pages
PHP_CONF_DIR="$VHOSTY_DIR/php"
LOG_DIR="$VHOSTY_DIR/logs"
RUN_DIR="$VHOSTY_DIR/run"
CADDY_LOG="$LOG_DIR/caddy.log"
SITES_DIR="$VHOSTY_DIR/sites"
APPLIED_STAMP="$RUN_DIR/applied"   # fingerprint of the config the services last loaded
BACKUP_STAMP="$RUN_DIR/last-services-backup"   # "epoch folder" of the last services backup
PHP_SHIM="$BIN_DIR/php"

# Installed with `vhosty php install` (Linux: phpX.Y-<name> apt packages)
PHP_PACKAGES="cli fpm common mysql pgsql sqlite3 redis mbstring xml curl zip bcmath intl gd readline igbinary soap"

# macOS: launchd system daemons
DAEMON_DIR="${VHOSTY_DAEMON_DIR:-/Library/LaunchDaemons}"
LABEL_PREFIX="link.vhosty"
# Linux: systemd user units
UNIT_DIR="${XDG_CONFIG_HOME:-$VHOSTY_HOME_DIR/.config}/systemd/user"

if is_macos; then
  CADDY_CERTS="$VHOSTY_HOME_DIR/Library/Application Support/Caddy/certificates"
else
  CADDY_CERTS="${XDG_DATA_HOME:-$VHOSTY_HOME_DIR/.local/share}/caddy/certificates"
fi
CF_API="https://api.cloudflare.com/client/v4"
PHP_DOWNLOADS="https://dl.static-php.dev/static-php-cli/bulk"

# Defaults; ~/.vhosty/config overrides them
VHOSTY_DOMAIN=""
VHOSTY_PARKED=""          # colon-separated folders
VHOSTY_PHP="on"           # on | off
VHOSTY_PHP_DEFAULT=""     # e.g. 8.5; empty = newest installed
VHOSTY_SERVICES_DIR=""    # docker compose project for `vhosty services`
VHOSTY_FPM_PORT=""        # old setting (TCP); FPM now uses sockets in ~/.vhosty/run
VHOSTY_LOG_MAX_MB="10"    # rotate a log once it's bigger than this
VHOSTY_LOG_KEEP="5"       # rotated copies to keep (compressed)
VHOSTY_BACKUP_DIR=""      # where `vhosty services backup` saves; empty = ~/.vhosty/backups
VHOSTY_BACKUP_KEEP="7"    # backups to keep there
VHOSTY_ALLOW_DEBUG=""     # yes = doctor doesn't warn about APP_DEBUG=true (only you on the tailnet)
VHOSTY_PORTS="3000-5999 6006 8000-8099 8888"   # ports <port>.domain reaches (dev servers)

FAILED=0

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------
if [ -t 1 ]; then
  B=$'\033[1m'; G=$'\033[32m'; R=$'\033[31m'; Y=$'\033[33m'; D=$'\033[2m'; N=$'\033[0m'
else
  B=""; G=""; R=""; Y=""; D=""; N=""
fi

ok()    { printf "  %s✓%s %s\n" "$G" "$N" "$*"; }
bad()   { printf "  %s✗%s %s\n" "$R" "$N" "$*"; FAILED=1; }
warn()  { printf "  %s!%s %s\n" "$Y" "$N" "$*"; }
info()  { printf "  %s%s%s\n" "$D" "$*" "$N"; }
step()  { printf "\n%s→ %s%s\n" "$B" "$*" "$N"; }
head_() { printf "\n%s%s%s\n" "$B" "$*" "$N"; }
die()   { printf "%serror:%s %s\n" "$R" "$N" "$*" >&2; exit 1; }

# Temp files and folders, removed when vhosty exits, errors included.
# make_tmp VAR [-d] sets VAR (no subshell, so the path gets recorded).
# One path per line: paths can have spaces (a backup folder like "Backups 2"),
# and splitting them would hand rm -rf the pieces
TMP_PATHS=""
add_tmp() { TMP_PATHS="$TMP_PATHS
$1"; }
cleanup_tmp() {
  local p
  while IFS= read -r p; do [ -z "$p" ] || rm -rf -- "$p"; done <<EOF
$TMP_PATHS
EOF
}
trap cleanup_tmp EXIT
make_tmp() {
  local _p
  _p="$(mktemp ${2:+"$2"})" || die "Couldn't create a temp file"
  add_tmp "$_p"
  printf -v "$1" '%s' "$_p"
}

# Prompts read from the terminal, so they work even when stdin is a pipe.
# With no terminal at all (scripts, CI), they fall back to the default.
has_tty() { { : </dev/tty; } 2>/dev/null; }

ask() { # ask "Question" default -> echoes answer
  local q="$1" def="${2:-}" a=""
  if ! has_tty; then printf '%s' "$def"; return 0; fi
  if [ -n "$def" ]; then
    printf "%s [%s]: " "$q" "$def" >/dev/tty
  else
    printf "%s: " "$q" >/dev/tty
  fi
  IFS= read -r a </dev/tty || true
  [ -n "$a" ] || a="$def"
  printf '%s' "$a"
}

ask_secret() {
  local a=""
  has_tty || return 0
  printf "%s: " "$1" >/dev/tty
  IFS= read -rs a </dev/tty || true
  printf "\n" >/dev/tty
  printf '%s' "$a"
}

confirm() { # confirm "Question" [Y|N default]
  local def="${2:-Y}" a="" hint="[Y/n]"
  [ "$def" = "N" ] && hint="[y/N]"
  [ "${VHOSTY_YES:-}" = "1" ] && return 0
  if ! has_tty; then [ "$def" = "Y" ]; return; fi
  printf "%s %s " "$1" "$hint" >/dev/tty
  IFS= read -r a </dev/tty || true
  [ -n "$a" ] || a="$def"
  case "$a" in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
}

# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------
load_config() {
  if [ -f "$CONFIG_FILE" ]; then
    # shellcheck disable=SC1090
    . "$CONFIG_FILE"
  fi
}

need_config() {
  [ -f "$CONFIG_FILE" ] && [ -n "$VHOSTY_DOMAIN" ] || die "vhosty isn't set up yet. Run: vhosty setup"
}

save_config() {
  local k
  mkdir -p "$VHOSTY_DIR"
  # %q: the file is sourced by every vhosty command and every php call, so a
  # folder name with $(...) or a quote must stay text
  {
    echo "# vhosty config. After editing, run: vhosty rebuild"
    for k in VHOSTY_DOMAIN VHOSTY_PARKED VHOSTY_PHP VHOSTY_PHP_DEFAULT VHOSTY_SERVICES_DIR \
      VHOSTY_LOG_MAX_MB VHOSTY_LOG_KEEP VHOSTY_BACKUP_DIR VHOSTY_BACKUP_KEEP VHOSTY_ALLOW_DEBUG VHOSTY_PORTS; do
      printf '%s=%q\n' "$k" "${!k}"
    done
  } >"$CONFIG_FILE"
}

# A config copied from another machine: drop the old FPM port, and move
# parked folders from another home directory (/Users/me/Dev) to this one.
migrate_config() {
  local d new="" moved=""
  if [ -n "$VHOSTY_FPM_PORT" ]; then
    info "PHP-FPM now listens on sockets in $RUN_DIR; dropped VHOSTY_FPM_PORT=$VHOSTY_FPM_PORT"
    VHOSTY_FPM_PORT=""
  fi
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    if [ ! -d "$d" ]; then
      case "$d" in
        /Users/*/*|/home/*/*)
          moved="$VHOSTY_HOME_DIR/$(printf '%s' "$d" | cut -d/ -f4-)"
          if [ -d "$moved" ]; then info "parked folder $d → $moved"; d="$moved"; fi
          ;;
      esac
    fi
    case ":$new:" in *":$d:"*) ;; *) new="${new:+$new:}$d" ;; esac
  done <<EOF
$(parked_list)
EOF
  VHOSTY_PARKED="$new"
}

load_token() {
  CF_API_TOKEN="${CF_API_TOKEN:-}"
  local f
  # Second path: the hand-built layout (~/.vhosty/caddy/.env) from before `vhosty setup`
  for f in "$SECRETS_FILE" "$VHOSTY_DIR/caddy/.env"; do
    if [ -z "$CF_API_TOKEN" ] && [ -f "$f" ]; then
      CF_API_TOKEN="$(sed -n 's/^CF_API_TOKEN=//p' "$f" | head -1)"
    fi
  done
}

save_token() {
  mkdir -p "$VHOSTY_DIR"
  ( umask 077; printf 'CF_API_TOKEN=%s\n' "$1" >"$SECRETS_FILE" )
  chmod 600 "$SECRETS_FILE"
}

php_enabled() { [ "$VHOSTY_PHP" = "on" ]; }

# Number of labels in the domain = which {labels.N} holds the site name.
# vhosty.link → 2, box.example.com → 3
domain_depth() { printf '%s' "$VHOSTY_DOMAIN" | awk -F. '{print NF}'; }

# ~ and ~/x expanded, without eval (which would run anything else in it too)
expand_tilde() {
  # shellcheck disable=SC2088 # a literal ~ is what's being matched
  case "$1" in
    "~") echo "$VHOSTY_HOME_DIR" ;;
    "~/"*) echo "$VHOSTY_HOME_DIR/${1#\~/}" ;;
    *) echo "$1" ;;
  esac
}

# Folders go into the Caddyfile inside quotes, where a quote, backslash or
# brace means something else, and parked ones into a :-separated list
check_folder() { # check_folder DIR [parked]
  case "$1" in
    *[\"\\{}]*|*"
"*) die "vhosty can't serve $1: its path has a quote, backslash, brace or line break. Rename it, or move it." ;;
  esac
  if [ "${2:-}" = "parked" ]; then
    case "$1" in *:*) die "vhosty can't park $1: its path has a colon. Rename it, or move it." ;; esac
  fi
}

parked_list() { printf '%s\n' "$VHOSTY_PARKED" | tr ':' '\n' | sed '/^$/d'; }

# ---------------------------------------------------------------------------
# System helpers
# ---------------------------------------------------------------------------
arch_name() { # caddy-style arch name
  case "$(uname -m)" in
    x86_64|amd64) echo amd64 ;;
    arm64|aarch64) echo arm64 ;;
    *) die "Unsupported CPU: $(uname -m)" ;;
  esac
}

tailscale_bin() {
  if command -v tailscale >/dev/null 2>&1; then
    echo tailscale
  elif [ -x /Applications/Tailscale.app/Contents/MacOS/Tailscale ]; then
    echo /Applications/Tailscale.app/Contents/MacOS/Tailscale
  fi
}

ts_ip() {
  local t
  t="$(tailscale_bin)"
  if [ -n "$t" ]; then "$t" ip -4 2>/dev/null | head -1 || true; fi
}

is_tailscale_ip() { # 100.64.0.0/10
  local second
  case "$1" in 100.*) ;; *) return 1 ;; esac
  second="$(printf '%s' "$1" | cut -d. -f2)"
  [ "$second" -ge 64 ] 2>/dev/null && [ "$second" -le 127 ]
}

# Name of the process listening on a TCP port, "?" if it belongs to another user
port_owner() {
  if is_macos; then
    lsof -nP -iTCP:"$1" -sTCP:LISTEN 2>/dev/null | awk 'NR>1 {print $1}' | sort -u | tr '\n' ' ' | sed 's/ $//' || true
  else
    ss -ltnpH "( sport = :$1 )" 2>/dev/null | awk '{
      if (match($0, /users:\(\("[^"]+"/)) { s = substr($0, RSTART + 9, RLENGTH - 10); print s } else print "?"
    }' | sort -u | tr '\n' ' ' | sed 's/ $//' \
      | { IFS= read -r o || true
          # Caddy's port capability hides its sockets from ss; "?" is ours if it's running
          if [ "$o" = "?" ] && [ -f "$UNIT_DIR/vhosty-caddy.service" ] && [ "$(svc_state caddy)" = "running" ]; then o="caddy"; fi
          printf '%s' "$o"; } || true
  fi
}

# Read one value out of JSON. Path uses dots: result.0.id
json_get() {
  local path="$1" input
  input="$(cat)"
  if command -v jq >/dev/null 2>&1; then
    printf '%s' "$input" | jq -r ".$(printf '%s' "$path" | sed -E 's/\.([0-9]+)/[\1]/g') | if . == null then empty else . end" 2>/dev/null
  elif command -v plutil >/dev/null 2>&1; then
    printf '%s' "$input" | plutil -extract "$path" raw -o - - 2>/dev/null || true
  else
    die "Need jq to read API responses (sudo apt install jq)"
  fi
}

download() { # download URL DEST
  if [ -t 2 ]; then curl -fSL --progress-bar --retry 2 -o "$2" "$1"
  else curl -fsSL --retry 2 -o "$2" "$1"; fi
}

open_url() {
  if is_macos; then open "$1"
  elif { [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; } && command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$1" >/dev/null 2>&1 &
  else
    return 1
  fi
}

copy_text() {
  if command -v pbcopy >/dev/null 2>&1; then printf %s "$1" | pbcopy
  elif [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-copy >/dev/null 2>&1; then printf %s "$1" | wl-copy
  elif [ -n "${DISPLAY:-}" ] && command -v xclip >/dev/null 2>&1; then printf %s "$1" | xclip -selection clipboard
  else return 1
  fi
}

# ---------------------------------------------------------------------------
# Cloudflare
# ---------------------------------------------------------------------------
cf() { # cf METHOD PATH [JSON]
  local method="$1" path="$2" body="${3:-}"
  # The token reaches curl on stdin (-K -), not in its arguments, where any
  # user on this machine could read it with ps
  {
    printf 'header = "Authorization: Bearer %s"\n' "$CF_API_TOKEN"
    [ -z "$body" ] || printf 'header = "Content-Type: application/json"\n'
  } | if [ -n "$body" ]; then
    curl -sS -K - --connect-timeout 10 --max-time 30 -X "$method" "$CF_API/$path" --data "$body"
  else
    curl -sS -K - --connect-timeout 10 --max-time 30 -X "$method" "$CF_API/$path"
  fi
}

cf_ok() { [ "$(printf '%s' "$1" | json_get success)" = "true" ]; }

cf_error() { printf '%s' "$1" | json_get errors.0.message; }

cf_verify_token() {
  local r
  r="$(cf GET user/tokens/verify)" || return 1
  cf_ok "$r"
}

# Finds the Cloudflare zone for the domain: vhosty.link, or example.com for box.example.com
cf_zone_id() {
  local candidate="$VHOSTY_DOMAIN" r id
  while [ "$(printf '%s' "$candidate" | awk -F. '{print NF}')" -ge 2 ]; do
    r="$(cf GET "zones?name=$candidate")"
    id="$(printf '%s' "$r" | json_get result.0.id)"
    if [ -n "$id" ]; then
      echo "$id"
      return 0
    fi
    candidate="${candidate#*.}"
  done
  return 1
}

# Creates or updates the *.domain A record → this machine's Tailscale IP, DNS only
dns_sync() {
  local ip zone name r rid current proxied body
  ip="$(ts_ip)"
  [ -n "$ip" ] || die "Couldn't get this machine's Tailscale IP. Is Tailscale running?"
  load_token
  [ -n "$CF_API_TOKEN" ] || die "No Cloudflare token. Run: vhosty setup"

  zone="$(cf_zone_id)" || die "No Cloudflare zone found for $VHOSTY_DOMAIN. Is the domain added to Cloudflare, and does the token have Zone → Read?"
  name="*.$VHOSTY_DOMAIN"
  body="{\"type\":\"A\",\"name\":\"$name\",\"content\":\"$ip\",\"ttl\":1,\"proxied\":false,\"comment\":\"vhosty\"}"

  r="$(cf GET "zones/$zone/dns_records?type=A&name=%2A.$VHOSTY_DOMAIN")"
  rid="$(printf '%s' "$r" | json_get result.0.id)"

  if [ -z "$rid" ]; then
    r="$(cf POST "zones/$zone/dns_records" "$body")"
    cf_ok "$r" || die "Couldn't create $name: $(cf_error "$r")"
    ok "created $name → $ip (DNS only)"
    return 0
  fi

  current="$(printf '%s' "$r" | json_get result.0.content)"
  proxied="$(printf '%s' "$r" | json_get result.0.proxied)"
  if [ "$current" = "$ip" ] && [ "$proxied" = "false" ]; then
    ok "$name → $ip (already correct)"
    return 0
  fi

  if ! is_tailscale_ip "$current"; then
    warn "$name currently points to $current, which isn't a Tailscale address."
    if [ "$(domain_depth)" -eq 2 ]; then
      warn "Something else (a staging server?) may rely on it. Consider a subdomain instead, like box.$VHOSTY_DOMAIN."
    else
      warn "Something else (a staging server?) may rely on it. Consider a different subdomain for vhosty."
    fi
    # --yes is for the questions with an obvious answer; this isn't one
    if [ "${VHOSTY_YES:-}" = "1" ] && [ "${VHOSTY_OVERWRITE_DNS:-}" != "1" ]; then
      die "Left $name unchanged: --yes doesn't replace a record vhosty didn't make. Add --overwrite-dns if you mean it."
    fi
    confirm "Point $name at this machine anyway?" N || die "Left $name unchanged."
  fi

  r="$(cf PUT "zones/$zone/dns_records/$rid" "$body")"
  cf_ok "$r" || die "Couldn't update $name: $(cf_error "$r")"
  if [ "$proxied" = "true" ]; then
    ok "updated $name → $ip and turned off Cloudflare's proxy (it causes 525 errors)"
  else
    ok "updated $name → $ip"
  fi
}

# ---------------------------------------------------------------------------
# Caddy
# ---------------------------------------------------------------------------
# A tool from /usr/sbin or /sbin, which aren't on a normal user's PATH on Debian
sbin_cmd() {
  local c
  for c in "$(command -v "$1" 2>/dev/null || true)" "/usr/sbin/$1" "/sbin/$1"; do
    if [ -n "$c" ] && [ -x "$c" ]; then echo "$c"; return 0; fi
  done
  return 1
}

caddy_can_bind() {
  local g
  g="$(sbin_cmd getcap)" || return 1
  "$g" "$CADDY_BIN" 2>/dev/null | grep -q cap_net_bind_service
}

# Lets Caddy bind 80/443 as a normal user. Replacing the binary drops it, so
# this runs again after every download.
caddy_allow_ports() {
  is_linux || return 0
  if caddy_can_bind; then return 0; fi
  local sc
  sc="$(sbin_cmd setcap)" || die "vhosty needs setcap: sudo apt install libcap2-bin"
  info "letting Caddy use ports 80 and 443 without root (asks for your password)"
  sudo "$sc" cap_net_bind_service=+ep "$CADDY_BIN" || die "setcap failed"
}

# The IPv4 address a name resolves to: dig when it's installed, otherwise the
# system resolver (minimal Debian has no dig)
resolve_a() {
  if command -v dig >/dev/null 2>&1; then
    dig +short "$1" A 2>/dev/null | tail -1 || true
  else
    getent ahostsv4 "$1" 2>/dev/null | awk 'NR == 1 {print $1}' || true
  fi
}

install_caddy() {
  local os arch url tmp
  os="darwin"; is_macos || os="linux"
  arch="$(arch_name)"
  url="https://caddyserver.com/api/download?os=$os&arch=$arch&p=github.com%2Fcaddy-dns%2Fcloudflare"
  mkdir -p "$BIN_DIR"
  make_tmp tmp
  info "downloading Caddy with the Cloudflare DNS plugin ($os/$arch)"
  download "$url" "$tmp" || die "Caddy download failed"
  chmod 700 "$tmp"   # it may bind ports below 1024: yours to run, nobody else's
  if is_macos; then xattr -d com.apple.quarantine "$tmp" 2>/dev/null || true; fi
  "$tmp" list-modules 2>/dev/null | grep -q dns.providers.cloudflare \
    || die "Downloaded Caddy is missing the Cloudflare plugin, or doesn't run on this system"
  mv "$tmp" "$CADDY_BIN"
  caddy_allow_ports
  ok "Caddy $("$CADDY_BIN" version | awk '{print $1}')"
}

caddy_installed() { [ -x "$CADDY_BIN" ] && "$CADDY_BIN" list-modules 2>/dev/null | grep -q dns.providers.cloudflare; }

# ---------------------------------------------------------------------------
# PHP versions
#   Linux: apt packages (phpX.Y-fpm), side by side
#   macOS: static PHP-FPM builds in ~/.vhosty/bin/php-fpm-X.Y
# ---------------------------------------------------------------------------
fpm_bin() { if is_macos; then echo "$BIN_DIR/php-fpm-$1"; else echo "/usr/sbin/php-fpm$1"; fi; }
fpm_conf() { echo "$PHP_CONF_DIR/$1/php-fpm.conf"; }
fpm_sock() { echo "$RUN_DIR/php-$1.sock"; }
fpm_log() { echo "$LOG_DIR/php-$1.log"; }

php_installed_versions() { # newest first
  local f
  {
    if is_macos; then
      for f in "$BIN_DIR"/php-fpm-*; do [ -x "$f" ] && echo "${f##*/php-fpm-}"; done
    else
      for f in /usr/sbin/php-fpm[0-9]*; do [ -x "$f" ] && echo "${f#/usr/sbin/php-fpm}"; done
    fi
  } | grep -E '^[0-9]+\.[0-9]+$' | sort -t. -k1,1nr -k2,2nr || true
}

php_is_installed() { [ -x "$(fpm_bin "$1")" ]; }

php_default() {
  if [ -n "$VHOSTY_PHP_DEFAULT" ]; then echo "$VHOSTY_PHP_DEFAULT"; else php_installed_versions | head -1; fi
}

# Versions that need a running FPM: the default, plus every pinned version
php_versions_in_use() {
  local name
  php_enabled || return 0
  {
    php_default
    for name in $(site_names); do
      site_folder "$name" >/dev/null || continue   # gone or unparked (see: vhosty prune)
      [ -n "$SITE_PHP" ] && php_is_installed "$SITE_PHP" && echo "$SITE_PHP"
    done
  } | grep . | awk '!seen[$0]++' || true
}

# The version a site actually runs: its pin if that's installed, else the default
site_php() { # after site_load
  if [ -n "$SITE_PHP" ] && php_is_installed "$SITE_PHP"; then echo "$SITE_PHP"; else php_default; fi
}

valid_version() { printf '%s' "$1" | grep -qE '^[0-9]+\.[0-9]+$' || die "'$1' isn't a PHP version (use e.g. 8.4)"; }

# PHP on PATH outside vhosty's shim, for picking a default on first setup
php_cli_minor() {
  local p
  for p in /usr/bin/php /usr/local/bin/php "$(command -v php 2>/dev/null || true)"; do
    [ -x "$p" ] || continue
    "$p" -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;' 2>/dev/null && return 0
  done
  return 0
}

# macOS: picks the newest static PHP-FPM build for a minor version (8.5 → php-8.5.x)
php_fpm_file() {
  local minor="$1" arch listing
  case "$(arch_name)" in amd64) arch="x86_64" ;; arm64) arch="aarch64" ;; esac
  listing="$(curl -fsSL "$PHP_DOWNLOADS/")" || die "Couldn't reach $PHP_DOWNLOADS"
  printf '%s' "$listing" \
    | grep -oE "php-$(printf '%s' "$minor" | sed 's/\./\\./')\.[0-9]+-fpm-macos-${arch}\.tar\.gz" \
    | sort -u | awk -F- '{split($2,v,"."); printf "%d %s\n", v[3], $0}' \
    | sort -n | tail -1 | cut -d' ' -f2
}

install_php_fpm() { # install_php_fpm 8.5
  local minor="${1:-}" file tmp found
  [ -n "$minor" ] || minor="$(php_cli_minor)"
  [ -n "$minor" ] || minor="8.5"
  if is_linux; then
    php_is_installed "$minor" && { ok "PHP $minor ($("$(fpm_bin "$minor")" -v 2>/dev/null | head -1 | awk '{print $2}'))"; return 0; }
    die "PHP $minor isn't installed. Install it with apt (e.g. sudo apt install php$minor-fpm php$minor-cli)."
  fi
  file="$(php_fpm_file "$minor")"
  [ -n "$file" ] || die "No PHP $minor FPM build for this Mac at $PHP_DOWNLOADS. Try: vhosty update php <version>"
  info "downloading $file"
  make_tmp tmp -d
  download "$PHP_DOWNLOADS/$file" "$tmp/php.tar.gz" || die "PHP-FPM download failed"
  tar -xzf "$tmp/php.tar.gz" -C "$tmp"
  found="$(find "$tmp" -type f -name php-fpm | head -1)"
  [ -n "$found" ] || die "$file didn't contain a php-fpm binary"
  mkdir -p "$BIN_DIR"
  chmod +x "$found"
  xattr -d com.apple.quarantine "$found" 2>/dev/null || true
  mv "$found" "$(fpm_bin "$minor")"
  rm -rf "$tmp"
  ok "$("$(fpm_bin "$minor")" -v 2>/dev/null | head -1)"
}

# vhosty 0.1 on macOS kept one build at bin/php-fpm. Give it a versioned name.
migrate_php_fpm() {
  local v
  is_macos && [ -x "$BIN_DIR/php-fpm" ] || return 0
  v="$("$BIN_DIR/php-fpm" -v 2>/dev/null | head -1 | awk '{print $2}' | cut -d. -f1,2)"
  [ -n "$v" ] || return 0
  [ -e "$(fpm_bin "$v")" ] || mv "$BIN_DIR/php-fpm" "$(fpm_bin "$v")"
}

# ---------------------------------------------------------------------------
# php.ini: key = value lines for every PHP version (web and CLI)
# ---------------------------------------------------------------------------
write_default_php_ini() {
  [ -f "$PHP_INI" ] && return 0
  cat >"$PHP_INI" <<'EOF'
; vhosty: PHP settings for every site and every PHP version (web and CLI).
; They apply on top of the distro's php.ini. After editing, run: vhosty rebuild
memory_limit = 512M
upload_max_filesize = 128M
post_max_size = 128M
EOF
}

# Prints key=value pairs from an ini file (comments, sections and blanks dropped)
ini_pairs() {
  [ -f "$1" ] || return 0
  sed -e 's/^[[:space:]]*//' -e '/^[;#[]/d' -e 's/[[:space:]]*$//' "$1" \
    | grep '=' | sed -E 's/^([^=[:space:]]+)[[:space:]]*=[[:space:]]*/\1=/' || true
}

# key=value lines from stdin, later keys replacing earlier ones, first-seen order kept
ini_merge() {
  awk -F= 'NF >= 2 && $1 != "" { k = $1; v = substr($0, length(k) + 2); if (!(k in val)) order[++n] = k; val[k] = v }
    END { for (i = 1; i <= n; i++) print order[i] "=" val[order[i]] }'
}

valid_ini_key() { printf '%s' "$1" | grep -qE '^[A-Za-z0-9_.-]+$' || die "'$1' isn't a PHP setting name"; }

# Sites with their own PHP settings get their own FPM pool and socket
site_sock() { echo "$RUN_DIR/site-$1.sock"; }

# ---------------------------------------------------------------------------
# Sites: ~/.vhosty/sites/<name>.conf, one per site that differs from the
# defaults (linked, PHP version pinned, PHP settings). Nothing is stored in
# the project folders.
# ---------------------------------------------------------------------------
valid_name() { printf '%s' "$1" | grep -qE '^[a-z0-9]([a-z0-9-]*[a-z0-9])?$'; }
lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }
site_file() { echo "$SITES_DIR/$1.conf"; }

site_names() {
  local f
  for f in "$SITES_DIR"/*.conf; do
    [ -f "$f" ] || continue
    f="${f##*/}"; echo "${f%.conf}"
  done
}

site_load() { # sets SITE_PATH SITE_LINKED SITE_PHP SITE_INI SITE_EXT
  SITE_PATH=""; SITE_LINKED="no"; SITE_PHP=""; SITE_INI=""; SITE_EXT=""
  # shellcheck disable=SC1090
  if [ -f "$(site_file "$1")" ]; then . "$(site_file "$1")"; fi
}

# Writes the loaded SITE_* values, or removes the file when nothing differs
# from the defaults any more
site_save() {
  local f
  f="$(site_file "$1")"
  if [ "$SITE_LINKED" != "yes" ] && [ -z "$SITE_PHP" ] && [ -z "$SITE_INI" ] && [ -z "$SITE_EXT" ]; then
    rm -f "$f"
    return 0
  fi
  mkdir -p "$SITES_DIR"
  {
    echo "# vhosty site: https://$1.$VHOSTY_DOMAIN. Change with vhosty commands, or edit and run: vhosty rebuild"
    printf 'SITE_PATH=%q\n' "$SITE_PATH"
    printf 'SITE_LINKED=%q\n' "$SITE_LINKED"
    printf 'SITE_PHP=%q\n' "$SITE_PHP"
    printf 'SITE_INI=%q\n' "$SITE_INI"
    printf 'SITE_EXT=%q\n' "$SITE_EXT"
  } >"$f"
}

# Site name for a folder: a configured site whose path contains it (deepest
# wins), else the folder directly inside a parked folder
site_from_dir() {
  local dir="$1" name best="" bestlen=0 p rest
  for name in $(site_names); do
    site_load "$name"
    [ -n "$SITE_PATH" ] || continue
    case "$dir/" in
      "$SITE_PATH"/*) if [ ${#SITE_PATH} -gt $bestlen ]; then best="$name"; bestlen=${#SITE_PATH}; fi ;;
    esac
  done
  if [ -n "$best" ]; then echo "$best"; return 0; fi
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    case "$dir/" in
      "$p"/*/*) rest="${dir#"$p"/}"; lower "${rest%%/*}"; return 0 ;;
    esac
  done <<EOF
$(parked_list)
EOF
  return 1
}

# Folder a site is served from: its configured path, else <parked>/<name>.
# A parked site's config (a pin, settings) outlives unparking its folder, so
# a site that isn't linked has a folder only while that folder is parked.
site_dir() {
  site_load "$1"
  if [ -n "$SITE_PATH" ]; then
    if [ "$SITE_LINKED" != "yes" ] && ! is_parked "${SITE_PATH%/*}"; then return 1; fi
    echo "$SITE_PATH"; return 0
  fi
  parked_dir_for "$1"
}

is_parked() { case ":$VHOSTY_PARKED:" in *":$1:"*) return 0 ;; esac; return 1; }

# site_folder NAME: the folder the site is served from, if it's there now
# (loads the site's config, like site_load)
site_folder() {
  local dir
  site_load "$1"   # here, not just inside the $(site_dir) subshell below
  dir="$(site_dir "$1")" && [ -d "$dir" ] && echo "$dir"
}

# Parked folders whose name has capitals (MyApp → myapp). Hostnames are
# lowercase, and on a case-sensitive disk the parked rules only find a
# lowercase folder, so these get a rule of their own, written on rebuild.
# A lowercase folder of the same name wins, as it does in the parked rules.
case_sites() {
  local p f name seen
  seen=" $(site_names | tr '\n' ' ') "
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    for f in "$p"/*/; do
      f="${f%/}"; name="$(lower "${f##*/}")"
      [ -d "$f" ] && [ "$name" != "${f##*/}" ] && valid_name "$name" || continue
      case "$seen" in *" $name "*) continue ;; esac
      [ "$(parked_dir_for "$name")" = "$f" ] || continue
      { php_enabled && [ -f "$f/public/index.php" ]; } || [ -f "$f/index.html" ] || continue
      echo "$name"; seen="$seen$name "
    done
  done <<EOF
$(parked_list)
EOF
}

# Site name from an argument (a name) or the current folder
resolve_site() {
  local name
  if [ -n "${1:-}" ]; then
    name="$(lower "$1")"
  else
    name="$(site_from_dir "$PWD")" || die "$PWD isn't inside a site. Pass a site name, or cd into one."
  fi
  valid_name "$name" || die "'$name' isn't a valid site name (letters, numbers, dashes)"
  echo "$name"
}

# ---------------------------------------------------------------------------
# Generated config
# ---------------------------------------------------------------------------
# Rules for configured sites, and parked folders with capitals in their name.
# They come before the parked wildcards, so a pin or a link wins over the default.
# For a static site served from a project folder: .env, .git and any other
# dotfile answer 404 (index.html sits at the root, next to them), except
# .well-known. Matched on the request path, not the file's, so a parked
# folder inside a dot-folder still works.
static_hide() {
  printf '\t\t@%s {\n\t\t\tpath */.*\n\t\t\tnot path /.well-known/*\n\t\t}\n\t\terror @%s 404' "$1" "$1"
}

caddy_sites() {
  local name dir v sock
  for name in $(site_names) $(case_sites); do
    site_load "$name"
    dir="$(site_dir "$name" || true)"
    if [ -z "$dir" ] || [ ! -d "$dir" ]; then
      printf '\n\t# Site: %s (skipped: its folder is gone, or no longer parked)\n' "$name"
      continue
    fi
    if php_enabled && { [ -f "$dir/public/index.php" ] || [ ! -f "$dir/index.html" ]; }; then
      v="$(site_php)"
      sock="$(fpm_sock "$v")"
      [ -z "$SITE_INI" ] || sock="$(site_sock "$name")"
      cat <<EOF

	# Site: $name → $dir (PHP $v$([ -z "$SITE_INI" ] || echo ", own settings"))
	@site_$name host $name.$VHOSTY_DOMAIN
	handle @site_$name {
		vars {
			vhosty_kind php
			vhosty_php $v
		}
		root * "$dir/public"
		php_fastcgi "unix/$sock"
		file_server
	}
EOF
    else
      cat <<EOF

	# Site: $name → $dir (static)
	@site_$name host $name.$VHOSTY_DOMAIN
	handle @site_$name {
		root * "$dir"
$(static_hide "dot_$name")
		file_server
	}
EOF
    fi
  done
}

# A Caddy expression: true when the subdomain label $1 is a port in
# VHOSTY_PORTS ("3000-5999 6006"). It reads the label itself rather than
# the header_regexp capture, since matchers in one set run in no fixed order.
port_expr() {
  local l="{labels.$1}" r out=""
  for r in $VHOSTY_PORTS; do
    case "$r" in
      *-*) out="$out || (int($l) >= ${r%-*} && int($l) <= ${r#*-})" ;;
      *) out="$out || int($l) == $r" ;;
    esac
  done
  printf '%s.matches("^[0-9]{1,5}$") && (%s)' "$l" "${out# || }"
}

# Checked before writing, in this shell: inside $(port_expr) a die would
# only end the subshell
check_ports() {
  local r
  for r in $VHOSTY_PORTS; do
    case "$r" in
      ''|*[!0-9-]*|-*|*-|*-*-*) die "VHOSTY_PORTS in ~/.vhosty/config: '$r' isn't a port or a range like 3000-3999" ;;
    esac
  done
}

write_caddyfile() {
  local depth i=0 dir v ip bind name sites=""
  check_ports
  mkdir -p "$RUN_DIR"   # for the admin socket
  depth="$(domain_depth)"
  v="$(php_default)"
  # Configured sites whose folder exists, for the "no site found" page
  for name in $(site_names) $(case_sites); do
    dir="$(site_dir "$name" || true)"
    [ -z "$dir" ] || [ ! -d "$dir" ] || sites="$sites $name"
  done
  # Listen on the Tailscale address (and localhost) only, not the LAN
  ip="$(ts_ip)"
  bind="127.0.0.1 ::1"; [ -z "$ip" ] || bind="$ip $bind"
  {
    cat <<EOF
# Generated by vhosty. Don't edit: change ~/.vhosty/config, then run \`vhosty rebuild\`.
{
	default_bind $bind
	# Caddy's admin API, which can load any config: on a socket only you can use,
	# not localhost:2019, where every account on this machine could
	admin "unix/$RUN_DIR/caddy-admin.sock|0600"
}

*.$VHOSTY_DOMAIN {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

EOF
    if [ -n "$(printf '%s' "$VHOSTY_PORTS" | tr -d ' ')" ]; then
      cat <<EOF

	# Ports: 5173.$VHOSTY_DOMAIN → localhost:5173 (Vite and other dev servers),
	# for the ports in VHOSTY_PORTS ($VHOSTY_PORTS)
	@port {
		header_regexp port Host ^(\d+)\.
		expression \`$(port_expr "$depth")\`
	}
	handle @port {
		vars vhosty_kind port
		reverse_proxy localhost:{re.port.1}
	}
EOF
    fi
    cat <<EOF

	# Other ports stay on this machine: whatever listens on localhost there
	# (mail catchers, admin consoles) isn't meant for the tailnet
	@port_closed header_regexp Host ^\d+\.
	handle @port_closed {
		vars vhosty_kind port_closed
		error "vhosty: port not open to the tailnet" 403
	}
EOF
    caddy_sites
    while IFS= read -r dir; do
      [ -n "$dir" ] || continue
      if php_enabled && [ -n "$v" ]; then
        cat <<EOF

	# Parked: $dir (PHP $v, e.g. Laravel)
	@php$i file {
		root "$dir/{labels.$depth}/public"
		try_files index.php
	}
	handle @php$i {
		vars {
			vhosty_kind php
			vhosty_php $v
		}
		root * "$dir/{labels.$depth}/public"
		php_fastcgi "unix/$(fpm_sock "$v")"
		file_server
	}
EOF
      fi
      cat <<EOF

	# Parked: $dir (static: index.html at the folder root)
	@static$i file {
		root "$dir/{labels.$depth}"
		try_files index.html
	}
	handle @static$i {
		root * "$dir/{labels.$depth}"
$(static_hide "dot$i")
		file_server
	}
EOF
      i=$((i + 1))
    done <<EOF
$(parked_list)
EOF
    cat <<EOF

	handle {
		vars vhosty_kind nosite
		error "vhosty: no site found for {host}" 404
	}

	# vhosty's own error pages: no site, and PHP or a dev server not answering.
	# Errors from inside a site (Laravel's 500s, missing assets) pass through.
	handle_errors {
		@vhosty expression {err.status_code} in [502, 503, 504] || {http.vars.vhosty_kind} in ["nosite", "port_closed"]
		handle @vhosty {
			vars {
				vhosty_home "$VHOSTY_HOME_DIR"
				vhosty_parked "$VHOSTY_PARKED"
				vhosty_sites "${sites# }"
				vhosty_php_on "$VHOSTY_PHP"
				vhosty_ports "$VHOSTY_PORTS"
			}
			header Cache-Control no-store
			root * /
			rewrite * "$ERROR_PAGE"
			templates
			file_server
		}
	}
}
EOF
  } >"$CADDYFILE"
}

write_fpm_conf() { # write_fpm_conf 8.5
  local v="$1" kv name
  mkdir -p "$PHP_CONF_DIR/$v" "$LOG_DIR" "$RUN_DIR"
  {
    cat <<EOF
; Generated by vhosty. Change ~/.vhosty/config or ~/.vhosty/php.ini, then run \`vhosty rebuild\`.
[global]
pid = $RUN_DIR/php-$v.pid
error_log = $(fpm_log "$v")
daemonize = no

[default]
listen = $(fpm_sock "$v")
listen.mode = 0600
pm = dynamic
pm.max_children = 10
pm.start_servers = 2
pm.min_spare_servers = 1
pm.max_spare_servers = 4
catch_workers_output = yes
clear_env = no
EOF
    ini_pairs "$PHP_INI" | while IFS= read -r kv; do
      printf 'php_value[%s] = %s\n' "${kv%%=*}" "${kv#*=}"
    done
    # One pool per site with its own settings: a worker never serves another
    # site, so settings can't leak between sites. Idle pools have no workers.
    for name in $(site_names); do
      site_folder "$name" >/dev/null || continue
      [ -n "$SITE_INI" ] && [ "$(site_php)" = "$v" ] || continue
      cat <<EOF

[site-$name]
listen = $(site_sock "$name")
listen.mode = 0600
pm = ondemand
pm.max_children = 10
pm.process_idle_timeout = 60s
catch_workers_output = yes
clear_env = no
EOF
      { ini_pairs "$PHP_INI"; printf '%s\n' "$SITE_INI"; } | ini_merge | while IFS= read -r kv; do
        printf 'php_value[%s] = %s\n' "${kv%%=*}" "${kv#*=}"
      done
    done
  } >"$(fpm_conf "$v")"
}

# ~/.vhosty/error.html: the page Caddy shows for vhosty's own errors (no site
# for a name, PHP-FPM or a dev server not answering). A Caddy template: the
# Caddyfile passes the details in vars, and it's read on every error.
error_page_html() {
  printf '{{- /* Generated by vhosty %s. Rewritten by `vhosty rebuild`. */ -}}\n' "$VHOSTY_VERSION"
  printf '{{- $vhosty := "%s" -}}\n' "$VHOSTY_VERSION"
  cat <<'HTML'
{{- $status := placeholder "http.error.status_code" -}}
{{- $kind := placeholder "http.vars.vhosty_kind" -}}
{{- $php := placeholder "http.vars.vhosty_php" -}}
{{- $home := placeholder "http.vars.vhosty_home" -}}
{{- $labels := splitList "." .Host -}}
{{- $label := first $labels -}}
{{- $domain := join "." (rest $labels) -}}
{{- $nosite := eq $kind "nosite" -}}
{{- $retry := and (not $nosite) (eq $status "502") -}}
{{- $sites := compact (splitList " " (placeholder "http.vars.vhosty_sites")) -}}
{{- $parked := compact (splitList ":" (placeholder "http.vars.vhosty_parked")) -}}
{{- $phpOn := eq (placeholder "http.vars.vhosty_php_on") "on" -}}
{{- $found := "" -}}
{{- $cased := "" -}}
{{- if $nosite -}}
  {{- range $d := $parked -}}{{- if fileExists $d -}}
    {{- range $f := listFiles $d -}}
      {{- $servable := or (and $phpOn (fileExists (printf "%s/%s/public/index.php" $d $f))) (fileExists (printf "%s/%s/index.html" $d $f)) -}}
      {{- if and $servable (regexMatch "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$" $f) -}}
        {{- $sites = append $sites $f -}}
      {{- end -}}
      {{- /* MyApp for myapp: served once vhosty rebuild gives it a rule */ -}}
      {{- if and $servable (not $cased) (ne $f $label) (eq (lower $f) $label) -}}
        {{- $cased = printf "%s/%s" $d $f -}}
      {{- end -}}
    {{- end -}}
    {{- if and (not $found) (fileExists (printf "%s/%s" $d $label)) -}}{{- $found = printf "%s/%s" $d $label -}}{{- end -}}
  {{- end -}}{{- end -}}
  {{- $sites = sortAlpha (uniq $sites) -}}
{{- end -}}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{{if $retry}}<meta http-equiv="refresh" content="2">
{{end}}<title>{{$status}} · {{html .Host}}</title>
<style>
:root { color-scheme: light dark; --bg: #f6f6f4; --card: #fff; --fg: #1b1b1a; --muted: #6b6b66; --line: #e4e4df; --code: #f0f0ec; --accent: #d9480f; }
@media (prefers-color-scheme: dark) { :root { --bg: #111110; --card: #1a1a19; --fg: #ececea; --muted: #9a9a94; --line: #2a2a28; --code: #232321; --accent: #ff8a4c; } }
* { box-sizing: border-box; }
body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 24px; background: var(--bg); color: var(--fg); font: 16px/1.55 system-ui, -apple-system, "Segoe UI", sans-serif; }
main { width: 100%; max-width: 560px; background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 32px; }
.top { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 20px; color: var(--muted); font-size: 13px; }
.brand { font-weight: 600; letter-spacing: .02em; }
.version { font: 12px ui-monospace, SFMono-Regular, Menlo, monospace; }
.status { font: 600 13px ui-monospace, SFMono-Regular, Menlo, monospace; color: var(--accent); }
h1 { margin: 0 0 8px; font-size: 22px; line-height: 1.3; }
p { margin: 0 0 14px; }
.muted { color: var(--muted); }
code, pre { font: 13.5px/1.6 ui-monospace, SFMono-Regular, Menlo, monospace; }
code { background: var(--code); padding: 1px 5px; border-radius: 4px; overflow-wrap: anywhere; }
pre { background: var(--code); padding: 12px 14px; border-radius: 8px; margin: 0 0 14px; overflow-x: auto; }
h2 { margin: 22px 0 8px; font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
ul { margin: 0 0 14px; padding-left: 20px; }
ul.sites { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
ul.sites a { display: inline-block; padding: 4px 10px; border: 1px solid var(--line); border-radius: 999px; color: var(--fg); text-decoration: none; font-size: 14px; }
ul.sites a:hover { border-color: var(--accent); color: var(--accent); }
.waiting { display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: 14px; }
.dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); animation: pulse 1.2s ease-in-out infinite; }
@keyframes pulse { 50% { opacity: .25; } }
details { margin-top: 18px; color: var(--muted); font-size: 14px; }
details pre { margin-top: 8px; white-space: pre-wrap; overflow-wrap: anywhere; }
summary { cursor: pointer; }
</style>
</head>
<body>
<main>
<div class="top"><span><span class="brand">vhosty</span> <span class="version">{{$vhosty}}</span></span><span class="status">{{$status}}</span></div>
{{- if $nosite}}
<h1>No site called <code>{{html $label}}</code></h1>
<p class="muted">Nothing is set up to serve <strong>{{html .Host}}</strong>.</p>
{{- if and $cased (not $found)}}
<p><code>{{if and $home (hasPrefix $home $cased)}}~{{html (trimPrefix $home $cased)}}{{else}}{{html $cased}}{{end}}</code> has capitals in its name, so it needs its own rule. Run <code>vhosty rebuild</code> to serve it here.</p>
{{- else if $found}}
<p><code>{{if and $home (hasPrefix $home $found)}}~{{html (trimPrefix $home $found)}}{{else}}{{html $found}}{{end}}</code> exists, but has no {{if $phpOn}}<code>public/index.php</code> or {{end}}<code>index.html</code>.</p>
{{- else if $parked}}
<h2>Looked for</h2>
<ul>
{{- range $d := $parked}}
{{- $p := printf "%s/%s" $d $label}}{{$p = (or (and $home (hasPrefix $home $p) (printf "~%s" (trimPrefix $home $p))) $p)}}
{{- if $phpOn}}
<li><code>{{html $p}}/public/index.php</code></li>
{{- end}}
<li><code>{{html $p}}/index.html</code></li>
{{- end}}
</ul>
{{- end}}
{{- if $sites}}
<h2>Your sites</h2>
<ul class="sites">
{{- range $sites}}
<li><a href="https://{{html .}}.{{html $domain}}/">{{html .}}</a></li>
{{- end}}
</ul>
{{- end}}
<p class="muted">To serve a folder from somewhere else: <code>vhosty link ~/path/to/app --name {{html $label}}</code></p>
{{- else if eq $kind "port_closed"}}
<h1>Port {{html $label}} isn't open to your tailnet</h1>
<p class="muted">vhosty only forwards the ports in <code>VHOSTY_PORTS</code> (<code>{{html (placeholder "http.vars.vhosty_ports")}}</code>), so anything else listening on this machine's <code>localhost</code>, like a mail catcher or an admin console, stays private to it.</p>
<p>To open port {{html $label}}, add it in <code>~/.vhosty/config</code>, then run <code>vhosty rebuild</code>:</p>
<pre>VHOSTY_PORTS="{{html (placeholder "http.vars.vhosty_ports")}} {{html $label}}"</pre>
{{- else if eq $kind "port"}}
<h1>Nothing is running on port {{html $label}}</h1>
<p class="muted">vhosty forwards <strong>{{html .Host}}</strong> to <code>localhost:{{html $label}}</code>, but nothing answered there.</p>
<p>Start the dev server for port {{html $label}}. It has to listen on <code>localhost</code>, which Vite, Next.js and <code>artisan serve</code> do by default.</p>
{{- else if and (eq $kind "php") (ne $status "504")}}
<h1>PHP {{html $php}} isn't answering</h1>
<p class="muted">Caddy couldn't reach PHP-FPM for <strong>{{html .Host}}</strong>.</p>
<pre>vhosty status
vhosty restart php-{{html $php}}
vhosty logs php-{{html $php}}</pre>
{{- else if eq $status "504"}}
<h1>{{html .Host}} took too long</h1>
<p class="muted">The server behind this site didn't answer in time.</p>
{{- else}}
<h1>{{html .Host}} isn't answering</h1>
<p class="muted">Caddy couldn't get a response from the server behind this site.</p>
{{- end}}
{{- if $retry}}
<p class="waiting"><span class="dot"></span>Checking again every 2 seconds.</p>
{{- end}}
{{- if not (or $nosite (eq $kind "port_closed"))}}
<details><summary>Details</summary><pre>{{html (placeholder "http.error.message")}}</pre></details>
{{- end}}
</main>
</body>
</html>
HTML
}

write_error_page() {
  error_page_html >"$ERROR_PAGE.tmp"
  mv "$ERROR_PAGE.tmp" "$ERROR_PAGE"
}

# ~/.vhosty/bin/php: runs the PHP version (and settings) of the site you're in,
# so `php`, `php artisan` and `composer` match what the browser gets.
# Standalone and quick: it reads the config files directly.
write_shim() {
  mkdir -p "$BIN_DIR"
  cat >"$PHP_SHIM.tmp" <<'SHIM'
#!/usr/bin/env bash
# Generated by vhosty: runs the PHP version pinned for the current folder
# (vhosty isolate), with the settings in ~/.vhosty/php.ini.
# VHOSTY_PHP_VERSION=8.4 php ...  overrides the version for one command.
VHOSTY_DIR="${VHOSTY_DIR:-$HOME/.vhosty}"
VHOSTY_PHP_DEFAULT=""
# shellcheck disable=SC1091
[ -f "$VHOSTY_DIR/config" ] && . "$VHOSTY_DIR/config"

v="${VHOSTY_PHP_VERSION:-}" best=0 ini=""
for f in "$VHOSTY_DIR"/sites/*.conf; do
  [ -f "$f" ] || continue
  SITE_PATH="" SITE_PHP="" SITE_INI=""
  # shellcheck disable=SC1090
  . "$f"
  [ -n "$SITE_PATH" ] || continue
  case "$PWD/" in
    "$SITE_PATH"/*)
      if [ ${#SITE_PATH} -gt $best ]; then
        best=${#SITE_PATH}; ini="$SITE_INI"
        [ -n "${VHOSTY_PHP_VERSION:-}" ] || v="$SITE_PHP"
      fi ;;
  esac
done
v="${v:-$VHOSTY_PHP_DEFAULT}"

real=""
for c in "/usr/bin/php$v" "/usr/local/bin/php$v" "$VHOSTY_DIR/bin/php-$v"; do
  [ -n "$v" ] && [ -x "$c" ] && { real="$c"; break; }
done
if [ -z "$real" ]; then # next php on the PATH that isn't this shim
  IFS=:
  for d in $PATH; do
    # skip this shim however its folder is spelled (~/.vhosty/bin/, a link...)
    [ -x "$d/php" ] || continue
    [ "$d/php" -ef "$0" ] || [ "$d/php" -ef "$VHOSTY_DIR/bin/php" ] && continue
    real="$d/php"; break
  done
  unset IFS
fi
[ -n "$real" ] || { echo "vhosty: no PHP ${v:-found} (vhosty php install $v)" >&2; exit 127; }

# Settings: ~/.vhosty/php.ini, then the site's own
args=()
while IFS= read -r kv; do
  [ -n "$kv" ] && args+=(-d "$kv")
done <<EOF
$( [ -f "$VHOSTY_DIR/php.ini" ] && sed -e 's/^[[:space:]]*//' -e '/^[;#[]/d' -e 's/[[:space:]]*$//' "$VHOSTY_DIR/php.ini" \
     | grep '=' | sed -E 's/^([^=[:space:]]+)[[:space:]]*=[[:space:]]*/\1=/' )
$ini
EOF
exec "$real" ${args[@]+"${args[@]}"} "$@"
SHIM
  chmod 755 "$PHP_SHIM.tmp"
  mv "$PHP_SHIM.tmp" "$PHP_SHIM"
}

write_configs() {
  local v
  write_caddyfile
  write_error_page
  for v in $(php_versions_in_use); do write_fpm_conf "$v"; done
  if php_enabled; then write_shim; else rm -f "$PHP_SHIM"; fi
}

# ---------------------------------------------------------------------------
# Services
#   Names: caddy, php-8.5, php-8.4, ...
#   Linux: systemd user units (vhosty-caddy, vhosty-php@8.5), no sudo needed
#   macOS: launchd daemons (link.vhosty.caddy, link.vhosty.php-8.5)
# ---------------------------------------------------------------------------
svc_all() { # PHP first, so Caddy starts with its upstreams ready
  local v
  for v in $(php_versions_in_use); do printf 'php-%s\n' "$v"; done
  echo caddy
}

# Turns a user argument (caddy, php, php-8.5, php@8.5, 8.5, all) into service names
svc_resolve() {
  local a="${1:-all}" v
  case "$a" in
    all) svc_all ;;
    caddy) echo caddy ;;
    php|php-fpm|fpm)
      php_enabled || die "PHP is turned off in ~/.vhosty/config"
      for v in $(php_versions_in_use); do echo "php-$v"; done ;;
    php-[0-9]*|php@[0-9]*|[0-9]*.[0-9]*)
      v="${a#php}"; v="${v#[-@]}"
      php_is_installed "$v" || die "PHP $v isn't installed"
      echo "php-$v" ;;
    *) die "Unknown service '$a' (use caddy, php, php-8.x, or all)" ;;
  esac
}

svc_log() { case "$1" in caddy) echo "$CADDY_LOG" ;; php-*) fpm_log "${1#php-}" ;; esac; }

svc_cmd() { # the command line that runs a service
  case "$1" in
    caddy) printf '%s\n' "$CADDY_BIN" run --config "$CADDYFILE" --adapter caddyfile --envfile "$SECRETS_FILE" ;;
    php-*) printf '%s\n' "$(fpm_bin "${1#php-}")" --nodaemonize --fpm-config "$(fpm_conf "${1#php-}")" ;;
  esac
}

# --- Linux: systemd user units ---------------------------------------------
sd() { systemctl --user "$@"; }
unit_of() { case "$1" in caddy) echo vhosty-caddy.service ;; php-*) echo "vhosty-php@${1#php-}.service" ;; esac; }

write_units() {
  mkdir -p "$UNIT_DIR" "$LOG_DIR" "$RUN_DIR"
  cat >"$UNIT_DIR/vhosty-caddy.service" <<EOF
# Generated by vhosty
[Unit]
Description=vhosty: Caddy for *.$VHOSTY_DOMAIN

[Service]
Type=notify
EnvironmentFile=$SECRETS_FILE
ExecStart=$CADDY_BIN run --config $CADDYFILE --adapter caddyfile
ExecReload=$CADDY_BIN reload --config $CADDYFILE --adapter caddyfile --force
Restart=on-failure
RestartSec=3
StandardOutput=append:$CADDY_LOG
StandardError=append:$CADDY_LOG

[Install]
WantedBy=default.target
EOF
  cat >"$UNIT_DIR/vhosty-php@.service" <<EOF
# Generated by vhosty. One instance per PHP version: vhosty-php@8.5
[Unit]
Description=vhosty: PHP %i FPM

[Service]
Type=notify
ExecStart=/usr/sbin/php-fpm%i --nodaemonize --fpm-config $PHP_CONF_DIR/%i/php-fpm.conf
ExecReload=/bin/kill -USR2 \$MAINPID
Restart=on-failure
RestartSec=3
StandardOutput=append:$LOG_DIR/php-%i.log
StandardError=append:$LOG_DIR/php-%i.log

[Install]
WantedBy=default.target
EOF
  cat >"$UNIT_DIR/vhosty-logs.service" <<EOF
# Generated by vhosty. Run by vhosty-logs.timer
[Unit]
Description=vhosty: rotate logs

[Service]
Type=oneshot
ExecStart=$BIN_DIR/vhosty logs rotate
EOF
  cat >"$UNIT_DIR/vhosty-logs.timer" <<EOF
# Generated by vhosty
[Unit]
Description=vhosty: rotate logs daily

[Timer]
OnCalendar=daily
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
EOF
  sd daemon-reload
}

# Units that exist for PHP versions vhosty no longer uses
sd_stale_php() {
  local u v keep
  keep=" $(php_versions_in_use | tr '\n' ' ') "
  sd list-units 'vhosty-php@*' --all --plain --no-legend 2>/dev/null | awk '{print $1}' | while IFS= read -r u; do
    v="${u#vhosty-php@}"; v="${v%.service}"
    case "$keep" in *" $v "*) ;; *) echo "$u" ;; esac
  done
  { ls "$UNIT_DIR/default.target.wants" 2>/dev/null || true; } | grep '^vhosty-php@' | while IFS= read -r u; do
    v="${u#vhosty-php@}"; v="${v%.service}"
    case "$keep" in *" $v "*) ;; *) echo "$u" ;; esac
  done || true
}

ensure_linger() {
  [ "$(loginctl show-user "$VHOSTY_USER" -p Linger --value 2>/dev/null)" = "yes" ] && return 0
  info "letting your services run at boot, without logging in (asks for your password)"
  sudo loginctl enable-linger "$VHOSTY_USER" || die "loginctl enable-linger failed"
}

# --- macOS: launchd ---------------------------------------------------------
label_of() { echo "$LABEL_PREFIX.$1"; }
plist_for() { echo "$DAEMON_DIR/$(label_of "$1").plist"; }
is_loaded() { sudo launchctl print "system/$(label_of "$1")" >/dev/null 2>&1; }

launchd_field() {
  sudo launchctl print "system/$(label_of "$1")" 2>/dev/null \
    | awk -F'= ' -v key="$2" '$0 ~ "^\t" key " = " {print $2; exit}' || true
}

write_plist() { # write_plist NAME
  local name="$1" args="" a dest
  while IFS= read -r a; do
    args="$args    <string>$a</string>
"
  done <<EOF
$(svc_cmd "$name")
EOF
  dest="$(plist_for "$name")"
  sudo tee "$dest" >/dev/null <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$(label_of "$name")</string>
  <key>UserName</key><string>$VHOSTY_USER</string>
  <key>WorkingDirectory</key><string>$VHOSTY_DIR</string>
  <key>ProgramArguments</key>
  <array>
$args  </array>
  <key>EnvironmentVariables</key>
  <dict><key>HOME</key><string>$VHOSTY_HOME_DIR</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>$(svc_log "$name")</string>
  <key>StandardErrorPath</key><string>$(svc_log "$name")</string>
</dict>
</plist>
EOF
  sudo chown root:wheel "$dest"
  sudo chmod 644 "$dest"
}

# Daemons for services vhosty no longer runs, including 0.1's link.vhosty.php-fpm
launchd_stale() {
  local f name keep
  keep=" $(svc_all | tr '\n' ' ') "
  for f in "$DAEMON_DIR/$LABEL_PREFIX".*.plist; do
    [ -f "$f" ] || continue
    name="${f##*/$LABEL_PREFIX.}"; name="${name%.plist}"
    case "$keep" in *" $name "*) ;; *) echo "$name" ;; esac
  done
}

# --- Common ------------------------------------------------------------------
svc_installed() {
  if is_linux; then [ -f "$UNIT_DIR/vhosty-caddy.service" ]; else [ -f "$(plist_for caddy)" ]; fi
}

svc_state() { # running | stopped | failed | ...
  local s
  if is_linux; then
    s="$(sd show -p ActiveState --value "$(unit_of "$1")" 2>/dev/null || true)"
    case "$s" in active|reloading) echo running ;; inactive|"") echo stopped ;; *) echo "$s" ;; esac
  else
    s="$(launchd_field "$1" state)"
    echo "${s:-stopped}"
  fi
}

svc_pid() {
  if is_linux; then sd show -p MainPID --value "$(unit_of "$1")" 2>/dev/null || true
  else launchd_field "$1" pid; fi
}

svc_start() {
  if is_linux; then sd enable --now --quiet "$(unit_of "$1")"
  elif is_loaded "$1"; then sudo launchctl kickstart "system/$(label_of "$1")"
  else sudo launchctl bootstrap system "$(plist_for "$1")"; fi
}

svc_stop() {
  if is_linux; then sd stop "$(unit_of "$1")"
  elif is_loaded "$1"; then sudo launchctl bootout "system/$(label_of "$1")" 2>/dev/null || true; fi
}

svc_restart() {
  if is_linux; then sd enable --quiet "$(unit_of "$1")"; sd restart "$(unit_of "$1")"
  elif is_loaded "$1"; then sudo launchctl kickstart -k "system/$(label_of "$1")"
  else sudo launchctl bootstrap system "$(plist_for "$1")"; fi
}

# Graceful where the platform allows: Caddy keeps connections, FPM finishes requests
svc_reload() {
  if is_linux; then
    sd enable --quiet "$(unit_of "$1")"
    # A reload goes through the admin address in the new config; a Caddy
    # started from an older config (localhost:2019) needs a restart instead
    sd reload-or-restart "$(unit_of "$1")" 2>/dev/null || sd restart "$(unit_of "$1")"
  else svc_restart "$1"; fi
}

svc_remove() {
  if is_linux; then
    sd disable --now --quiet "$1" 2>/dev/null || true
    sd reset-failed "$1" 2>/dev/null || true   # or a failed unit is listed, and removed, every rebuild
  else
    if is_loaded "$1"; then sudo launchctl bootout "system/$(label_of "$1")" 2>/dev/null || true; fi
    sudo rm -f "$(plist_for "$1")"
  fi
}

# Installs or refreshes every service definition, starts what's needed and
# removes what isn't. Used by setup and rebuild.
svc_sync() {
  local s
  mkdir -p "$LOG_DIR" "$RUN_DIR"
  # Caddy can bind ports below 1024 (setcap): only its owner may run it
  [ ! -f "$CADDY_BIN" ] || chmod 700 "$CADDY_BIN"
  if is_linux; then
    write_units
    sd enable --now --quiet vhosty-logs.timer
    for s in $(sd_stale_php | sort -u); do svc_remove "$s"; ok "stopped $s (no longer used)"; done
  else
    # No scheduler without another root daemon, so rotate whenever services are set up
    rotate_logs >/dev/null
    sudo -v
    for s in $(launchd_stale); do svc_remove "$s"; ok "removed $(label_of "$s") (no longer used)"; done
    for s in $(svc_all); do
      if is_loaded "$s"; then sudo launchctl bootout "system/$(label_of "$s")" 2>/dev/null || true; fi
      write_plist "$s"
    done
    sleep 1
  fi
}

# Starts what isn't running, reloads what is
svc_apply() {
  local s
  for s in $(svc_all); do
    if [ "$(svc_state "$s")" = "running" ]; then svc_reload "$s"; ok "reloaded $s"
    else svc_start "$s"; ok "started $s"; fi
  done
  mark_applied
}

# ---------------------------------------------------------------------------
# Drift: lets doctor tell "changed but not rebuilt" and "rebuilt but not
# loaded" apart (e.g. after a command was interrupted)
# ---------------------------------------------------------------------------
hash_stdin() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum; else shasum -a 256; fi | awk '{print $1}'
}

generated_hash() {
  local v
  { cat "$CADDYFILE" 2>/dev/null || true
    for v in $(php_versions_in_use); do cat "$(fpm_conf "$v")" 2>/dev/null || true; done; } | hash_stdin
}

mark_applied() { mkdir -p "$RUN_DIR"; generated_hash >"$APPLIED_STAMP"; }

# True when the generated files match what the config would generate now
config_in_sync() {
  local tmp rc=0 v
  make_tmp tmp -d
  ( CADDYFILE="$tmp/Caddyfile"; PHP_CONF_DIR="$tmp/php"; PHP_SHIM="$tmp/php-shim"
    write_error_page() { error_page_html >"$tmp/error.html"; }
    write_configs ) >/dev/null 2>&1 || rc=1
  cmp -s "$tmp/Caddyfile" "$CADDYFILE" || rc=1
  cmp -s "$tmp/error.html" "$ERROR_PAGE" || rc=1
  for v in $(php_versions_in_use); do cmp -s "$tmp/php/$v/php-fpm.conf" "$(fpm_conf "$v")" || rc=1; done
  rm -rf "$tmp"
  return $rc
}

# Why the generated files no longer match what vhosty would write now
drift_reason() {
  local ip
  if [ -f "$ERROR_PAGE" ] && ! grep -qF "\$vhosty := \"$VHOSTY_VERSION\"" "$ERROR_PAGE"; then
    echo "vhosty was updated since the config was generated"
    return 0
  fi
  ip="$(ts_ip)"
  if [ -n "$ip" ] && [ -f "$CADDYFILE" ] && ! grep -qF "default_bind $ip " "$CADDYFILE"; then
    echo "this machine's Tailscale address changed (now $ip)"
    return 0
  fi
  echo "settings changed since the last rebuild"
}

config_applied() { [ -f "$APPLIED_STAMP" ] && [ "$(cat "$APPLIED_STAMP")" = "$(generated_hash)" ]; }

# ---------------------------------------------------------------------------
# Commands: setup
# ---------------------------------------------------------------------------
cmd_setup() {
  local domain="" token="" park="" php="" yes=0 ip o v
  while [ $# -gt 0 ]; do
    case "$1" in
      --domain) domain="$2"; shift 2 ;;
      --token)  token="$2"; shift 2 ;;
      --park)   park="$2"; shift 2 ;;
      --no-php) php="off"; shift ;;
      --php)    php="on"; shift ;;
      -y|--yes) yes=1; shift ;;
      --overwrite-dns) export VHOSTY_OVERWRITE_DNS=1; shift ;;
      *) die "Unknown option '$1'. Usage: vhosty setup [--domain D] [--park DIR] [--no-php] [--yes] [--overwrite-dns] (the token: CF_API_TOKEN=... or --token T)" ;;
    esac
  done
  [ "$yes" = "1" ] && export VHOSTY_YES=1

  load_config

  printf "%svhosty setup%s (%s)\n" "$B" "$N" "$PLATFORM"

  step "Checking this machine"
  ip="$(ts_ip)"
  [ -n "$ip" ] || die "Tailscale isn't running, or its CLI wasn't found. Install and sign in first: https://tailscale.com/download"
  ok "Tailscale IP: $ip"
  if is_linux; then
    command -v jq >/dev/null 2>&1 || die "vhosty needs jq: sudo apt install jq"
    sbin_cmd setcap >/dev/null || die "vhosty needs setcap: sudo apt install libcap2-bin"
    command -v systemctl >/dev/null 2>&1 || die "vhosty on Linux needs systemd"
  fi
  o="$(port_owner 443)"
  if [ -n "$o" ] && [ "$o" != "caddy" ]; then
    warn "port 443 is in use by: $o"
    warn "Herd, Valet, nginx and Apache use 443. Stop them, or vhosty's Caddy can't start."
    confirm "Continue anyway?" N || exit 1
  fi
  migrate_config
  migrate_php_fpm

  step "Domain"
  info "A domain whose DNS is on Cloudflare. vhosty points *.domain at this machine."
  info "Already using the domain's wildcard for something else? Use a subdomain, like box.example.com."
  [ -n "$domain" ] || domain="$(ask "Domain" "$VHOSTY_DOMAIN")"
  domain="$(printf '%s' "$domain" | tr '[:upper:]' '[:lower:]' | sed -E 's#^https?://##; s#^\*\.##; s#/.*$##')"
  printf '%s' "$domain" | grep -qE '^[a-z0-9-]+(\.[a-z0-9-]+)+$' || die "'$domain' doesn't look like a domain"
  VHOSTY_DOMAIN="$domain"

  step "Cloudflare API token"
  load_token
  if [ -n "$token" ]; then
    CF_API_TOKEN="$token"
  elif [ -n "$CF_API_TOKEN" ] && confirm "Use the saved token?" Y; then
    :
  else
    info "Create one at dash.cloudflare.com → My Profile → API Tokens → 'Edit zone DNS'."
    info "It needs Zone → Read and DNS → Edit for $VHOSTY_DOMAIN."
    CF_API_TOKEN="$(ask_secret "Token")"
  fi
  [ -n "$CF_API_TOKEN" ] || die "A token is required"
  cf_verify_token || die "Cloudflare rejected that token"
  save_token "$CF_API_TOKEN"
  ok "token is valid (saved to $SECRETS_FILE, readable only by you)"

  step "Parked folders"
  info "Each folder inside becomes https://<folder>.$VHOSTY_DOMAIN"
  [ -n "$park" ] || park="$(ask "Folder to park" "$(parked_list | head -1 | grep . || echo "$VHOSTY_HOME_DIR/Sites")")"
  park="$(expand_tilde "$park")"
  check_folder "$park" parked
  [ -d "$park" ] || { mkdir -p "$park"; ok "created $park"; }
  park="$(cd "$park" && pwd)"
  case ":$VHOSTY_PARKED:" in
    *":$park:"*) ;;
    *) VHOSTY_PARKED="${VHOSTY_PARKED:+$VHOSTY_PARKED:}$park" ;;
  esac
  parked_list | while IFS= read -r o; do ok "parked $o"; done

  step "PHP"
  if [ -z "$php" ]; then
    if confirm "Serve PHP sites (Laravel etc.) with PHP-FPM?" Y; then php="on"; else php="off"; fi
  fi
  VHOSTY_PHP="$php"
  if php_enabled; then
    v="$(php_default)"
    [ -n "$v" ] || v="$(php_cli_minor)"
    php_is_installed "${v:-none}" || install_php_fpm "$v"
    v="$(php_default)"
    [ -n "$v" ] || die "No PHP-FPM found"
    VHOSTY_PHP_DEFAULT="$v"
    ok "default PHP: $v ($(php_installed_versions | tr '\n' ' ' | sed 's/ $//') installed)"
    write_default_php_ini
    info "PHP settings for every site: $PHP_INI"
  fi
  save_config

  step "Caddy"
  if caddy_installed; then
    caddy_allow_ports
    ok "Caddy already installed ($("$CADDY_BIN" version | awk '{print $1}'))"
  else
    install_caddy
  fi

  step "DNS"
  dns_sync

  step "Config"
  write_configs
  cmd_validate >/dev/null || { cmd_validate || true; die "Generated config didn't validate"; }
  ok "wrote $CADDYFILE"

  if is_linux; then
    step "Services (systemd, as $VHOSTY_USER)"
    ensure_linger
  else
    step "Services (asks for your password)"
  fi
  svc_sync
  svc_apply

  step "Waiting for the certificate"
  local n=0
  while [ $n -lt 45 ]; do
    if find "$CADDY_CERTS" -name "wildcard_.$VHOSTY_DOMAIN.crt" 2>/dev/null | grep -q .; then
      ok "got a certificate for *.$VHOSTY_DOMAIN"
      break
    fi
    sleep 2; n=$((n + 1))
  done
  [ $n -lt 45 ] || warn "no certificate yet. Check: vhosty logs caddy"

  printf "\n%sDone.%s Folders in %s are live at https://<folder>.%s\n" "$G" "$N" "$park" "$VHOSTY_DOMAIN"
  printf "Dev servers on a port are at https://<port>.%s (e.g. 5173 for Vite).\n" "$VHOSTY_DOMAIN"
  printf "Run %svhosty doctor%s any time to check everything.\n" "$B" "$N"
}

# ---------------------------------------------------------------------------
# Commands: parked folders
# ---------------------------------------------------------------------------
cmd_park() {
  need_config
  local dir="${1:-$PWD}"
  dir="$(cd "$dir" 2>/dev/null && pwd)" || die "No such folder: ${1:-$PWD}"
  check_folder "$dir" parked
  case ":$VHOSTY_PARKED:" in
    *":$dir:"*) warn "$dir is already parked"; return 0 ;;
  esac
  VHOSTY_PARKED="${VHOSTY_PARKED:+$VHOSTY_PARKED:}$dir"
  save_config
  ok "parked $dir"
  cmd_rebuild
}

cmd_unpark() {
  need_config
  local dir="${1:-$PWD}" new="" d
  dir="$(cd "$dir" 2>/dev/null && pwd || echo "$dir")"
  case ":$VHOSTY_PARKED:" in
    *":$dir:"*) ;;
    *) die "$dir isn't parked. Run: vhosty parked" ;;
  esac
  while IFS= read -r d; do
    [ "$d" = "$dir" ] || new="${new:+$new:}$d"
  done <<EOF
$(parked_list)
EOF
  VHOSTY_PARKED="$new"
  save_config
  ok "unparked $dir"
  cmd_rebuild
}

cmd_parked() {
  need_config
  [ -n "$VHOSTY_PARKED" ] || { info "Nothing parked. Run: vhosty park <folder>"; return 0; }
  parked_list | sed 's/^/  /'
}

# ---------------------------------------------------------------------------
# Commands: links (one folder, anywhere, as a site)
# ---------------------------------------------------------------------------
# Folder name → hostname label: lowercase, anything else becomes a dash
name_from_folder() { lower "$1" | sed -E 's/[^a-z0-9-]+/-/g; s/^-+//; s/-+$//'; }

# The parked folder that serves <name> directly, if any
parked_dir_for() { # an exact (lowercase) folder name wins over one with capitals
  local name="$1" p f base pass
  # Names are compared as strings, not by asking the disk: on macOS, whose
  # disks ignore case, [ -d "$p/myapp" ] is true for MyApp too
  for pass in exact folded; do
    while IFS= read -r p; do
      [ -n "$p" ] || continue
      for f in "$p"/*/; do
        f="${f%/}"; base="${f##*/}"
        [ -d "$f" ] || continue
        if [ "$base" = "$name" ]; then echo "$f"; return 0; fi
        # same length first: lower forks, and most folders can't match
        if [ "$pass" = "folded" ] && [ ${#base} -eq ${#name} ] && [ "$(lower "$base")" = "$name" ]; then
          echo "$f"; return 0
        fi
      done
    done <<EOF
$(parked_list)
EOF
  done
  return 1
}

cmd_link() {
  need_config
  local dir="" name="" existing
  while [ $# -gt 0 ]; do
    case "$1" in
      --name|-n) [ -n "${2:-}" ] || die "--name needs a value"; name="$2"; shift 2 ;;
      -*) die "Unknown option '$1'. Usage: vhosty link [dir] [--name N]" ;;
      *) [ -z "$dir" ] || die "Usage: vhosty link [dir] [--name N]"; dir="$1"; shift ;;
    esac
  done
  dir="${dir:-$PWD}"
  [ -d "$dir" ] || die "No such folder: $dir"
  dir="$(cd "$dir" && pwd)"
  check_folder "$dir"
  [ -n "$name" ] || name="$(name_from_folder "${dir##*/}")"
  name="$(lower "$name")"
  valid_name "$name" || die "'$name' isn't a valid site name (letters, numbers, dashes). Pick one with --name"
  printf '%s' "$name" | grep -qE '^[0-9]+$' && die "'$name' would clash with port URLs (https://<port>.$VHOSTY_DOMAIN). Pick one with --name"
  site_load "$name"
  if [ "$SITE_LINKED" = "yes" ] && [ "$SITE_PATH" != "$dir" ]; then
    die "'$name' is already linked to $SITE_PATH. Unlink it first, or pick another name with --name"
  fi
  existing="$(parked_dir_for "$name" || true)"
  if [ -n "$existing" ] && [ "$existing" != "$dir" ]; then
    warn "$existing (parked) also answers to $name; the link takes over https://$name.$VHOSTY_DOMAIN"
  fi
  # A parked site's own settings (pin, ini, extensions) belong to that
  # folder: set them aside for unlink to put back, rather than carry them over
  if [ "$SITE_LINKED" != "yes" ] && [ -f "$(site_file "$name")" ] && [ "$SITE_PATH" != "$dir" ]; then
    mv "$(site_file "$name")" "$(site_file "$name").parked"
    info "set aside $name's settings as a parked site; vhosty unlink $name brings them back"
    site_load "$name"
  fi
  SITE_PATH="$dir"
  SITE_LINKED="yes"
  site_save "$name"
  ok "linked $dir → https://$name.$VHOSTY_DOMAIN"
  if [ ! -f "$dir/public/index.php" ] && [ ! -f "$dir/index.html" ]; then
    warn "no public/index.php or index.html there yet"
  fi
  cmd_rebuild
}

cmd_unlink() {
  need_config
  local name parked
  if [ -n "${1:-}" ]; then
    name="$(lower "$1")"
  else
    name="$(site_from_dir "$PWD")" || die "$PWD isn't a linked site. Pass a name (see: vhosty links)"
  fi
  site_load "$name"
  [ "$SITE_LINKED" = "yes" ] || die "'$name' isn't linked. Run: vhosty links"
  parked="$(parked_dir_for "$name" || true)"
  if [ -f "$(site_file "$name").parked" ]; then
    # The parked site's settings, set aside by `vhosty link`
    mv "$(site_file "$name").parked" "$(site_file "$name")"
    info "restored $name's settings as a parked site"
  elif [ -n "$parked" ] && [ "$parked" = "$SITE_PATH" ]; then
    # Still served from its parked folder: keep its pin and settings
    SITE_LINKED="no"
    site_save "$name"
  else
    [ -z "$SITE_PHP$SITE_INI" ] || info "its PHP pin and settings are removed too"
    rm -f "$(site_file "$name")"
  fi
  ok "unlinked $name"
  [ -z "$parked" ] || info "https://$name.$VHOSTY_DOMAIN is still served from $parked (parked)"
  cmd_rebuild
}

cmd_links() {
  need_config
  local name any=0 note
  for name in $(site_names); do
    site_load "$name"
    [ "$SITE_LINKED" = "yes" ] || continue
    any=1
    note=""; [ -d "$SITE_PATH" ] || note="  ${R}(folder missing)${N}"
    printf "  https://%s.%s  %s→ %s%s%s\n" "$name" "$VHOSTY_DOMAIN" "$D" "$SITE_PATH" "$N" "$note"
  done
  [ "$any" = "1" ] || info "No links. Link a folder with: vhosty link [dir] [--name N]"
}

# Everything about one site
cmd_site() {
  need_config
  local name dir kind v source settings sock missing blocker kv
  name="$(resolve_site "${1:-}")"
  site_load "$name"
  dir="$(site_dir "$name" || true)"
  [ -n "$dir" ] || die "No site '$name'. Run: vhosty sites"
  if [ "$SITE_LINKED" = "yes" ]; then source="linked"; else source="parked in ${dir%/*}"; fi
  if [ ! -d "$dir" ]; then kind="${R}folder missing${N}"
  elif php_enabled && [ -f "$dir/public/index.php" ]; then kind="PHP (public/index.php)"
  elif [ -f "$dir/index.html" ]; then kind="static (index.html)"
  else kind="${Y}nothing to serve yet${N} (no public/index.php or index.html)"; fi
  v="$(site_php)"
  if [ -n "$SITE_PHP" ] && ! php_is_installed "$SITE_PHP"; then v="$v ${R}(pinned $SITE_PHP isn't installed)${N}"
  elif [ -n "$SITE_PHP" ]; then v="$v (pinned)"
  else v="$v (default)"; fi
  if [ -n "$SITE_INI" ]; then settings="own, on top of global"; sock="$(site_sock "$name")"
  else settings="global"; sock="$(fpm_sock "$(site_php)")"; fi

  printf "%s%s%s  https://%s.%s\n" "$B" "$name" "$N" "$name" "$VHOSTY_DOMAIN"
  printf "  %-10s %s\n" "Folder" "$dir" "Source" "$source" "Serves" "$kind"
  if php_enabled; then
    printf "  %-10s %s\n" "PHP" "$v" "Settings" "$settings" "FPM" "$sock"
    if [ -n "$SITE_INI" ]; then
      printf '%s\n' "$SITE_INI" | while IFS= read -r kv; do printf "  %-10s %s = %s\n" "" "${kv%%=*}" "${kv#*=}"; done
    fi
    missing="$(missing_exts "$dir" "$(site_php)" | cut -f1 | tr '\n' ' ' | sed 's/ $//')"
    blocker="$(ext_check_blocker "$dir" "$(site_php)")"
    if [ -n "$blocker" ]; then missing="${Y}can't check: $blocker${N}"
    elif [ -n "$missing" ]; then missing="${R}missing: $missing${N} ($(ext_fix "<ext>" "$(site_php)"))"
    else missing="none missing"; fi
    printf "  %-10s %s%s\n" "Extensions" "${SITE_EXT:+declared: $SITE_EXT; }" "$missing"
    if app_debug_on "$dir"; then
      printf "  %-10s %s\n" "Debug" "${Y}APP_DEBUG=true${N}: its error pages show secrets to anyone on your tailnet"
    fi
  fi
  [ ! -f "$(site_file "$name")" ] || printf "  %-10s %s\n" "Config" "$(site_file "$name")"
}

cmd_rebuild() {
  need_config
  write_configs
  ok "regenerated config"
  if svc_installed; then
    cmd_validate >/dev/null || { cmd_validate || true; die "Not applying. Fix the errors above."; }
    svc_sync
    svc_apply
  fi
}

# ---------------------------------------------------------------------------
# Commands: services
# ---------------------------------------------------------------------------
need_installed() {
  svc_installed || die "Services aren't installed. Run: vhosty setup"
}

cmd_start() {
  need_config; need_installed
  local s
  for s in $(svc_resolve "${1:-all}"); do svc_start "$s"; ok "started $s"; done
  [ "${1:-all}" != "all" ] || mark_applied
}

cmd_stop() {
  need_config
  local s
  for s in $(svc_resolve "${1:-all}"); do
    if [ "$(svc_state "$s")" = "running" ]; then svc_stop "$s"; ok "stopped $s"
    else warn "$s isn't running"; fi
  done
}

cmd_restart() {
  need_config; need_installed
  local s
  cmd_validate >/dev/null || { cmd_validate || true; die "Not restarting. Fix the errors above."; }
  for s in $(svc_resolve "${1:-all}"); do svc_restart "$s"; ok "restarted $s"; done
  [ "${1:-all}" != "all" ] || mark_applied
}

cmd_status() {
  need_config
  is_macos && sudo -v
  local ip s st p o v
  ip="$(ts_ip)"
  printf "%svhosty%s  *.%s  →  %s\n" "$B" "$N" "$VHOSTY_DOMAIN" "${ip:-tailscale not running}"
  head_ "Services"
  for s in $(svc_all); do
    st="$(svc_state "$s")"
    p="$(svc_pid "$s")"
    if [ "$st" = "running" ]; then ok "$s running (pid $p)"
    else bad "$s $st (run: vhosty start, or see: vhosty logs $s)"; fi
  done
  head_ "Listening"
  o="$(port_owner 443)"; if [ -n "$o" ]; then ok "443 → $o"; else bad "nothing listening on 443"; fi
  for v in $(php_versions_in_use); do
    if [ -S "$(fpm_sock "$v")" ]; then ok "PHP $v → $(fpm_sock "$v")"; else bad "no socket for PHP $v"; fi
  done
  echo
}

# ---------------------------------------------------------------------------
# Commands: PHP versions
# ---------------------------------------------------------------------------
cmd_php() {
  local sub="${1:-list}"
  [ $# -gt 0 ] && shift
  case "$sub" in
    list|ls)          cmd_php_list ;;
    install|add)      cmd_php_install "${1:-}" ;;
    default|use)      cmd_php_default "${1:-}" ;;
    which)            cmd_php_which "${1:-}" ;;
    *) die "Usage: vhosty php [list | install <version> | default <version> | which [site]]" ;;
  esac
}

cmd_php_list() {
  need_config
  local v def used name pins st
  def="$(php_default)"
  used=" $(php_versions_in_use | tr '\n' ' ') "
  [ -n "$(php_installed_versions)" ] || { info "No PHP installed. Run: vhosty php install 8.5"; return 0; }
  for v in $(php_installed_versions); do
    pins=""
    for name in $(site_names); do
      site_load "$name"
      [ "$SITE_PHP" = "$v" ] && pins="${pins:+$pins, }$name"
    done
    case "$used" in
      *" $v "*) st="$(svc_state "php-$v")" ;;
      *) st="not needed" ;;
    esac
    printf "  %sPHP %s%s  %s%s%s%s\n" "$B" "$v" "$N" \
      "$([ "$v" = "$def" ] && echo "default, ")" "FPM $st" \
      "$([ -n "$pins" ] && echo ", pinned: $pins")" ""
  done
}

cmd_php_install() {
  local v="$1" pkgs="" e
  [ -n "$v" ] || die "Usage: vhosty php install <version>"
  valid_version "$v"
  if is_macos; then
    install_php_fpm "$v"
    info "macOS: this is PHP-FPM for sites; the CLI shim uses the php on your PATH"
  else
    for e in $PHP_PACKAGES; do pkgs="$pkgs php$v-$e"; done
    # Extensions sites have declared (vhosty ext require)
    for e in $(for n in $(site_names); do site_load "$n"; echo "$SITE_EXT"; done | tr ' ' '\n' | grep . | sort -u); do
      apt-cache show "php$v-$(ext_package "$e")" >/dev/null 2>&1 && pkgs="$pkgs php$v-$(ext_package "$e")"
    done
    if ! apt-cache show "php$v-fpm" >/dev/null 2>&1; then
      die "No php$v-fpm package. Add the PHP repo first: https://packages.sury.org/php/README.txt"
    fi
    info "installing PHP $v with apt (asks for your password)"
    # shellcheck disable=SC2086
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y $pkgs || die "apt-get install failed"
    # vhosty runs its own FPM as you; the distro's would sit idle as root
    sudo systemctl disable --now "php$v-fpm" >/dev/null 2>&1 || true
    ok "PHP $v installed ($(php_installed_versions | tr '\n' ' ' | sed 's/ $//') available)"
  fi
  [ -n "$VHOSTY_PHP_DEFAULT" ] || { VHOSTY_PHP_DEFAULT="$v"; save_config; }
  info "Use it with: vhosty isolate $v (in a project), or: vhosty php default $v"
}

cmd_php_default() {
  need_config
  local v="$1"
  [ -n "$v" ] || { php_default; return 0; }
  valid_version "$v"
  php_is_installed "$v" || die "PHP $v isn't installed. Run: vhosty php install $v"
  VHOSTY_PHP_DEFAULT="$v"
  save_config
  ok "default PHP is now $v"
  cmd_rebuild
}

cmd_php_which() { # the version a site (default: current folder) runs
  need_config
  local name
  if [ -z "${1:-}" ] && ! site_from_dir "$PWD" >/dev/null; then php_default; return 0; fi
  name="$(resolve_site "${1:-}")"
  site_load "$name"
  site_php
}

# ---------------------------------------------------------------------------
# PHP extensions
#   Required: what composer.lock requires (composer check-platform-reqs), so
#   nothing to configure. Declared: extensions a site wants but doesn't
#   require, e.g. protobuf for speed (vhosty ext require protobuf), kept in
#   ~/.vhosty/sites/<name>.conf so the project stays untouched.
# ---------------------------------------------------------------------------
valid_ext() { printf '%s' "$1" | grep -qE '^[a-z0-9_-]+$' || die "'$1' isn't a PHP extension name"; }

# apt package suffix for an extension (php8.5-<suffix>)
ext_package() {
  case "$1" in
    pdo_mysql|mysqli|mysqlnd) echo mysql ;;
    pdo_pgsql)                echo pgsql ;;
    pdo_sqlite)               echo sqlite3 ;;
    dom|simplexml|xmlreader|xmlwriter|xsl) echo xml ;;
    zend-opcache)             echo opcache ;;
    *)                        echo "$1" ;;
  esac
}

# The PHP whose modules decide what a site has. Linux: the version's CLI,
# which composer checks against (it has FPM's extensions, plus CLI-only ones
# like pcntl that queue workers use). macOS: vhosty's FPM build, since there
# is no CLI per version there.
php_bin_for() {
  if is_macos; then
    if [ -x "$(fpm_bin "$1")" ]; then fpm_bin "$1"; fi
  elif [ -x "/usr/bin/php$1" ]; then echo "/usr/bin/php$1"; fi
}

# Lists a version's modules once per run, into PHP_MODULES_<8_5>. Call it in
# this shell (not inside $(...)) for the list to stick around.
load_php_modules() {
  local var="PHP_MODULES_${1//./_}" bin
  [ -z "${!var:-}" ] || return 0
  bin="$(php_bin_for "$1")"
  [ -n "$bin" ] || return 1
  printf -v "$var" '%s' "$("$bin" -m 2>/dev/null | grep -v '^\[' | grep . | tr '[:upper:]' '[:lower:]')"
  [ -n "${!var}" ]
}
forget_php_modules() { unset "PHP_MODULES_${1//./_}"; }

ext_loaded() { # ext_loaded 8.5 protobuf
  local var="PHP_MODULES_${1//./_}" e
  load_php_modules "$1" || return 1
  e="$(lower "$2")"
  printf '%s\n' "${!var}" | grep -qxF -e "$e" -e "${e//-/ }"
}

# The extensions a composer.lock needs: every package's and the platform's
# ext-* requirements, less what packages provide or replace (as composer
# check-platform-reqs counts them), without running composer for each site
lock_ext_reqs() {
  [ -f "$1/composer.lock" ] || return 0
  jq -r '
    [(.packages // [])[], (."packages-dev" // [])[]] as $p
    | ([$p[] | ((.provide // {}) + (.replace // {})) | keys[]] | map(select(startswith("ext-")))) as $given
    | ([$p[] | (.require // {}) | keys[]] + ((.platform // {}) | keys) + ((."platform-dev" // {}) | keys))
    | map(select(type == "string" and startswith("ext-"))) | unique - $given | .[] | sub("^ext-"; "")
  ' "$1/composer.lock" 2>/dev/null
}

# Why a site's extensions can't be checked, if they can't
ext_check_blocker() { # ext_check_blocker DIR VERSION
  if [ -z "$(php_bin_for "$2")" ]; then
    if is_macos; then echo "PHP $2 isn't installed (vhosty php install $2)"
    else echo "no PHP $2 CLI to check against (sudo apt install php$2-cli)"; fi
  elif [ -f "$1/composer.lock" ] && ! command -v jq >/dev/null 2>&1; then
    echo "reading composer.lock needs jq"
  fi
}

# What to do about a missing extension
ext_fix() { # ext_fix EXT VERSION
  if is_macos; then echo "vhosty's PHP $2 build for macOS doesn't include it."
  else echo "Run: vhosty ext install $1 --php $2"; fi
}

# Missing extensions for a folder on a PHP version, one "ext<TAB>why" per line.
# Reads SITE_EXT, so call site_load first (or clear SITE_EXT).
missing_exts() { # missing_exts DIR VERSION
  local dir="$1" v="$2" e
  [ -z "$(ext_check_blocker "$dir" "$v")" ] || return 0
  load_php_modules "$v" || return 0
  local var="PHP_MODULES_${v//./_}"
  # One awk for the whole list (a check per extension would fork for each)
  {
    lock_ext_reqs "$dir" | sed 's/$/\trequired by composer.lock/'
    for e in ${SITE_EXT:-}; do printf '%s\tdeclared for this site\n' "$e"; done
  } | MODULES="${!var}" awk -F'\t' '
    BEGIN { n = split(ENVIRON["MODULES"], m, "\n"); for (i = 1; i <= n; i++) have[m[i]] = 1 }
    { e = tolower($1); s = e; gsub(/-/, " ", s) }
    !(e in have) && !(s in have) && !seen[e]++'
}

# True when a Laravel app runs in debug mode: its error pages then show
# environment details (passwords, keys) to anyone who can load them
app_debug_on() {
  [ -f "$1/.env" ] || return 1
  grep -qiE '^[[:space:]]*APP_DEBUG[[:space:]]*=[[:space:]]*["'"'"']?(\(?true\)?|1|on|yes)["'"'"']?[[:space:]]*(#.*)?$' "$1/.env"
}

# Every PHP site: "name|dir" (configured sites first; they win over parked ones)
all_php_sites() {
  local name dir p f seen=" "
  for name in $(site_names); do
    dir="$(site_dir "$name" || true)"
    [ -n "$dir" ] && [ -f "$dir/public/index.php" ] || continue
    echo "$name|$dir"; seen="$seen$name "
  done
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    for f in "$p"/*/; do
      f="${f%/}"; name="$(lower "${f##*/}")"
      [ -f "$f/public/index.php" ] && valid_name "$name" || continue
      case "$seen" in *" $name "*) continue ;; esac
      echo "$name|$f"; seen="$seen$name "
    done
  done <<EOF
$(parked_list)
EOF
}

# Installs extensions for one PHP version and restarts its FPM if it's running
install_exts() { # install_exts VERSION ext...
  local v="$1" e pkgs=""
  shift
  is_linux || die "On macOS, PHP-FPM is a static build with a fixed set of extensions"
  php_is_installed "$v" || die "PHP $v isn't installed. Run: vhosty php install $v"
  for e in "$@"; do
    pkgs="$pkgs php$v-$(ext_package "$e")"
    apt-cache show "php$v-$(ext_package "$e")" >/dev/null 2>&1 \
      || die "No apt package php$v-$(ext_package "$e") for '$e'. Install it another way (e.g. pecl)."
  done
  info "installing$pkgs (asks for your password)"
  # shellcheck disable=SC2086
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq $pkgs >/dev/null || die "apt-get install failed"
  sudo systemctl disable --now "php$v-fpm" >/dev/null 2>&1 || true
  forget_php_modules "$v"
  for e in "$@"; do
    if ext_loaded "$v" "$e"; then ok "PHP $v: $e"; else bad "PHP $v: $e installed but not loaded"; fi
  done
  if [ "$(svc_state "php-$v")" = "running" ]; then svc_restart "php-$v"; ok "restarted php-$v"; fi
}

cmd_ext() {
  need_config
  local sub="${1:-list}"
  [ $# -gt 0 ] && shift
  case "$sub" in
    list|ls|show)       cmd_ext_list "$@" ;;
    require|add)        cmd_ext_require "$@" ;;
    unrequire|rm|remove) cmd_ext_unrequire "$@" ;;
    install)            cmd_ext_install "$@" ;;
    check)              cmd_ext_check ;;
    -*) die "Usage: vhosty ext [list] [site] | require <ext..> | unrequire <ext..> | install <ext..> [--php V] | check" ;;
    *)                  cmd_ext_list "$sub" ;;   # vhosty ext <site>
  esac
}

# Parses "ext... [--site N]" into EXT_ARGS and EXT_SITE (default: current folder)
ext_args() {
  EXT_ARGS=""; EXT_SITE=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --site|-s) [ -n "${2:-}" ] || die "--site needs a site name"; EXT_SITE="$2"; shift 2 ;;
      -*) die "Unknown option '$1'" ;;
      *) valid_ext "$1"; EXT_ARGS="$EXT_ARGS $1"; shift ;;
    esac
  done
  EXT_SITE="$(resolve_site "$EXT_SITE")"
}

cmd_ext_list() {
  local name dir v e line
  name="$(resolve_site "${1:-}")"
  dir="$(site_dir "$name")" || die "No site '$name'. Run: vhosty sites"
  site_load "$name"
  v="$(site_php)"
  printf "%s%s%s  PHP %s\n" "$B" "$name" "$N" "$v"
  line="$(ext_check_blocker "$dir" "$v")"
  if [ -n "$line" ]; then warn "can't check the extensions: $line"; return 0; fi
  if [ -n "$SITE_EXT" ]; then
    for e in $SITE_EXT; do
      if ext_loaded "$v" "$e"; then ok "$e (declared)"; else bad "$e (declared) missing. $(ext_fix "$e" "$v")"; fi
    done
  else
    info "no declared extensions (add one with: vhosty ext require <ext>)"
  fi
  line="$(SITE_EXT="" missing_exts "$dir" "$v")"
  if [ -n "$line" ]; then
    printf '%s\n' "$line" | while IFS="$(printf '\t')" read -r e _; do
      bad "$e (required by composer.lock) missing. $(ext_fix "$e" "$v")"
    done
  elif [ -f "$dir/composer.lock" ]; then
    ok "everything composer.lock requires is installed"
  fi
}

cmd_ext_require() {
  local e dir v missing=""
  ext_args "$@"
  [ -n "$EXT_ARGS" ] || die "Usage: vhosty ext require <ext...> [--site N]"
  dir="$(site_dir "$EXT_SITE")" || die "No site '$EXT_SITE'. Run: vhosty sites"
  site_load "$EXT_SITE"
  SITE_PATH="$dir"
  for e in $EXT_ARGS; do
    case " $SITE_EXT " in *" $e "*) ;; *) SITE_EXT="${SITE_EXT:+$SITE_EXT }$e" ;; esac
  done
  site_save "$EXT_SITE"
  ok "$EXT_SITE needs:$EXT_ARGS (saved in $(site_file "$EXT_SITE"))"
  v="$(site_php)"
  for e in $EXT_ARGS; do ext_loaded "$v" "$e" || missing="$missing $e"; done
  # shellcheck disable=SC2086
  if [ -n "$missing" ] && is_linux; then install_exts "$v" $missing
  elif [ -n "$missing" ]; then warn "missing on PHP $v:$missing"; fi
}

cmd_ext_unrequire() {
  local e new=""
  ext_args "$@"
  [ -n "$EXT_ARGS" ] || die "Usage: vhosty ext unrequire <ext...> [--site N]"
  site_load "$EXT_SITE"
  for e in $SITE_EXT; do
    case " $EXT_ARGS " in *" $e "*) ;; *) new="${new:+$new }$e" ;; esac
  done
  SITE_EXT="$new"
  site_save "$EXT_SITE"
  ok "$EXT_SITE no longer declares:$EXT_ARGS (the extensions stay installed)"
}

cmd_ext_install() {
  local v="" exts="" name
  while [ $# -gt 0 ]; do
    case "$1" in
      --php) [ -n "${2:-}" ] || die "--php needs a version"; v="$2"; shift 2 ;;
      -*) die "Unknown option '$1'" ;;
      *) valid_ext "$1"; exts="$exts $1"; shift ;;
    esac
  done
  [ -n "$exts" ] || die "Usage: vhosty ext install <ext...> [--php V]"
  if [ -z "$v" ]; then
    if name="$(site_from_dir "$PWD")"; then site_load "$name"; v="$(site_php)"; else v="$(php_default)"; fi
  fi
  valid_version "$v"
  # shellcheck disable=SC2086
  install_exts "$v" $exts
}

# Every site against its own PHP version. Used by doctor too.
# doctor: a warning, not a failure, since debug mode on a dev box is often deliberate
debug_sites_check() {
  local line name dir on=""
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    name="${line%%|*}"; dir="${line#*|}"
    if app_debug_on "$dir"; then on="$on $name"; fi
  done <<EOF
$(all_php_sites)
EOF
  if [ -z "$on" ]; then ok "no site runs with APP_DEBUG=true"; return 0; fi
  if [ "$VHOSTY_ALLOW_DEBUG" = "yes" ]; then ok "APP_DEBUG=true on:$on (allowed: VHOSTY_ALLOW_DEBUG)"; return 0; fi
  warn "APP_DEBUG=true on:$on"
  info "Their error pages show secrets to anyone on your tailnet. Turn it off in their .env, or limit"
  info "access with Tailscale (README: Security). Only you can reach this machine? Add"
  info "VHOSTY_ALLOW_DEBUG=\"yes\" to ~/.vhosty/config to stop this warning."
}

# Every PHP site's missing extensions, "name|version|ext|why" per line, and
# "name|version|?|reason" for a site that can't be checked
ext_report() {
  local name dir v b
  while IFS="|" read -r name dir; do
    [ -n "$name" ] || continue
    site_load "$name"
    v="$(site_php)"
    b="$(ext_check_blocker "$dir" "$v")"
    if [ -n "$b" ]; then echo "$name|$v|?|$b"; continue; fi
    load_php_modules "$v" || continue   # once per version, before the subshells below
    missing_exts "$dir" "$v" | sed "s/^/$name|$v|/; s/\t/|/"
  done <<EOF
$(all_php_sites)
EOF
}

cmd_ext_check() {
  local name v e why any=0
  while IFS="|" read -r name v e why; do
    [ -n "$name" ] || continue
    if [ "$e" = "?" ]; then warn "$name (PHP $v): can't check its extensions: $why"; continue; fi
    any=1
    bad "$name (PHP $v) is missing $e, $why. $(ext_fix "$e" "$v")"
  done <<EOF
$(ext_report)
EOF
  [ "$any" = "1" ] || ok "every site has the extensions it needs"
}

# ---------------------------------------------------------------------------
# Commands: isolate (pin a site to a PHP version)
# ---------------------------------------------------------------------------
cmd_isolate() {
  need_config
  php_enabled || die "PHP is turned off in ~/.vhosty/config"
  local v="${1:-}" name dir
  [ -n "$v" ] || die "Usage: vhosty isolate <version> [site]"
  valid_version "$v"
  php_is_installed "$v" || die "PHP $v isn't installed. Run: vhosty php install $v"
  name="$(resolve_site "${2:-}")"
  dir="$(site_dir "$name")" || die "No folder for '$name' in your parked folders. Run: vhosty sites"
  site_load "$name"
  SITE_PATH="$dir"
  SITE_PHP="$v"
  site_save "$name"
  ok "$name now uses PHP $v (web and CLI)"
  missing_exts "$dir" "$v" | while IFS="$(printf '\t')" read -r e why; do
    [ -z "$e" ] || warn "PHP $v is missing $e ($why). Run: vhosty ext install $e --php $v"
  done
  cmd_rebuild
}

cmd_unisolate() {
  need_config
  local name
  name="$(resolve_site "${1:-}")"
  site_load "$name"
  [ -n "$SITE_PHP" ] || { warn "$name isn't pinned; it uses the default PHP ($(php_default))"; return 0; }
  SITE_PHP=""
  site_save "$name"
  ok "$name uses the default PHP again ($(php_default))"
  cmd_rebuild
}

cmd_isolated() {
  need_config
  local name any=0 note
  for name in $(site_names); do
    site_load "$name"
    [ -n "$SITE_PHP" ] || continue
    any=1
    note=""; php_is_installed "$SITE_PHP" || note="  ${R}(not installed: using $(php_default))${N}"
    printf "  %-24s PHP %s  %s%s%s%s\n" "$name" "$SITE_PHP" "$D" "$SITE_PATH" "$N" "$note"
  done
  [ "$any" = "1" ] || info "No pinned sites. Pin one with: vhosty isolate <version> (in the project folder)"
}

# ---------------------------------------------------------------------------
# Commands: ini (PHP settings, global or per site)
# ---------------------------------------------------------------------------
# Picks the scope from --global / --site N, else the current folder's site,
# else global. Sets INI_SCOPE ("global" or a site name).
ini_scope() {
  INI_SCOPE=""
  case "${1:-}" in
    --global|-g) INI_SCOPE="global" ;;
    --site|-s)
      [ -n "${2:-}" ] || die "--site needs a site name"
      INI_SCOPE="$(resolve_site "$2")"
      site_dir "$INI_SCOPE" >/dev/null || die "No site '$INI_SCOPE'. Run: vhosty sites" ;;
    "")          INI_SCOPE="$(site_from_dir "$PWD" || echo global)" ;;
    *)           die "Unknown option '$1' (use --global or --site <name>)" ;;
  esac
}

# Saves new key=value lines for the scope
ini_store() { # ini_store "lines"
  local lines="$1" dir kv
  if [ "$INI_SCOPE" = "global" ]; then
    write_default_php_ini
    {
      echo "; vhosty: PHP settings for every site and every PHP version (web and CLI)."
      echo "; They apply on top of the distro's php.ini. After editing, run: vhosty rebuild"
      printf '%s\n' "$lines" | while IFS= read -r kv; do
        [ -z "$kv" ] || printf '%s = %s\n' "${kv%%=*}" "${kv#*=}"
      done
    } >"$PHP_INI.tmp"
    mv "$PHP_INI.tmp" "$PHP_INI"
  else
    dir="$(site_dir "$INI_SCOPE")" || die "No folder for '$INI_SCOPE'. Run: vhosty sites"
    site_load "$INI_SCOPE"
    SITE_PATH="$dir"
    SITE_INI="$(printf '%s\n' "$lines" | grep . || true)"
    site_save "$INI_SCOPE"
  fi
}

ini_current() { # key=value lines for INI_SCOPE
  if [ "$INI_SCOPE" = "global" ]; then ini_pairs "$PHP_INI"
  else site_load "$INI_SCOPE"; printf '%s\n' "$SITE_INI" | grep . || true; fi
}

scope_label() { if [ "$INI_SCOPE" = "global" ]; then echo "global"; else echo "$INI_SCOPE"; fi; }

cmd_ini() {
  need_config
  local sub="${1:-show}"
  [ $# -gt 0 ] && shift
  case "$sub" in
    show|list|ls) cmd_ini_show "$@" ;;
    set)          cmd_ini_set "$@" ;;
    unset|rm)     cmd_ini_unset "$@" ;;
    edit)         cmd_ini_edit "$@" ;;
    --global|-g|--site|-s) cmd_ini_show "$sub" "$@" ;;
    *) die "Usage: vhosty ini [show | set <key> <value> | unset <key> | edit] [--global | --site <name>]" ;;
  esac
}

cmd_ini_show() {
  local kv site
  ini_scope "$@"
  head_ "Global ($PHP_INI)"
  if [ -n "$(ini_pairs "$PHP_INI")" ]; then
    ini_pairs "$PHP_INI" | while IFS= read -r kv; do printf "  %s = %s\n" "${kv%%=*}" "${kv#*=}"; done
  else info "(none)"; fi
  [ "$INI_SCOPE" = "global" ] && { echo; return 0; }
  site="$INI_SCOPE"
  site_load "$site"
  head_ "$site (overrides global, PHP $(site_php))"
  if [ -n "$SITE_INI" ]; then
    printf '%s\n' "$SITE_INI" | while IFS= read -r kv; do printf "  %s = %s\n" "${kv%%=*}" "${kv#*=}"; done
  else info "(none: uses the global settings)"; fi
  echo
}

cmd_ini_set() {
  local key="${1:-}" value="${2:-}"
  [ $# -ge 2 ] || die "Usage: vhosty ini set <key> <value> [--global | --site <name>]"
  shift 2
  valid_ini_key "$key"
  case "$value" in *"
"*) die "Values can't contain newlines" ;; esac
  ini_scope "$@"
  ini_store "$( { ini_current; printf '%s=%s\n' "$key" "$value"; } | ini_merge )"
  ok "$key = $value ($(scope_label))"
  cmd_rebuild
}

cmd_ini_unset() {
  local key="${1:-}" cur
  [ -n "$key" ] || die "Usage: vhosty ini unset <key> [--global | --site <name>]"
  shift
  valid_ini_key "$key"
  ini_scope "$@"
  cur="$(ini_current)"
  printf '%s\n' "$cur" | grep -q "^$(printf '%s' "$key" | sed 's/\./\\./g')=" \
    || { warn "$key isn't set ($(scope_label))"; return 0; }
  ini_store "$(printf '%s\n' "$cur" | awk -F= -v k="$key" '$1 != k')"
  ok "removed $key ($(scope_label))"
  cmd_rebuild
}

cmd_ini_edit() {
  local tmp kv
  ini_scope "$@"
  if [ "$INI_SCOPE" = "global" ]; then
    write_default_php_ini
    ${EDITOR:-nano} "$PHP_INI" || die "The editor exited with an error. If you saved changes, apply them with: vhosty rebuild"
  else
    make_tmp tmp
    {
      echo "; PHP settings for $INI_SCOPE only (override ~/.vhosty/php.ini). One per line: key = value"
      ini_current | while IFS= read -r kv; do printf '%s = %s\n' "${kv%%=*}" "${kv#*=}"; done
    } >"$tmp"
    ${EDITOR:-nano} "$tmp" || die "The editor exited with an error. Nothing was saved."
    ini_store "$(ini_pairs "$tmp")"
  fi
  ok "saved ($(scope_label))"
  cmd_rebuild
}

# ---------------------------------------------------------------------------
# Commands: services (docker compose for databases, caches, search, S3)
# ---------------------------------------------------------------------------
need_services() {
  [ -n "$VHOSTY_SERVICES_DIR" ] || die "No services folder set. Run: vhosty services init (or: vhosty services dir <folder with compose.yaml>)"
  [ -d "$VHOSTY_SERVICES_DIR" ] || die "$VHOSTY_SERVICES_DIR doesn't exist. Run: vhosty services dir <folder>"
  if ! command -v jq >/dev/null 2>&1; then
    if is_macos; then die "vhosty services needs jq: brew install jq (macOS 15 and later have it built in)"
    else die "vhosty services needs jq: sudo apt install jq"; fi
  fi
  need_docker
}

need_docker() {
  command -v docker >/dev/null 2>&1 || die "Docker isn't installed"
  docker info >/dev/null 2>&1 || {
    if [ -S /var/run/docker.sock ] && ! [ -w /var/run/docker.sock ]; then
      die "No access to Docker. Add yourself to the docker group (sudo usermod -aG docker $VHOSTY_USER), then log in again"
    fi
    if is_macos; then die "Docker isn't running. Start Docker Desktop (or OrbStack, Colima)"
    else die "Docker isn't running (sudo systemctl start docker)"; fi
  }
}

dc() { docker compose --project-directory "$VHOSTY_SERVICES_DIR" "$@"; }

# One line per container: service|state|health|published ports (space-separated).
# Not tabs: read merges consecutive tabs, which shifts an empty health field.
services_rows() {
  dc ps --all --format json 2>/dev/null | jq -r -s 'flatten | .[] |
    [.Service, .State, (.Health // ""),
     ([.Publishers[]? | select(.PublishedPort > 0) | "\(.URL):\(.PublishedPort)->\(.TargetPort)"] | unique | join(" "))] | join("|")'
}

# Published on something other than localhost?
exposed_ports() { # "url:port->target ..." → the ones not on 127.0.0.1 / ::1
  local p
  for p in $1; do
    case "$p" in 127.0.0.1:*|::1:*|"[::1]":*) ;; *) printf '%s ' "$p" ;; esac
  done
}

cmd_services() {
  need_config
  local sub="${1:-status}"
  [ $# -gt 0 ] && shift
  case "$sub" in
    dir)
      if [ -z "${1:-}" ]; then echo "${VHOSTY_SERVICES_DIR:-(not set)}"; return 0; fi
      [ -d "$1" ] || die "No such folder: $1"
      VHOSTY_SERVICES_DIR="$(cd "$1" && pwd)"
      save_config
      ok "services folder: $VHOSTY_SERVICES_DIR"
      return 0 ;;
    init)    cmd_services_init "$@"; return ;;
    restore) cmd_services_restore "$@"; return ;;
  esac
  need_services
  case "$sub" in
    status|st|ps|ls) services_status ;;
    up|start)        dc up -d --remove-orphans "$@"; services_status ;;
    down)            if [ $# -gt 0 ]; then dc stop "$@"; else dc down; fi ;;
    stop)            dc stop "$@" ;;
    restart)         dc restart "$@"; services_status ;;
    logs|log)        dc logs --tail "${VHOSTY_LOG_LINES:-100}" "$@" ;;
    tail|follow)     dc logs --tail 30 -f "$@" ;;
    pull|update)     dc pull "$@" && dc up -d --remove-orphans "$@" && services_status ;;
    edit)            ${EDITOR:-nano} "$VHOSTY_SERVICES_DIR/compose.yaml" && dc config -q && ok "compose.yaml is valid. Apply with: vhosty services up" ;;
    exec)            [ $# -ge 1 ] || die "Usage: vhosty services exec <service> [command]"; dc exec "$@" ;;
    backup)          cmd_services_backup "$@" ;;
    *) die "Usage: vhosty services [status | up | down | stop | restart | logs | tail | pull | edit | exec | dir | init | backup | restore] [service...]" ;;
  esac
}

services_status() { # [--no-header]
  local svc st health ports bad_ports defined rows
  [ "${1:-}" = "--no-header" ] || printf "%sServices%s  %s\n" "$B" "$N" "$VHOSTY_SERVICES_DIR"
  rows="$(services_rows)"
  defined="$(dc config --services 2>/dev/null | sort)"
  for svc in $defined; do
    st=""; health=""; ports=""
    while IFS="|" read -r s1 s2 s3 s4; do
      [ "$s1" = "$svc" ] && { st="$s2"; health="$s3"; ports="$s4"; }
    done <<EOF
$rows
EOF
    bad_ports="$(exposed_ports "$ports")"
    if [ "$st" = "running" ] && [ "$health" != "unhealthy" ]; then
      ok "$(printf '%-12s' "$svc") ${D}${ports:-no ports}${N}${health:+ ($health)}"
    else
      bad "$(printf '%-12s' "$svc") ${st:-not created}${health:+ ($health)}  (vhosty services up $svc)"
    fi
    [ -z "$bad_ports" ] || bad "$(printf '%-12s' "") reachable beyond this machine: $bad_ports(bind to 127.0.0.1 in compose.yaml)"
  done
}

# ---------------------------------------------------------------------------
# Commands: services init, backup, restore
# ---------------------------------------------------------------------------
SERVICES_CATALOG="mysql postgres valkey meilisearch typesense rustfs"
HELPER_IMAGE="alpine:3"   # archives volumes; anything with sh, tar and gzip works
BACKUP_SKIP_DBS='^test$|_test(ing)?(_[0-9]+)?$'   # test databases: the test suites recreate them

# Memory the services can use, in MB: the Docker VM's on macOS, the machine's on Linux
services_mem_mb() {
  local b
  b="$(docker info --format '{{.MemTotal}}' 2>/dev/null || true)"
  if [ -z "$b" ] || [ "$b" = "0" ]; then
    if is_macos; then b="$(sysctl -n hw.memsize 2>/dev/null || echo 0)"
    else b="$(awk '/^MemTotal:/ { print $2 * 1024 }' /proc/meminfo 2>/dev/null || echo 0)"; fi
  fi
  awk -v b="$b" 'BEGIN { m = int(b / 1048576); print (m > 0 ? m : 4096) }'
}

size_mb() { # size_mb N MIN MAX STEP: N clamped to MIN..MAX, rounded down to a multiple of STEP
  local n="$1"
  [ "$n" -ge "$2" ] || n="$2"
  [ "$n" -le "$3" ] || n="$3"
  echo $(( n / $4 * $4 ))
}

random_key() { od -An -N16 -tx1 /dev/urandom | tr -d ' \n'; }

services_env_keys() { # the .env keys the chosen services need
  local s
  for s in $1; do
    case "$s" in
      meilisearch) echo MEILI_MASTER_KEY ;;
      typesense)   echo TYPESENSE_API_KEY ;;
      rustfs)      echo RUSTFS_ACCESS_KEY; echo RUSTFS_SECRET_KEY ;;
    esac
  done
}

compose_block() { # compose_block SERVICE MEM_MB
  local m="$2"
  case "$1" in
    mysql) cat <<EOF
  mysql:
    image: mysql:8.4
    restart: unless-stopped
    environment:
      MYSQL_ALLOW_EMPTY_PASSWORD: "yes" # root, no password: it only listens on 127.0.0.1
    # Sized for ${m} MB of memory (the default buffer pool is 128 MB)
    command: ["--innodb-buffer-pool-size=$(size_mb $((m / 8)) 256 8192 128)M", "--innodb-redo-log-capacity=$(size_mb $((m / 64)) 128 1024 64)M"]
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "127.0.0.1", "--silent"]
      interval: 10s
      retries: 12
    ports: ["127.0.0.1:3306:3306"]
    volumes: [mysql:/var/lib/mysql]

EOF
    ;;
    postgres) cat <<EOF
  postgres:
    image: pgvector/pgvector:pg18-trixie # Postgres 18 with pgvector
    restart: unless-stopped
    environment:
      POSTGRES_HOST_AUTH_METHOD: trust # postgres, no password: it only listens on 127.0.0.1
    # Sized for ${m} MB of memory (the defaults assume a small machine)
    command: ["postgres", "-c", "shared_buffers=$(size_mb $((m / 32)) 128 2048 64)MB", "-c", "effective_cache_size=$(size_mb $((m / 4)) 512 16384 256)MB",
              "-c", "work_mem=$(size_mb $((m / 2048)) 4 32 4)MB", "-c", "maintenance_work_mem=$(size_mb $((m / 128)) 64 512 64)MB"]
    shm_size: $([ "$m" -ge 8192 ] && echo 1g || echo 256m)
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "postgres", "-h", "127.0.0.1"]
      interval: 10s
      retries: 12
    ports: ["127.0.0.1:5432:5432"]
    volumes: [postgres:/var/lib/postgresql]

EOF
    ;;
    valkey) cat <<EOF
  valkey:
    image: valkey/valkey:9-alpine # Redis-compatible
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "valkey-cli", "ping"]
      interval: 10s
    ports: ["127.0.0.1:6379:6379"]
    volumes: [valkey:/data]

EOF
    ;;
    meilisearch) cat <<EOF
  meilisearch:
    image: getmeili/meilisearch:v1.56
    restart: unless-stopped
    environment:
      MEILI_ENV: development
      MEILI_MASTER_KEY: \${MEILI_MASTER_KEY}
    ports: ["127.0.0.1:7700:7700"]
    volumes: [meilisearch:/meili_data]

EOF
    ;;
    typesense) cat <<EOF
  typesense:
    image: typesense/typesense:30.2
    restart: unless-stopped
    command: ["--data-dir", "/data", "--api-key", "\${TYPESENSE_API_KEY}", "--enable-cors"]
    ports: ["127.0.0.1:8108:8108"]
    volumes: [typesense:/data]

EOF
    ;;
    rustfs) cat <<EOF
  rustfs:
    image: rustfs/rustfs:1.0.4 # S3-compatible storage
    restart: unless-stopped
    environment:
      RUSTFS_VOLUMES: /data
      RUSTFS_ADDRESS: 0.0.0.0:9000
      RUSTFS_CONSOLE_ADDRESS: 0.0.0.0:9001
      RUSTFS_CONSOLE_ENABLE: "true"
      RUSTFS_ACCESS_KEY: \${RUSTFS_ACCESS_KEY}
      RUSTFS_SECRET_KEY: \${RUSTFS_SECRET_KEY}
    ports:
      - "127.0.0.1:9000:9000" # S3 API
      - "127.0.0.1:9001:9001" # web console
    volumes: [rustfs:/data]

EOF
    ;;
  esac
}

cmd_services_init() { # [dir] [--only svc,..] [--force]
  local dir="" only="" force="" s mem name key env_file p busy=""
  local usage="Usage: vhosty services init [dir] [--only ${SERVICES_CATALOG// /,}] [--force]"
  while [ $# -gt 0 ]; do
    case "$1" in
      --only) [ $# -ge 2 ] || die "$usage"; only="$2"; shift 2 ;;
      --only=*) only="${1#--only=}"; shift ;;
      -f|--force) force=1; shift ;;
      -h|--help) echo "$usage"; return 0 ;;
      -*) die "$usage" ;;
      *) [ -z "$dir" ] || die "$usage"; dir="$1"; shift ;;
    esac
  done
  only="$(printf '%s' "${only:-$SERVICES_CATALOG}" | tr ',' ' ')"
  for s in $only; do
    case " $SERVICES_CATALOG " in *" $s "*) ;; *) die "Unknown service '$s'. Choose from: $SERVICES_CATALOG" ;; esac
  done
  dir="${dir:-${VHOSTY_SERVICES_DIR:-$VHOSTY_DIR/services}}"
  mkdir -p "$dir"
  dir="$(cd "$dir" && pwd)"
  if [ -f "$dir/compose.yaml" ] && [ -z "$force" ]; then
    die "$dir/compose.yaml already exists. Add --force to replace it (the data in Docker volumes stays)"
  fi
  mem="$(services_mem_mb)"
  name="$(basename "$dir" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9_\n-' '-')"

  {
    cat <<EOF
# Local services for vhosty sites. Every port binds to 127.0.0.1: Docker bypasses the
# firewall for published ports, so that prefix is what keeps them off the network.
#
#   vhosty services              status
#   vhosty services up | down    start, or stop and remove the containers (data stays in volumes)
#   vhosty services backup       dump the databases and archive the other volumes
#
# Written by vhosty services init. Keys live in .env next to this file.

name: $name

services:
EOF
    for s in $SERVICES_CATALOG; do
      case " $only " in *" $s "*) compose_block "$s" "$mem" ;; esac
    done
    echo "volumes:"
    for s in $SERVICES_CATALOG; do
      case " $only " in *" $s "*) echo "  $s:" ;; esac
    done
  } >"$dir/compose.yaml"

  # Keys: generate only the missing ones, so existing data keeps working
  env_file="$dir/.env"
  ( umask 077; touch "$env_file" )
  chmod 600 "$env_file"
  for key in $(services_env_keys "$only"); do
    grep -q "^$key=" "$env_file" || printf '%s=%s\n' "$key" "$(random_key)" >>"$env_file"
  done

  VHOSTY_SERVICES_DIR="$dir"
  save_config
  ok "wrote $dir/compose.yaml: $(echo $only | tr ' ' ','), sized for $mem MB"
  ok "keys in $env_file"
  for p in $(dc config --format json 2>/dev/null | jq -r '.services[].ports[]?.published // empty'); do
    [ -z "$(port_owner "$p")" ] || busy="$busy $p"
  done
  if [ -n "$busy" ]; then
    warn "not starting them: already in use:$busy. Stop what's using those ports (or change them in compose.yaml), then: vhosty services up"
  elif confirm "Start them now?" Y; then
    need_docker
    dc up -d && services_status
  else
    info "Start them with: vhosty services up"
  fi
}

# Run a snippet in a database container, over TCP: a fresh container runs a temporary
# socket-only server while it initializes, and this never reaches that one.
# mysql_in: $C is the client, $DUMP the dump tool (mysql or mariadb), both logged in as root.
mysql_in() { # mysql_in SERVICE 'snippet' [args, as $1..]
  local svc="$1" snip="$2"; shift 2
  dc exec -T "$svc" sh -c 'P="${MYSQL_ROOT_PASSWORD:-${MARIADB_ROOT_PASSWORD:-}}"; [ -z "$P" ] || export MYSQL_PWD="$P"
    C=mysql; DUMP=mysqldump
    command -v mysql >/dev/null 2>&1 || { C=mariadb; DUMP=mariadb-dump; }
    C="$C -uroot -h127.0.0.1"; DUMP="$DUMP -uroot -h127.0.0.1"
    '"$snip" sh "$@"
}

# pg_in: $U is the superuser
pg_in() { # pg_in SERVICE 'snippet' [args, as $1..]
  local svc="$1" snip="$2"; shift 2
  dc exec -T "$svc" sh -c 'U="${POSTGRES_USER:-postgres}"; export PGHOST=127.0.0.1 PGOPTIONS="-c client_min_messages=warning"
    [ -z "${POSTGRES_PASSWORD:-}" ] || export PGPASSWORD="$POSTGRES_PASSWORD"
    '"$snip" sh "$@"
}

service_kind() { # image → mysql | postgres | volume
  # By the image's own name, without registry, owner or tag: mysql:8.4 and
  # pgvector/pgvector:pg18 are databases, prom/mysqld-exporter isn't
  local base="${1##*/}"
  base="${base%%[:@]*}"
  case "$base" in
    mysql|mysql-server|mariadb|percona|percona-server) echo mysql ;;
    postgres|postgresql|pgvector|postgis|timescaledb|timescaledb-ha) echo postgres ;;
    *) echo volume ;;
  esac
}

services_images() { dc config --format json | jq -r '.services | to_entries[] | "\(.key)|\(.value.image // "")"'; }
service_container() { dc ps -q --all "$1" 2>/dev/null | head -1; }
container_running() { [ "$(docker inspect -f '{{.State.Running}}' "$1" 2>/dev/null)" = "true" ]; }
container_mounts() { # type|volume name or host path|destination, one per line
  docker inspect -f '{{range .Mounts}}{{.Type}}|{{if eq .Type "volume"}}{{.Name}}{{else}}{{.Source}}{{end}}|{{.Destination}}{{"\n"}}{{end}}' "$1"
}

wait_db() { # wait_db SERVICE mysql|postgres
  local i=0
  while [ "$i" -lt 90 ]; do
    case "$2" in
      mysql)    mysql_in "$1" '$C -e "select 1"' </dev/null >/dev/null 2>&1 && return 0 ;;
      postgres) pg_in "$1" 'psql -U "$U" -d postgres -Atc "select 1"' </dev/null >/dev/null 2>&1 && return 0 ;;
    esac
    [ "$i" -gt 0 ] || info "waiting for $1"
    sleep 2
    i=$((i + 1))
  done
  die "$1 isn't ready after 3 minutes. Check: vhosty services logs $1"
}

is_test_db() { printf '%s' "$1" | grep -Eq "$BACKUP_SKIP_DBS"; }

backup_mysql() { # backup_mysql SERVICE OUT
  local svc="$1" out="$2" dbs db n=0 skipped=""
  dbs="$(mysql_in "$svc" '$C -N -e "show databases"' </dev/null)" || die "$svc: couldn't list the databases"
  for db in $dbs; do
    case "$db" in information_schema|mysql|performance_schema|sys) continue ;; esac
    if is_test_db "$db"; then skipped="$skipped $db"; continue; fi
    mysql_in "$svc" '$DUMP --single-transaction --routines --triggers --events --hex-blob --databases "$1"' "$db" </dev/null \
      | gzip >"$out/$svc/$db.sql.gz" || die "$svc: dumping $db failed"
    echo "mysql|$svc|$db|$svc/$db.sql.gz" >>"$out/MANIFEST"
    n=$((n + 1))
  done
  ok "$svc: $n database(s) dumped${skipped:+ (skipped test databases:$skipped)}"
}

backup_postgres() { # backup_postgres SERVICE OUT
  local svc="$1" out="$2" dbs db n=0 skipped="" create objects
  pg_in "$svc" 'pg_dumpall -U "$U" --roles-only' </dev/null | gzip >"$out/$svc/roles.sql.gz" || die "$svc: dumping the roles failed"
  echo "postgres-roles|$svc||$svc/roles.sql.gz" >>"$out/MANIFEST"
  dbs="$(pg_in "$svc" 'psql -U "$U" -d postgres -Atc "select datname from pg_database where not datistemplate order by 1"' </dev/null)" \
    || die "$svc: couldn't list the databases"
  for db in $dbs; do
    if is_test_db "$db"; then skipped="$skipped $db"; continue; fi
    create="--create"
    if [ "$db" = "postgres" ]; then
      # The maintenance database: only worth keeping if something was created in it
      objects="$(pg_in "$svc" 'psql -U "$U" -d postgres -Atc "$1"' \
        "select count(*) from pg_class c join pg_namespace s on s.oid = c.relnamespace where s.nspname !~ '^(pg_|information_schema)'" </dev/null)"
      [ "$objects" != "0" ] || continue
      create=""
    fi
    pg_in "$svc" 'pg_dump -U "$U" --clean --if-exists '"$create"' "$1"' "$db" </dev/null \
      | gzip >"$out/$svc/$db.sql.gz" || die "$svc: dumping $db failed"
    echo "postgres|$svc|$db|$svc/$db.sql.gz" >>"$out/MANIFEST"
    n=$((n + 1))
  done
  ok "$svc: $n database(s) and the roles dumped${skipped:+ (skipped test databases:$skipped)}"
}

backup_volumes() { # backup_volumes SERVICE CONTAINER OUT
  local svc="$1" cid="$2" out="$3" mounts mtype mname mdest file n=0 was_running=""
  mounts="$(container_mounts "$cid")"
  if [ -z "$mounts" ]; then info "$svc: no volumes, nothing to back up"; return 0; fi
  docker image inspect "$HELPER_IMAGE" >/dev/null 2>&1 || docker pull -q "$HELPER_IMAGE" >/dev/null || die "Couldn't pull $HELPER_IMAGE"
  # Stopped while archiving, so the files are consistent (Valkey also saves on shutdown)
  if container_running "$cid"; then
    was_running=1
    dc stop "$svc" </dev/null >/dev/null 2>&1 || die "$svc: couldn't stop it"
  fi
  while IFS='|' read -r mtype mname mdest <&3; do
    [ -n "$mtype" ] || continue
    if [ "$mtype" != "volume" ]; then warn "$svc: $mdest is a folder on this machine ($mname), not backed up"; continue; fi
    file="$svc/$(printf '%s' "$mdest" | sed 's#^/##; s#[^A-Za-z0-9._-]#_#g').tar.gz"
    if ! docker run --rm -v "$mname:/data:ro" "$HELPER_IMAGE" tar czf - -C /data . </dev/null >"$out/$file"; then
      [ -z "$was_running" ] || dc start "$svc" </dev/null >/dev/null 2>&1 || true
      die "$svc: archiving $mdest failed"
    fi
    echo "volume|$svc|$mdest|$file" >>"$out/MANIFEST"
    n=$((n + 1))
  done 3<<EOF
$mounts
EOF
  if [ -n "$was_running" ]; then
    dc start "$svc" </dev/null >/dev/null 2>&1 || die "$svc: couldn't start it again. Run: vhosty services up $svc"
  fi
  ok "$svc: $n volume(s) archived ($(du -sh "$out/$svc" | cut -f1 | tr -d ' '))"
}

cmd_services_backup() { # [--to DIR]
  local root out partial line svc image images kind cid started f keep t0 old pruned=0 skipped=""
  local usage="Usage: vhosty services backup [--to DIR]"
  root="${VHOSTY_BACKUP_DIR:-$VHOSTY_DIR/backups}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --to) [ $# -ge 2 ] || die "$usage"; root="$2"; shift 2 ;;
      --to=*) root="${1#--to=}"; shift ;;
      -h|--help) echo "$usage"; return 0 ;;
      *) die "$usage" ;;
    esac
  done
  mkdir -p "$root"
  root="$(cd "$root" && pwd)"
  out="$root/services-$(date +%Y%m%d-%H%M%S)"
  [ ! -e "$out" ] || die "$out already exists"
  partial="$out.partial"
  add_tmp "$partial"   # removed if anything fails
  umask 077   # dumps and keys: readable by you only
  mkdir -p "$partial/config"
  t0="$(date +%s)"
  printf "%sBacking up%s %s\n" "$B" "$N" "$VHOSTY_SERVICES_DIR"

  # compose.yaml, .env and anything else at the top (folders could be bind-mounted data)
  for f in "$VHOSTY_SERVICES_DIR"/* "$VHOSTY_SERVICES_DIR"/.[!.]*; do
    [ ! -f "$f" ] || cp -p "$f" "$partial/config/"
  done
  ok "config: $(ls -A "$partial/config" | tr '\n' ' ')"
  {
    echo "# vhosty services backup. Restore with: vhosty services restore <this folder>"
    echo "# type|service|database or volume path|file"
    echo "created=$(date '+%Y-%m-%d %H:%M:%S %z')"
    echo "host=$(hostname)"
    echo "vhosty=$VHOSTY_VERSION"
    echo "from=$VHOSTY_SERVICES_DIR"
  } >"$partial/MANIFEST"

  # Listed first: inside a for loop's $(...), a failure would just mean no
  # services, and a "backup" of the config alone
  images="$(services_images)" || die "Couldn't read the services from $VHOSTY_SERVICES_DIR/compose.yaml"
  [ -n "$images" ] || die "No services in $VHOSTY_SERVICES_DIR/compose.yaml"
  for line in $images; do
    svc="${line%%|*}"; image="${line#*|}"; kind="$(service_kind "$image")"
    cid="$(service_container "$svc")"
    if [ -z "$cid" ]; then warn "$svc: no container yet, skipped (vhosty services up $svc)"; skipped="$skipped $svc"; continue; fi
    mkdir -p "$partial/$svc"
    case "$kind" in
      mysql|postgres)
        started=""
        if ! container_running "$cid"; then
          dc start "$svc" </dev/null >/dev/null 2>&1 || die "$svc: couldn't start it to dump the databases"
          started=1
        fi
        wait_db "$svc" "$kind"
        "backup_$kind" "$svc" "$partial"
        [ -z "$started" ] || dc stop "$svc" </dev/null >/dev/null 2>&1 || true
        ;;
      *) backup_volumes "$svc" "$cid" "$partial" ;;
    esac
  done

  mv "$partial" "$out"
  mkdir -p "$RUN_DIR"
  echo "$(date +%s) $out" >"$BACKUP_STAMP"

  # Keep the newest VHOSTY_BACKUP_KEEP backups in this folder
  keep="${VHOSTY_BACKUP_KEEP:-7}"
  [ "$keep" -ge 1 ] 2>/dev/null || keep=7
  old="$(for f in "$root"/services-[0-9]*; do
    case "$f" in *.partial) ;; *) [ ! -d "$f" ] || printf '%s\n' "$f" ;; esac
  done | sort -r | tail -n +$((keep + 1)))"
  while IFS= read -r f; do
    [ -n "$f" ] && [ -f "$f/MANIFEST" ] || continue
    rm -rf "$f"; pruned=$((pruned + 1))
  done <<EOF
$old
EOF

  echo
  ok "saved $out ($(du -sh "$out" | cut -f1 | tr -d ' '), $(( $(date +%s) - t0 ))s)"
  [ "$pruned" = "0" ] || info "removed $pruned older backup(s); keeping $keep (VHOSTY_BACKUP_KEEP)"
  [ -z "$skipped" ] || warn "not backed up:$skipped"
  info "It holds your keys and data: copy it somewhere off this machine."
}

backup_status() { # for doctor
  local epoch="" path="" days
  if [ ! -f "$BACKUP_STAMP" ]; then warn "no backups yet. Run: vhosty services backup"; return 0; fi
  read -r epoch path <"$BACKUP_STAMP" || true
  days=$(( ( $(date +%s) - ${epoch:-0} ) / 86400 ))
  if [ "$days" -gt "${VHOSTY_BACKUP_WARN_DAYS:-7}" ]; then
    warn "last backup was $days days ago. Run: vhosty services backup"
  elif [ "$days" = "0" ]; then ok "backed up today ${D}$path${N}"
  else ok "backed up $days day(s) ago ${D}$path${N}"; fi
}

cmd_services_restore() { # <backup> [--into DIR] [--replace-config] [--yes]
  local src="" dir="" replace="" f base type svc target file cid vol t0 n=0 out
  local usage="Usage: vhosty services restore <backup folder> [--into DIR] [--replace-config] [--yes]"
  while [ $# -gt 0 ]; do
    case "$1" in
      --into) [ $# -ge 2 ] || die "$usage"; dir="$2"; shift 2 ;;
      --into=*) dir="${1#--into=}"; shift ;;
      --replace-config) replace=1; shift ;;
      -y|--yes) export VHOSTY_YES=1; shift ;;
      -h|--help) echo "$usage"; return 0 ;;
      -*) die "$usage" ;;
      *) [ -z "$src" ] || die "$usage"; src="$1"; shift ;;
    esac
  done
  [ -n "$src" ] || die "$usage"
  # A bare name means one in the backups folder: vhosty services restore services-20261030-112158
  if [ ! -d "$src" ] && [ -d "${VHOSTY_BACKUP_DIR:-$VHOSTY_DIR/backups}/$src" ]; then src="${VHOSTY_BACKUP_DIR:-$VHOSTY_DIR/backups}/$src"; fi
  [ -f "$src/MANIFEST" ] || die "$src isn't a vhosty services backup (no MANIFEST)"
  src="$(cd "$src" && pwd)"
  need_docker
  dir="${dir:-${VHOSTY_SERVICES_DIR:-$VHOSTY_DIR/services}}"
  mkdir -p "$dir"
  dir="$(cd "$dir" && pwd)"

  printf "%sRestore%s %s\n" "$B" "$N" "$src"
  info "$(sed -n 's/^created=/made /p' "$src/MANIFEST") on $(sed -n 's/^host=//p' "$src/MANIFEST")"
  printf "  into %s\n" "$dir"
  for f in "$src/config"/* "$src/config"/.[!.]*; do
    [ -f "$f" ] || continue
    base="$(basename "$f")"
    if [ -e "$dir/$base" ] && [ -z "$replace" ]; then info "  $base: keeping yours (--replace-config to use the backup's)"
    else info "  $base: from the backup"; fi
  done
  while IFS='|' read -r type svc target file <&3; do
    case "$type" in
      mysql|postgres) info "  $svc: database $target" ;;
      postgres-roles) info "  $svc: roles" ;;
      volume)         info "  $svc: volume $target" ;;
    esac
  done 3<"$src/MANIFEST"
  if ! confirm "This replaces those databases and volumes. Continue?" N; then
    has_tty || info "Without a terminal, add --yes."
    info "Cancelled."
    return 0
  fi
  t0="$(date +%s)"

  # 1. Config, then the containers and volumes (created, not started)
  for f in "$src/config"/* "$src/config"/.[!.]*; do
    [ -f "$f" ] || continue
    if [ ! -e "$dir/$(basename "$f")" ] || [ -n "$replace" ]; then cp -p "$f" "$dir/"; fi
  done
  VHOSTY_SERVICES_DIR="$dir"
  save_config
  out="$(dc up --no-start --quiet-pull 2>&1)" || { printf '%s\n' "$out" >&2; die "Couldn't create the services in $dir"; }
  ok "services created from $dir/compose.yaml"

  # 2. Volumes, with each service stopped
  docker image inspect "$HELPER_IMAGE" >/dev/null 2>&1 || docker pull -q "$HELPER_IMAGE" >/dev/null || die "Couldn't pull $HELPER_IMAGE"
  while IFS='|' read -r type svc target file <&3; do
    [ "$type" = "volume" ] || continue
    cid="$(service_container "$svc")"
    [ -n "$cid" ] || { warn "$svc isn't in compose.yaml; skipped its volume $target"; continue; }
    vol="$(container_mounts "$cid" | awk -F'|' -v d="$target" '$1 == "volume" && $3 == d { print $2 }')"
    [ -n "$vol" ] || { warn "$svc has no volume at $target in compose.yaml; skipped"; continue; }
    dc stop "$svc" </dev/null >/dev/null 2>&1 || true
    docker run --rm -i -v "$vol:/data" "$HELPER_IMAGE" sh -c 'find /data -mindepth 1 -delete && tar xzf - -C /data' <"$src/$file" \
      || die "$svc: restoring $target failed"
    ok "$svc: $target restored"
    n=$((n + 1))
  done 3<"$src/MANIFEST"

  # 3. Start everything, then load the databases
  out="$(dc up -d 2>&1)" || { printf '%s\n' "$out" >&2; die "Couldn't start the services"; }
  while IFS='|' read -r type svc target file <&3; do
    case "$type" in
      mysql)
        wait_db "$svc" mysql
        gunzip -c "$src/$file" | mysql_in "$svc" '$C' || die "$svc: loading $target failed"
        ok "$svc: $target loaded" ;;
      postgres-roles)
        wait_db "$svc" postgres
        # Roles that already exist (like postgres) fail harmlessly; the rest are created
        gunzip -c "$src/$file" | pg_in "$svc" 'psql -U "$U" -d postgres -q' >/dev/null 2>&1 || true
        ok "$svc: roles loaded" ;;
      postgres)
        wait_db "$svc" postgres
        # The dump drops and recreates the database, which needs it to be free
        pg_in "$svc" 'psql -U "$U" -d postgres -Atqc "$1"' \
          "select pg_terminate_backend(pid) from pg_stat_activity where datname = '$target' and pid <> pg_backend_pid()" </dev/null >/dev/null || true
        gunzip -c "$src/$file" | pg_in "$svc" 'psql -U "$U" -d postgres -q -v ON_ERROR_STOP=1' >/dev/null || die "$svc: loading $target failed"
        ok "$svc: $target loaded" ;;
      *) continue ;;
    esac
    n=$((n + 1))
  done 3<"$src/MANIFEST"

  echo
  ok "restored $n item(s) in $(( $(date +%s) - t0 ))s"
  services_status
}

# ---------------------------------------------------------------------------
# Commands: logs
# ---------------------------------------------------------------------------
# Rotates every log bigger than VHOSTY_LOG_MAX_MB (or all, with --force):
# copy, truncate, compress, keep VHOSTY_LOG_KEEP. The services keep running;
# everything that writes these files opens them in append mode, so the
# truncated file just continues from the start. Prints "file bytes" per log.
rotate_logs() { # rotate_logs [--force]
  local force="${1:-}" f size max keep i
  max=$(( ${VHOSTY_LOG_MAX_MB:-10} * 1024 * 1024 ))
  keep="${VHOSTY_LOG_KEEP:-5}"
  [ "$keep" -ge 1 ] 2>/dev/null || keep=1
  for f in "$LOG_DIR"/*.log; do
    [ -s "$f" ] || continue
    size="$(wc -c <"$f" | tr -d ' ')"
    if [ "$force" != "--force" ] && [ "$size" -le "$max" ]; then continue; fi
    rm -f "$f.$keep.gz"
    i=$keep
    while [ "$i" -gt 1 ]; do
      if [ -f "$f.$((i - 1)).gz" ]; then mv "$f.$((i - 1)).gz" "$f.$i.gz"; fi
      i=$((i - 1))
    done
    cp -p "$f" "$f.1"
    : >"$f"
    gzip -f "$f.1"
    echo "$f $size"
  done
}

human_size() { # bytes → 1.2 MB
  awk -v b="$1" 'BEGIN { split("B KB MB GB", u); i = 1; while (b >= 1024 && i < 4) { b /= 1024; i++ } printf (i == 1 ? "%d %s" : "%.1f %s"), b, u[i] }'
}

cmd_logs_rotate() {
  local force="" out f size
  case "${1:-}" in
    --force|-f) force="--force" ;;
    "") ;;
    *) die "Usage: vhosty logs rotate [--force]" ;;
  esac
  mkdir -p "$LOG_DIR"
  out="$(rotate_logs "$force")"
  if [ -z "$out" ]; then
    ok "nothing to rotate (every log is under ${VHOSTY_LOG_MAX_MB} MB)"
  else
    printf '%s\n' "$out" | while read -r f size; do ok "rotated ${f##*/} ($(human_size "$size")) → ${f##*/}.1.gz"; done
  fi
  info "logs use $(du -sh "$LOG_DIR" 2>/dev/null | awk '{print $1}'); keeping $VHOSTY_LOG_KEEP compressed copies of each"
}

log_files() {
  local s
  for s in $(svc_resolve "${1:-all}"); do svc_log "$s"; done
}

existing_logs() {
  local f
  while IFS= read -r f; do
    if [ -n "$f" ] && [ -f "$f" ]; then echo "$f"; fi
  done <<EOF
$(log_files "${1:-all}")
EOF
}

# tail_logs SERVICE TAIL-ARGS...: tail the service's log files, kept whole
# (a home folder can have spaces)
tail_logs() {
  local svc="$1" f files=()
  shift
  while IFS= read -r f; do
    [ -z "$f" ] || files+=("$f")
  done <<EOF
$(existing_logs "$svc")
EOF
  [ ${#files[@]} -gt 0 ] || die "No log files yet"
  tail "$@" "${files[@]}"
}

cmd_logs() { tail_logs "${1:-all}" -n "${2:-100}"; }

cmd_tail() { tail_logs "${1:-all}" -n 30 -f; }

# ---------------------------------------------------------------------------
# Commands: sites
# ---------------------------------------------------------------------------
cmd_sites() {
  need_config
  local dir p name lname note linked
  linked="$(cmd_links 2>/dev/null | grep https || true)"
  [ -n "$VHOSTY_PARKED" ] || [ -n "$linked" ] || die "No sites. Run: vhosty park <folder>, or vhosty link"
  if [ -n "$linked" ]; then head_ "Linked"; printf '%s\n' "$linked"; fi
  while IFS= read -r dir; do
    [ -n "$dir" ] || continue
    head_ "$dir"
    for p in "$dir"/*/; do
      [ -d "$p" ] || continue
      name="$(basename "$p")"; lname="$(lower "$name")"; note=""
      if valid_name "$lname" && [ "$name" != "$lname" ]; then
        if [ "$(parked_dir_for "$lname")" != "${p%/}" ]; then
          info "$name (not served: $(parked_dir_for "$lname") has the name $lname)"; continue
        fi
        grep -qF "@site_$lname host" "$CADDYFILE" 2>/dev/null || note="; run vhosty rebuild to serve it"
      fi
      if ! valid_name "$lname"; then
        info "$name (not a valid hostname: letters, numbers and dashes, no dash at either end)"
      elif printf '%s' "$lname" | grep -qE '^[0-9]+$'; then
        info "$name (a number: https://$lname.$VHOSTY_DOMAIN is the port route, not this folder)"
      elif php_enabled && [ -f "$p/public/index.php" ]; then
        site_load "$lname"
        printf "  https://%s.%s  %s(PHP %s%s%s)%s\n" "$lname" "$VHOSTY_DOMAIN" "$D" "$(site_php)" "$([ -n "$SITE_PHP" ] && echo ", pinned")" "$note" "$N"
      elif [ -f "$p/index.html" ]; then
        printf "  https://%s.%s  %s(static%s)%s\n" "$lname" "$VHOSTY_DOMAIN" "$D" "$note" "$N"
      else
        info "$name (no public/index.php or index.html)"
      fi
    done
  done <<EOF
$(parked_list)
EOF
  echo
}

site_url() { # site_url [site|port]: with none, the site of the current folder
  need_config
  local name
  if [ -n "${1:-}" ]; then name="$(lower "$1")"
  else name="$(site_from_dir "$PWD")" || die "$PWD isn't inside a site. Pass a site name or a port."; fi
  echo "https://$name.$VHOSTY_DOMAIN"
}

cmd_open() {
  local u
  u="$(site_url "${1:-}")"
  if open_url "$u"; then ok "opened $u"; else echo "$u"; fi
}

cmd_url() {
  local u
  u="$(site_url "${1:-}")"
  echo "$u"
  if copy_text "$u" 2>/dev/null; then info "(copied to clipboard)"; fi
}

# ---------------------------------------------------------------------------
# Commands: config
# ---------------------------------------------------------------------------
cmd_validate() {
  local target="${1:-all}" rc=0 v out
  if [ "$target" = "all" ] || [ "$target" = "caddy" ]; then
    load_token
    if out="$(CF_API_TOKEN="$CF_API_TOKEN" "$CADDY_BIN" validate --config "$CADDYFILE" --adapter caddyfile 2>&1)"; then
      ok "Caddyfile is valid"
    else
      bad "Caddyfile has errors:"
      printf '%s\n' "$out" | grep -iE 'error' | tail -5 | sed 's/^/      /' || true
      rc=1
    fi
  fi
  case "$target" in all|php|php-fpm)
    for v in $(php_versions_in_use); do
      if out="$("$(fpm_bin "$v")" -t --fpm-config "$(fpm_conf "$v")" 2>&1)"; then
        ok "PHP $v FPM config is valid"
      else
        bad "PHP $v FPM config has errors:"
        printf '%s\n' "$out" | tail -5 | sed 's/^/      /'
        rc=1
      fi
    done ;;
  esac
  return $rc
}

cmd_edit() {
  need_config
  case "${1:-config}" in
    config) ${EDITOR:-nano} "$CONFIG_FILE"; load_config; cmd_rebuild ;;
    php|ini|php.ini) INI_SCOPE="global"; cmd_ini_edit --global ;;
    env|token) ${EDITOR:-nano} "$SECRETS_FILE"; chmod 600 "$SECRETS_FILE"; svc_restart caddy; ok "restarted caddy" ;;
    *) die "Unknown file '$1' (use config, php, or env)" ;;
  esac
}

# Days until a certificate expires, or nothing when the date can't be read
cert_days_left() {
  local end s
  end="$(openssl x509 -in "$1" -noout -enddate 2>/dev/null | cut -d= -f2)"
  [ -n "$end" ] || return 0
  s="$(date -d "$end" +%s 2>/dev/null || date -j -f '%b %e %T %Y %Z' "$end" +%s 2>/dev/null)" || return 0
  echo $(( (s - $(date +%s) + 43200) / 86400 ))
}

# Caddy renews when about 30 days are left, so fewer than this means
# renewal has been failing (usually the Cloudflare token)
CERT_WARN_DAYS=20

cmd_cert() {
  need_config
  local crt days left="" rc=0
  crt="$(find "$CADDY_CERTS" -name "wildcard_.$VHOSTY_DOMAIN.crt" 2>/dev/null | head -1 || true)"
  if [ -z "$crt" ]; then
    bad "No certificate for *.$VHOSTY_DOMAIN yet (check: vhosty logs caddy)"
    return 1
  fi
  if ! command -v openssl >/dev/null 2>&1; then
    ok "certificate for *.$VHOSTY_DOMAIN (install openssl to check its expiry)"
    return 0
  fi
  days="$(cert_days_left "$crt")"
  [ -z "$days" ] || left=" in $days day$([ "$days" = "1" ] || echo s)"
  if ! openssl x509 -in "$crt" -noout -checkend 0 >/dev/null 2>&1; then
    bad "certificate for *.$VHOSTY_DOMAIN has expired: Caddy couldn't renew it"; rc=1
    info "See why: vhosty logs caddy. A deleted or expired Cloudflare token is the usual cause: vhosty edit env"
  elif ! openssl x509 -in "$crt" -noout -checkend $((CERT_WARN_DAYS * 86400)) >/dev/null 2>&1; then
    warn "certificate for *.$VHOSTY_DOMAIN expires$left, and Caddy should have renewed it by now"
    info "See why: vhosty logs caddy. A deleted or expired Cloudflare token is the usual cause: vhosty edit env"
  else
    ok "certificate for *.$VHOSTY_DOMAIN (expires$left)"
  fi
  openssl x509 -in "$crt" -noout -issuer -enddate 2>/dev/null | sed 's/^/      /'
  return $rc
}

cmd_dns() {
  need_config
  case "${1:-sync}" in
    sync)
      dns_sync
      # Caddy listens on the Tailscale IP, so a new IP needs a new Caddyfile
      if svc_installed && ! grep -q "default_bind $(ts_ip) " "$CADDYFILE" 2>/dev/null; then cmd_rebuild; fi
      ;;
    *) die "Usage: vhosty dns sync" ;;
  esac
}

# Latest release tag (v0.3.0), from where github.com/<repo>/releases/latest
# redirects: no API rate limit, no jq. Fails offline or with no releases.
latest_release() {
  local u
  u="$(curl -fsSLI --max-time 5 -o /dev/null -w '%{url_effective}' "https://github.com/$VHOSTY_REPO/releases/latest" 2>/dev/null)" || return 1
  case "$u" in */releases/tag/?*) echo "${u##*/releases/tag/}" ;; *) return 1 ;; esac
}

# version_cmp A B: prints -1, 0 or 1. Dot-separated numbers; a leading v
# and suffixes like -dev are ignored.
version_cmp() {
  local a="${1#v}" b="${2#v}" x y
  while [ -n "$a" ] || [ -n "$b" ]; do
    x="${a%%.*}"; x="${x%%[!0-9]*}"; x="${x:-0}"
    y="${b%%.*}"; y="${y%%[!0-9]*}"; y="${y:-0}"
    if [ "$x" -lt "$y" ]; then echo -1; return 0; fi
    if [ "$x" -gt "$y" ]; then echo 1; return 0; fi
    case "$a" in *.*) a="${a#*.}" ;; *) a="" ;; esac
    case "$b" in *.*) b="${b#*.}" ;; *) b="" ;; esac
  done
  echo 0
}

sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d' ' -f1
  else shasum -a 256 "$1" | cut -d' ' -f1; fi
}

# verify_release TAG FILE NAME: checks FILE against the SHA256SUMS published
# with the release (from 0.5.0 on). Dies on a mismatch; older releases and
# branches have no sums, which is said, not fatal.
verify_release() {
  local ref="$1" file="$2" name="$3" sums want
  case "$ref" in v[0-9]*) ;; *) return 0 ;; esac
  if ! sums="$(curl -fsSL --retry 2 --max-time 20 "https://github.com/$VHOSTY_REPO/releases/download/$ref/SHA256SUMS" 2>/dev/null)"; then
    [ "$name" != "vhosty" ] || info "no checksums published with $ref"
    return 0
  fi
  want="$(printf '%s\n' "$sums" | awk -v n="$name" '$2 == n || $2 == "*" n {print $1; exit}')"
  [ -n "$want" ] || die "$ref's SHA256SUMS has no entry for $name. Not installing it."
  [ "$(sha256_of "$file")" = "$want" ] || die "$name from $ref doesn't match its published checksum. Not installing it."
}

cmd_update_self() {
  local usage="Usage: vhosty update self [--ref TAG|main] [--force]"
  local ref="" force=0 new comp ver
  while [ $# -gt 0 ]; do
    case "$1" in
      --ref) [ -n "${2:-}" ] || die "$usage"; ref="$2"; shift 2 ;;
      --force) force=1; shift ;;
      -h|--help) echo "$usage"; return 0 ;;
      *) die "$usage" ;;
    esac
  done
  [ ! -L "$BIN_DIR/vhosty" ] || die "$BIN_DIR/vhosty links to $(readlink "$BIN_DIR/vhosty"). Update that instead (git pull)."
  if [ -z "$ref" ]; then
    ref="$(latest_release)" || die "Couldn't look up the latest release (offline?). Or install main: vhosty update self --ref main"
    case "$(version_cmp "$ref" "$VHOSTY_VERSION")" in
      0) if [ "$force" != "1" ]; then ok "vhosty $VHOSTY_VERSION is the latest release"; return 0; fi ;;
      -1) [ "$force" = "1" ] || die "vhosty $VHOSTY_VERSION is newer than the latest release ($ref), so not downgrading. From a clone, update with: git pull && ./install.sh (or: vhosty update self --force)" ;;
    esac
  fi

  # Into the same folder, then renamed over the old one: a running vhosty
  # keeps reading its old copy, and a failed download changes nothing
  mkdir -p "$BIN_DIR" "$VHOSTY_DIR/completions"
  new="$BIN_DIR/.vhosty.new"; comp="$VHOSTY_DIR/completions/._vhosty.new"
  add_tmp "$new"; add_tmp "$comp"
  download "https://raw.githubusercontent.com/$VHOSTY_REPO/$ref/bin/vhosty" "$new" \
    || die "Couldn't download vhosty $ref"
  ver="$(sed -n 's/^VHOSTY_VERSION="\(.*\)"$/\1/p' "$new" | head -1)"
  [ -n "$ver" ] && bash -n "$new" 2>/dev/null || die "What came from $ref doesn't look like vhosty. Not installing it."
  if ! curl -fsSL --retry 2 --max-time 30 -o "$comp" "https://raw.githubusercontent.com/$VHOSTY_REPO/$ref/completions/_vhosty" 2>/dev/null; then
    rm -f "$comp"
  fi
  verify_release "$ref" "$new" vhosty
  [ ! -f "$comp" ] || verify_release "$ref" "$comp" _vhosty
  chmod 755 "$new"
  mv "$new" "$BIN_DIR/vhosty"
  [ ! -f "$comp" ] || mv "$comp" "$VHOSTY_DIR/completions/_vhosty"
  ok "vhosty $VHOSTY_VERSION → $ver ($ref)"
  case "$ref" in v[0-9]*) info "What's new: https://github.com/$VHOSTY_REPO/releases/tag/$ref" ;; esac

  # Let the new version regenerate the config, so its changes take effect
  if [ -f "$CONFIG_FILE" ] && svc_installed; then
    cleanup_tmp
    exec "$BIN_DIR/vhosty" rebuild
  fi
}

cmd_update() {
  local what="${1:-all}"
  [ $# -eq 0 ] || shift
  case "$what" in
    self|vhosty) cmd_update_self "$@"; return ;;
    caddy) need_config; install_caddy ;;
    php|php-fpm)
      need_config
      php_enabled || die "PHP is turned off"
      is_macos || die "On Linux, PHP comes from apt: sudo apt update && sudo apt upgrade"
      install_php_fpm "${1:-$(php_default)}" ;;
    all)
      need_config
      install_caddy
      if php_enabled && is_macos; then install_php_fpm "$(php_default)"; fi ;;
    *) die "Usage: vhosty update [self|caddy|php [8.x]]" ;;
  esac
  if svc_installed; then cmd_restart all; fi
  # Last, since it hands over to the new version. Its errors are already shown.
  if [ "$what" = "all" ]; then ( cmd_update_self ) || true; fi
}

cmd_paths() {
  local s
  cat <<EOF
  vhosty dir    $VHOSTY_DIR
  Config        $CONFIG_FILE
  PHP settings  $PHP_INI
  Token         $SECRETS_FILE
  Caddyfile     $CADDYFILE
  FPM configs   $PHP_CONF_DIR/<version>/php-fpm.conf
  Binaries      $BIN_DIR
  Logs          $LOG_DIR
  Sockets       $RUN_DIR
EOF
  if is_linux; then
    printf "  Services      %s/vhosty-caddy.service\n" "$UNIT_DIR"
    printf "                %s/vhosty-php@.service\n" "$UNIT_DIR"
    printf "                %s/vhosty-logs.timer (log rotation)\n" "$UNIT_DIR"
  else
    printf "  Services      %s\n" "$(plist_for caddy)"
    for s in $(svc_all); do [ "$s" = caddy ] || printf "                %s\n" "$(plist_for "$s")"; done
  fi
  printf "  Certificates  %s\n" "$CADDY_CERTS"
}

# ---------------------------------------------------------------------------
# Command: prune (configs and leftovers for things that are gone)
# ---------------------------------------------------------------------------
# Site configs whose folder is gone, or no longer parked
stale_sites() {
  local name dir
  for name in $(site_names); do
    site_load "$name"
    dir="$(site_dir "$name" || true)"
    [ -n "$dir" ] && [ -d "$dir" ] || echo "$name"
  done
}

# Generated files nothing uses any more: "path<TAB>why"
prune_leftovers() {
  local d v f keep name
  keep=" $(php_versions_in_use | tr '\n' ' ') "
  for d in "$PHP_CONF_DIR"/*/; do
    [ -d "$d" ] || continue
    v="${d%/}"; v="${v##*/}"
    case "$keep" in *" $v "*) ;; *) printf '%s\tFPM config for PHP %s, which no site uses\n' "${d%/}" "$v" ;; esac
  done
  for f in "$RUN_DIR"/php-*.sock "$RUN_DIR"/php-*.pid; do
    [ -e "$f" ] || continue
    v="${f##*/php-}"; v="${v%.*}"
    case "$keep" in *" $v "*) continue ;; esac
    [ "$(svc_state "php-$v")" = "running" ] || printf '%s\tPHP %s isn'"'"'t running\n' "$f" "$v"
  done
  # By the sites, not the FPM configs on disk: those still list the pools
  # of sites about to be pruned
  for f in "$RUN_DIR"/site-*.sock; do
    [ -e "$f" ] || continue
    name="${f##*/site-}"; name="${name%.sock}"
    if site_folder "$name" >/dev/null && [ -n "$SITE_INI" ]; then continue; fi
    printf '%s\tsocket for a pool that no longer exists\n' "$f"
  done
}

describe_site() { # one line about a site config: what would be lost
  local what=""
  site_load "$1"
  [ "$SITE_LINKED" != "yes" ] || what="link"
  [ -z "$SITE_PHP" ] || what="${what:+$what, }PHP $SITE_PHP"
  [ -z "$SITE_INI" ] || what="${what:+$what, }settings ($(printf '%s\n' "$SITE_INI" | cut -d= -f1 | tr '\n' ' ' | sed 's/ $//'))"
  [ -z "$SITE_EXT" ] || what="${what:+$what, }extensions ($SITE_EXT)"
  printf '%s  %s(%s; was %s)%s' "$1" "$D" "${what:-no settings}" "${SITE_PATH:-?}" "$N"
}

cmd_prune() {
  need_config
  local yes=0 rebuild=1 stale leftovers name f why
  while [ $# -gt 0 ]; do
    case "$1" in
      -y|--yes) yes=1; shift ;;
      --no-rebuild) rebuild=0; shift ;;
      *) die "Usage: vhosty prune [--yes]" ;;
    esac
  done
  stale="$(stale_sites)"
  # Leftovers are counted as if the stale sites were already gone
  leftovers="$(prune_leftovers)"
  if [ -z "$stale" ] && [ -z "$leftovers" ]; then ok "nothing to prune"; return 0; fi
  if [ -n "$stale" ]; then
    head_ "Sites whose folder is gone or no longer parked"
    for name in $stale; do printf '  %s\n' "$(describe_site "$name")"; done
  fi
  if [ -n "$leftovers" ]; then
    head_ "Leftover files"
    printf '%s\n' "$leftovers" | while IFS="$(printf '\t')" read -r f why; do printf '  %s  %s(%s)%s\n' "${f#"$VHOSTY_DIR"/}" "$D" "$why" "$N"; done
  fi
  echo
  if [ "$yes" != "1" ]; then
    has_tty || die "Not removing anything without a terminal. Run: vhosty prune --yes"
    confirm "Remove these?" Y || { info "Nothing removed."; return 0; }
  fi
  for name in $stale; do rm -f "$(site_file "$name")"; ok "removed site $name"; done
  printf '%s\n' "$leftovers" | while IFS="$(printf '\t')" read -r f why; do
    [ -n "$f" ] || continue
    rm -rf "$f"; ok "removed ${f#"$VHOSTY_DIR"/}"
  done
  if [ -n "$stale" ] && [ "$rebuild" = "1" ] && svc_installed; then cmd_rebuild; fi
}

# ---------------------------------------------------------------------------
# doctor --fix
# ---------------------------------------------------------------------------
# "version ext" for every site's missing extensions
missing_ext_pairs() { ext_report | awk -F'|' '$3 != "?" {print $2, $3}'; }

# Docker services that are defined but not running
docker_down() {
  local defined rows svc
  defined="$(dc config --services 2>/dev/null | sort)"
  rows="$(services_rows)"
  for svc in $defined; do
    printf '%s\n' "$rows" | grep -q "^$svc|running|" || echo "$svc"
  done
}

fix_ok() { # fix_ok "what"
  if [ "$FIX_YES" = "1" ]; then step "$1"; return 0; fi
  printf "\n"
  confirm "${B}Fix:${N} $1?" Y
}

doctor_fix() {
  local ip resolved s v exts pairs down need_rebuild=0 fixed=0
  head_ "Fixing"

  ip="$(ts_ip)"
  resolved="$(resolve_a "vhosty-doctor.$VHOSTY_DOMAIN")"
  if [ -n "$ip" ] && [ "$resolved" != "$ip" ] && fix_ok "point *.$VHOSTY_DOMAIN at $ip (vhosty dns sync)"; then
    dns_sync; need_rebuild=1; fixed=1
  fi

  if [ -n "$(stale_sites)" ] && fix_ok "remove configs for sites whose folder is gone or no longer parked (vhosty prune)"; then
    cmd_prune --yes --no-rebuild; need_rebuild=1; fixed=1
  fi

  if php_enabled && is_linux; then
    pairs="$(missing_ext_pairs | sort -u)"
    for v in $(printf '%s\n' "$pairs" | cut -d' ' -f1 | grep . | sort -u); do
      exts="$(printf '%s\n' "$pairs" | awk -v v="$v" '$1 == v {print $2}' | tr '\n' ' ' | sed 's/ $//')"
      # shellcheck disable=SC2086
      if fix_ok "install on PHP $v: $exts (vhosty ext install)"; then install_exts "$v" $exts; fixed=1; fi
    done
  fi

  if ! config_in_sync || ! config_applied; then need_rebuild=1; fi
  for s in $(svc_all); do [ "$(svc_state "$s")" = "running" ] || need_rebuild=1; done
  if is_linux && ! sd is-active --quiet vhosty-logs.timer 2>/dev/null; then need_rebuild=1; fi
  if [ "$need_rebuild" = "1" ] && svc_installed && fix_ok "regenerate config and start or reload services (vhosty rebuild)"; then
    cmd_rebuild; fixed=1
  fi

  if [ -n "$VHOSTY_SERVICES_DIR" ] && ( need_services ) 2>/dev/null; then
    down="$(docker_down | tr '\n' ' ' | sed 's/ $//')"
    # shellcheck disable=SC2086
    if [ -n "$down" ] && fix_ok "start Docker services: $down (vhosty services up)"; then dc up -d $down; fixed=1; fi
  fi

  [ "$fixed" = "1" ] || info "nothing doctor can fix on its own. See the checks above."
  return 0
}

# ---------------------------------------------------------------------------
# Command: doctor
# ---------------------------------------------------------------------------
cmd_doctor() {
  local fix=0
  FIX_YES=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --fix) fix=1; shift ;;
      -y|--yes) FIX_YES=1; shift ;;
      *) die "Usage: vhosty doctor [--fix [--yes]]" ;;
    esac
  done
  if [ "$fix" = "1" ] && [ "$FIX_YES" != "1" ] && ! has_tty; then
    die "doctor --fix asks before each fix. Without a terminal, add --yes"
  fi
  if [ "$fix" = "1" ]; then
    doctor_checks && return 0
    doctor_fix
    printf "\n%sChecking again%s\n" "$B" "$N"
    local out rc=0
    out="$(doctor_checks 2>&1)" || rc=1
    printf '%s\n' "$out" | grep -E '✗|All good|Some checks' || true
    return $rc
  fi
  doctor_checks
}

doctor_checks() {
  need_config
  FAILED=0
  is_macos && sudo -v
  local ip probe resolved s st code o v name dir latest
  ip="$(ts_ip)"
  probe="vhosty-doctor.$VHOSTY_DOMAIN"
  printf "%svhosty doctor%s  (*.%s)\n" "$B" "$N" "$VHOSTY_DOMAIN"

  head_ "Network"
  if [ -n "$ip" ]; then ok "Tailscale IP: $ip"; else bad "Tailscale isn't running, or its CLI wasn't found"; fi
  resolved="$(resolve_a "$probe")"
  if [ -z "$resolved" ]; then
    bad "*.$VHOSTY_DOMAIN doesn't resolve. Run: vhosty dns sync"
  elif [ -n "$ip" ] && [ "$resolved" != "$ip" ]; then
    bad "*.$VHOSTY_DOMAIN resolves to $resolved, expected $ip. Run: vhosty dns sync"
  else
    ok "*.$VHOSTY_DOMAIN resolves to $resolved"
  fi

  head_ "Caddy"
  if [ -x "$CADDY_BIN" ]; then ok "binary: $("$CADDY_BIN" version 2>/dev/null | awk '{print $1}')"; else bad "Caddy missing. Run: vhosty update caddy"; fi
  if "$CADDY_BIN" list-modules 2>/dev/null | grep -q dns.providers.cloudflare; then ok "Cloudflare DNS plugin"; else bad "Caddy is missing the Cloudflare plugin. Run: vhosty update caddy"; fi
  if is_linux; then
    if ! sbin_cmd getcap >/dev/null; then warn "can't check that Caddy may use ports 80 and 443: sudo apt install libcap2-bin"
    elif caddy_can_bind; then ok "allowed to use ports 80 and 443"
    else bad "Caddy can't bind 80/443. Run: vhosty setup"; fi
  fi
  if [ -s "$SECRETS_FILE" ]; then ok "token file present"; else bad "Missing $SECRETS_FILE. Run: vhosty setup"; fi
  cmd_validate caddy || true
  cmd_cert || true

  if php_enabled; then
    head_ "PHP"
    for v in $(php_versions_in_use); do
      if php_is_installed "$v"; then ok "PHP $v: $("$(fpm_bin "$v")" -v 2>/dev/null | head -1 | awk '{print $2}')"
      else bad "PHP $v isn't installed"; fi
    done
    cmd_validate php || true
  fi

  head_ "Config"
  if config_in_sync; then ok "generated files match ~/.vhosty settings"
  else bad "$(drift_reason). Run: vhosty rebuild"; fi
  if config_applied; then ok "services are running the current config"
  elif svc_installed; then bad "services haven't loaded the current config. Run: vhosty rebuild"; fi
  for name in $(site_names); do
    site_load "$name"
    dir="$(site_dir "$name" || true)"
    if [ -z "$dir" ] || [ ! -d "$dir" ]; then
      bad "site $name: folder ${dir:-?} is gone. Remove its config: vhosty prune"
    fi
    if [ -n "$SITE_PHP" ] && ! php_is_installed "$SITE_PHP"; then
      bad "site $name is pinned to PHP $SITE_PHP, which isn't installed (using $(php_default)). Run: vhosty php install $SITE_PHP"
    fi
  done

  if php_enabled; then
    head_ "PHP extensions"
    cmd_ext_check
    head_ "Debug mode"
    debug_sites_check
  fi

  head_ "Services"
  if is_linux; then
    if [ "$(loginctl show-user "$VHOSTY_USER" -p Linger --value 2>/dev/null)" = "yes" ]; then ok "start at boot (linger on)"
    else bad "services won't start until you log in. Run: vhosty setup"; fi
    if sd is-active --quiet vhosty-logs.timer 2>/dev/null; then
      ok "logs rotate daily over $VHOSTY_LOG_MAX_MB MB ($(du -sh "$LOG_DIR" 2>/dev/null | awk '{print $1}') now)"
    elif svc_installed; then bad "log rotation timer isn't running. Run: vhosty rebuild"; fi
  fi
  for s in $(svc_all); do
    st="$(svc_state "$s")"
    if [ "$st" = "running" ]; then ok "$s running"
    elif svc_installed; then bad "$s $st. Run: vhosty start (logs: vhosty logs $s)"
    else bad "$s not installed. Run: vhosty setup"; fi
  done
  o="$(port_owner 443)"; if [ -n "$o" ]; then ok "443 → $o"; else bad "nothing listening on 443"; fi
  for v in $(php_versions_in_use); do
    if [ -S "$(fpm_sock "$v")" ]; then ok "PHP $v socket"; else bad "no socket for PHP $v"; fi
  done

  if [ -n "$VHOSTY_SERVICES_DIR" ]; then
    head_ "Docker services"
    if ( need_services ) 2>/dev/null; then
      services_status --no-header
      backup_status
    else
      bad "$( ( need_services ) 2>&1 | sed 's/^error: //')"
    fi
  fi

  head_ "End to end"
  code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 8 "https://$probe/" 2>/dev/null || true)"
  if [ -n "$code" ] && [ "$code" != "000" ]; then
    ok "https://$probe answered with HTTP $code"
  else
    bad "Couldn't reach https://$probe (TLS or connection failed)"
  fi

  head_ "vhosty"
  if [ "${VHOSTY_UPDATE_CHECK:-1}" = "0" ]; then
    ok "vhosty $VHOSTY_VERSION (update check off)"
  elif ! latest="$(latest_release)"; then
    info "vhosty $VHOSTY_VERSION (couldn't check for a newer release)"
  elif [ "$(version_cmp "$latest" "$VHOSTY_VERSION")" = "1" ]; then
    warn "vhosty ${latest#v} is out (you have $VHOSTY_VERSION). Run: vhosty update self"
  else
    ok "vhosty $VHOSTY_VERSION (latest release: ${latest#v})"
  fi

  echo
  if [ "$FAILED" = "0" ]; then
    printf "%sAll good.%s\n" "$G" "$N"
  else
    printf "%sSome checks failed. See above, or run: vhosty doctor --fix%s\n" "$R" "$N"
    return 1
  fi
}

# ---------------------------------------------------------------------------
# Command: uninstall
# ---------------------------------------------------------------------------
cmd_uninstall() {
  local s
  confirm "Stop and remove the vhosty services? (~/.vhosty and your DNS record stay)" N || { info "Cancelled."; return 0; }
  if is_linux; then
    for s in $(sd list-unit-files 'vhosty-*' --plain --no-legend 2>/dev/null | awk '{print $1}'; sd list-units 'vhosty-php@*' --all --plain --no-legend 2>/dev/null | awk '{print $1}'); do
      svc_remove "$s"
    done
    rm -f "$UNIT_DIR/vhosty-caddy.service" "$UNIT_DIR/vhosty-php@.service" "$UNIT_DIR/vhosty-logs.service" "$UNIT_DIR/vhosty-logs.timer"
    sd daemon-reload
    ok "removed the systemd user services"
    info "Linger stays on (other user services may need it). To turn it off: sudo loginctl disable-linger $VHOSTY_USER"
  else
    for s in $(svc_all) $(launchd_stale); do
      if [ -f "$(plist_for "$s")" ]; then svc_remove "$s"; ok "removed $(label_of "$s")"; fi
    done
  fi
  info "To remove everything: rm -rf $VHOSTY_DIR, and delete the *.$VHOSTY_DOMAIN record in Cloudflare."
}

# ---------------------------------------------------------------------------
# Help
# ---------------------------------------------------------------------------
usage() {
  cat <<EOF
${B}vhosty${N} $VHOSTY_VERSION: Herd for your tailnet

${B}Setup${N}
  vhosty setup [--domain D] [--park DIR] [--no-php] [--yes] [--overwrite-dns]
                                     The token: CF_API_TOKEN=..., asked for, or --token T
  vhosty uninstall                   Remove the services (keeps your files)

${B}Sites${N}
  vhosty park [dir]                  Serve every folder in dir (default: current)
  vhosty unpark [dir]                Stop serving a parked folder
  vhosty parked                      List parked folders
  vhosty link [dir] [--name N]       Serve one folder, anywhere, as N.domain (default: current)
  vhosty unlink [name]               Remove a link
  vhosty links                       List links
  vhosty sites                       List sites and their URLs
  vhosty site [name]                 Everything about one site (default: current folder)
  vhosty open [site|port]            Open in the browser (default: current folder)
  vhosty url  [site|port]            Print the URL and copy it

${B}PHP${N}
  vhosty php [list]                  Installed versions, the default, and pins
  vhosty php install <version>       Install a PHP version (apt on Linux)
  vhosty php default [version]       Show or set the default version
  vhosty php which [site]            The version a site uses (default: current folder)
  vhosty isolate <version> [site]    Pin a site to a version (default: current folder)
  vhosty unisolate [site]            Back to the default version
  vhosty isolated                    List pinned sites
  vhosty ext [site]                  A site's extensions: declared and required by composer.lock
  vhosty ext require <ext..> [..]    A site needs an extension composer doesn't require (e.g. protobuf)
  vhosty ext unrequire <ext..> [..]  Remove that again
  vhosty ext install <ext..> [--php V]  Install extensions (apt) and restart PHP-FPM
  vhosty ext check                   Check every site against its PHP version
  ${D}php, php artisan and composer use the site's version inside its folder.${N}

${B}PHP settings${N} ${D}(default scope: the current folder's site, else global)${N}
  vhosty ini [--global|--site N]     Show settings
  vhosty ini set <key> <value> [..]  Set one, e.g. vhosty ini set memory_limit 2G
  vhosty ini unset <key> [..]        Remove one
  vhosty ini edit [..]               Edit in \$EDITOR

${B}Docker services${N} ${D}(docker compose in VHOSTY_SERVICES_DIR)${N}
  vhosty services [status]           State and ports of each service
  vhosty services up|stop|restart [svc..]   Start (default: all), stop, restart
  vhosty services down               Stop and remove the containers (data stays)
  vhosty services logs|tail [svc..]  Recent logs, or follow them
  vhosty services pull [svc..]       Update images and recreate
  vhosty services exec <svc> [cmd]   Run a command in a service (e.g. mysql)
  vhosty services edit | dir [path]  Edit compose.yaml, or show/set the folder
  vhosty services init [dir] [--only mysql,valkey,..]  Write a compose.yaml for MySQL, Postgres,
                                     Valkey, Meilisearch, Typesense and RustFS, sized for this machine
  vhosty services backup [--to DIR]  Dump the databases, archive the other volumes, copy the config
  vhosty services restore <backup> [--yes]  Put a backup back: config, volumes, then databases

${B}Caddy and PHP-FPM${N}
  vhosty start   [caddy|php|php-8.x] Start services (default: all)
  vhosty stop    [caddy|php|php-8.x] Stop services
  vhosty restart [caddy|php|php-8.x] Validate config, then restart
  vhosty status                      Service state, PIDs, and sockets
  vhosty logs [service] [N]          Show the last N log lines (default 100)
  vhosty logs rotate [--force]       Rotate logs over VHOSTY_LOG_MAX_MB (daily on Linux)
  vhosty tail [service]              Follow logs live

${B}Config${N}
  vhosty edit [config|php|env]       Edit settings, PHP settings, or the token, then apply
  vhosty rebuild                     Regenerate config and reload services
  vhosty dns sync                    Point *.domain at this machine's Tailscale IP
  vhosty update [self|caddy|php]     Update vhosty (latest release), Caddy, and PHP-FPM on macOS
  vhosty validate                    Check the generated config
  vhosty cert                        Show the wildcard certificate and expiry
  vhosty doctor [--fix [--yes]]      Check DNS, certs, config, sites, services, and HTTPS; --fix repairs
  vhosty prune [--yes]               Remove configs for sites whose folder is gone or unparked, and leftovers
  vhosty ip | domain | paths         Quick lookups
  vhosty version
EOF
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
main() {
  local cmd="${1:-help}"
  if [ $# -gt 0 ]; then shift; fi
  load_config

  case "$cmd" in
    setup)              cmd_setup "$@" ;;
    park)               cmd_park "${1:-}" ;;
    unpark)             cmd_unpark "${1:-}" ;;
    link)               cmd_link "$@" ;;
    unlink)             cmd_unlink "${1:-}" ;;
    links)              cmd_links ;;
    site|info)          cmd_site "${1:-}" ;;
    parked)             cmd_parked ;;
    php)                cmd_php "$@" ;;
    isolate)            cmd_isolate "${1:-}" "${2:-}" ;;
    unisolate)          cmd_unisolate "${1:-}" ;;
    isolated)           cmd_isolated ;;
    ini)                cmd_ini "$@" ;;
    ext|exts|extension|extensions) cmd_ext "$@" ;;
    services|svc|db)    cmd_services "$@" ;;
    sites|ls)           cmd_sites ;;
    open)               cmd_open "${1:-}" ;;
    url)                cmd_url "${1:-}" ;;
    start|stop|restart) "cmd_$cmd" "${1:-all}" ;;
    status|st)          cmd_status ;;
    logs|log)
      if [ "${1:-}" = "rotate" ]; then shift; cmd_logs_rotate "$@"
      else cmd_logs "${1:-all}" "${2:-100}"; fi ;;
    tail|follow)        cmd_tail "${1:-all}" ;;
    edit)               cmd_edit "${1:-config}" ;;
    rebuild)            cmd_rebuild ;;
    dns)                cmd_dns "${1:-sync}" ;;
    update)             cmd_update "$@" ;;
    validate|check)     need_config; cmd_validate "${1:-all}" ;;
    cert|certs)         cmd_cert ;;
    doctor|dr)          cmd_doctor "$@" ;;
    prune)              cmd_prune "$@" ;;
    ip)                 local ip; ip="$(ts_ip)"; [ -n "$ip" ] || die "Tailscale isn't running"; echo "$ip" ;;
    domain)             need_config; echo "$VHOSTY_DOMAIN" ;;
    paths)              cmd_paths ;;
    uninstall)          cmd_uninstall ;;
    version|-v|--version) echo "vhosty $VHOSTY_VERSION" ;;
    help|-h|--help)     usage ;;
    *) die "Unknown command '$cmd'. Run: vhosty help" ;;
  esac
}

# Run as a command; sourced (as the tests do), only define the functions
if [ "${BASH_SOURCE[0]}" = "$0" ]; then main "$@"; fi
