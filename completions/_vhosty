#compdef vhosty
#
# zsh completion for vhosty. Add the folder to fpath before compinit:
#   fpath=(~/.vhosty/completions $fpath)

_vhosty_sites() {
  local config="${VHOSTY_DIR:-$HOME/.vhosty}/config" parked dir
  local -a sites
  [ -f "$config" ] || return 1
  parked="$(sed -n 's/^VHOSTY_PARKED="\(.*\)"$/\1/p' "$config")"
  for dir in ${(s.:.)parked}; do
    sites+=( "$dir"/*(/N:t:l) )
  done
  (( ${#sites} )) && _values 'site' $sites
}

_vhosty() {
  local -a cmds
  cmds=(
    'setup:First-time setup'
    'park:Serve every folder in a directory'
    'unpark:Stop serving a parked directory'
    'parked:List parked directories'
    'sites:List sites and their URLs'
    'open:Open a site in the browser'
    'url:Print and copy a site URL'
    'start:Start services'
    'stop:Stop services'
    'restart:Validate config and restart'
    'status:Service state and ports'
    'logs:Show recent logs'
    'tail:Follow logs live'
    'edit:Edit settings or the token'
    'rebuild:Regenerate the Caddyfile and restart'
    'dns:Point *.domain at this machine'
    'update:Re-download Caddy or PHP-FPM'
    'validate:Check the generated config'
    'cert:Show the wildcard certificate'
    'doctor:Check everything end to end'
    'ip:Tailscale IP'
    'domain:Configured domain'
    'paths:Where everything lives'
    'uninstall:Remove the services'
    'version:Show the version'
    'help:Show help'
  )

  if (( CURRENT == 2 )); then
    _describe 'command' cmds
    return
  fi

  case "${words[2]}" in
    start|stop|restart|logs|log|tail) _values 'service' caddy php-fpm ;;
    edit)          _values 'file' config env ;;
    validate)      _values 'config' caddy php-fpm ;;
    dns)           _values 'action' sync ;;
    update)        _values 'what' caddy php ;;
    park|unpark)   _files -/ ;;
    open|url)      _vhosty_sites ;;
    setup)         _arguments '--domain[Domain]:domain:' '--token[Cloudflare token]:token:' '--park[Folder to park]:folder:_files -/' '--no-php[Skip PHP-FPM]' '--yes[Accept defaults]' ;;
  esac
}

_vhosty "$@"
