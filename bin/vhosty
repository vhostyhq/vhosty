#!/usr/bin/env bash
#
# vhosty: Herd for your tailnet.
# Every folder becomes a private HTTPS site on your own domain,
# reachable from any device on your Tailscale network.
#
#   vhosty setup      first-time setup (domain, DNS, Caddy, PHP-FPM, services)
#   vhosty help       everything else
#
# https://github.com/vhostyhq/vhosty
#
# Runs on Linux (systemd user services) and macOS (launchd).
# Written for the bash that ships with macOS (3.2), so no bash 4+ features.

set -euo pipefail

VHOSTY_VERSION="0.2.0-dev"

# ---------------------------------------------------------------------------
# Platform and locations
# ---------------------------------------------------------------------------
if [ "$(uname -s)" = "Darwin" ]; then PLATFORM="macos"; else PLATFORM="linux"; fi
is_macos() { [ "$PLATFORM" = "macos" ]; }
is_linux() { [ "$PLATFORM" = "linux" ]; }

VHOSTY_USER="${SUDO_USER:-${USER:-$(id -un)}}"
if [ -n "${SUDO_USER:-}" ]; then
  VHOSTY_HOME_DIR="$(eval echo "~$SUDO_USER")"
else
  VHOSTY_HOME_DIR="${HOME:-$(eval echo "~$VHOSTY_USER")}"
fi
VHOSTY_DIR="${VHOSTY_DIR:-$VHOSTY_HOME_DIR/.vhosty}"

CONFIG_FILE="$VHOSTY_DIR/config"
SECRETS_FILE="$VHOSTY_DIR/.env"
PHP_INI="$VHOSTY_DIR/php.ini"
BIN_DIR="$VHOSTY_DIR/bin"
CADDY_BIN="$BIN_DIR/caddy"
CADDYFILE="$VHOSTY_DIR/Caddyfile"
PHP_CONF_DIR="$VHOSTY_DIR/php"
LOG_DIR="$VHOSTY_DIR/logs"
RUN_DIR="$VHOSTY_DIR/run"
CADDY_LOG="$LOG_DIR/caddy.log"

# macOS: launchd system daemons
DAEMON_DIR="${VHOSTY_DAEMON_DIR:-/Library/LaunchDaemons}"
LABEL_PREFIX="link.vhosty"
# Linux: systemd user units
UNIT_DIR="${XDG_CONFIG_HOME:-$VHOSTY_HOME_DIR/.config}/systemd/user"

if is_macos; then
  CADDY_CERTS="$VHOSTY_HOME_DIR/Library/Application Support/Caddy/certificates"
else
  CADDY_CERTS="${XDG_DATA_HOME:-$VHOSTY_HOME_DIR/.local/share}/caddy/certificates"
fi
CF_API="https://api.cloudflare.com/client/v4"
PHP_DOWNLOADS="https://dl.static-php.dev/static-php-cli/bulk"

# Defaults; ~/.vhosty/config overrides them
VHOSTY_DOMAIN=""
VHOSTY_PARKED=""          # colon-separated folders
VHOSTY_PHP="on"           # on | off
VHOSTY_PHP_DEFAULT=""     # e.g. 8.5; empty = newest installed
VHOSTY_SERVICES_DIR=""    # docker compose project for `vhosty services`
VHOSTY_FPM_PORT=""        # old setting (TCP); FPM now uses sockets in ~/.vhosty/run

FAILED=0

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------
if [ -t 1 ]; then
  B=$'\033[1m'; G=$'\033[32m'; R=$'\033[31m'; Y=$'\033[33m'; D=$'\033[2m'; N=$'\033[0m'
else
  B=""; G=""; R=""; Y=""; D=""; N=""
fi

ok()    { printf "  %s✓%s %s\n" "$G" "$N" "$*"; }
bad()   { printf "  %s✗%s %s\n" "$R" "$N" "$*"; FAILED=1; }
warn()  { printf "  %s!%s %s\n" "$Y" "$N" "$*"; }
info()  { printf "  %s%s%s\n" "$D" "$*" "$N"; }
step()  { printf "\n%s→ %s%s\n" "$B" "$*" "$N"; }
head_() { printf "\n%s%s%s\n" "$B" "$*" "$N"; }
die()   { printf "%serror:%s %s\n" "$R" "$N" "$*" >&2; exit 1; }

# Prompts read from the terminal, so they work even when stdin is a pipe.
# With no terminal at all (scripts, CI), they fall back to the default.
has_tty() { { : </dev/tty; } 2>/dev/null; }

ask() { # ask "Question" default -> echoes answer
  local q="$1" def="${2:-}" a=""
  if ! has_tty; then printf '%s' "$def"; return 0; fi
  if [ -n "$def" ]; then
    printf "%s [%s]: " "$q" "$def" >/dev/tty
  else
    printf "%s: " "$q" >/dev/tty
  fi
  IFS= read -r a </dev/tty || true
  [ -n "$a" ] || a="$def"
  printf '%s' "$a"
}

ask_secret() {
  local a=""
  has_tty || return 0
  printf "%s: " "$1" >/dev/tty
  IFS= read -rs a </dev/tty || true
  printf "\n" >/dev/tty
  printf '%s' "$a"
}

confirm() { # confirm "Question" [Y|N default]
  local def="${2:-Y}" a="" hint="[Y/n]"
  [ "$def" = "N" ] && hint="[y/N]"
  [ "${VHOSTY_YES:-}" = "1" ] && return 0
  if ! has_tty; then [ "$def" = "Y" ]; return; fi
  printf "%s %s " "$1" "$hint" >/dev/tty
  IFS= read -r a </dev/tty || true
  [ -n "$a" ] || a="$def"
  case "$a" in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
}

# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------
load_config() {
  if [ -f "$CONFIG_FILE" ]; then
    # shellcheck disable=SC1090
    . "$CONFIG_FILE"
  fi
}

need_config() {
  [ -f "$CONFIG_FILE" ] && [ -n "$VHOSTY_DOMAIN" ] || die "vhosty isn't set up yet. Run: vhosty setup"
}

save_config() {
  mkdir -p "$VHOSTY_DIR"
  cat >"$CONFIG_FILE" <<EOF
# vhosty config. After editing, run: vhosty rebuild
VHOSTY_DOMAIN="$VHOSTY_DOMAIN"
VHOSTY_PARKED="$VHOSTY_PARKED"
VHOSTY_PHP="$VHOSTY_PHP"
VHOSTY_PHP_DEFAULT="$VHOSTY_PHP_DEFAULT"
VHOSTY_SERVICES_DIR="$VHOSTY_SERVICES_DIR"
EOF
}

# A config copied from another machine: drop the old FPM port, and move
# parked folders from another home directory (/Users/me/Dev) to this one.
migrate_config() {
  local d new="" moved=""
  if [ -n "$VHOSTY_FPM_PORT" ]; then
    info "PHP-FPM now listens on sockets in $RUN_DIR; dropped VHOSTY_FPM_PORT=$VHOSTY_FPM_PORT"
    VHOSTY_FPM_PORT=""
  fi
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    if [ ! -d "$d" ]; then
      case "$d" in
        /Users/*/*|/home/*/*)
          moved="$VHOSTY_HOME_DIR/$(printf '%s' "$d" | cut -d/ -f4-)"
          if [ -d "$moved" ]; then info "parked folder $d → $moved"; d="$moved"; fi
          ;;
      esac
    fi
    case ":$new:" in *":$d:"*) ;; *) new="${new:+$new:}$d" ;; esac
  done <<EOF
$(parked_list)
EOF
  VHOSTY_PARKED="$new"
}

load_token() {
  CF_API_TOKEN="${CF_API_TOKEN:-}"
  local f
  # Second path: the hand-built layout (~/.vhosty/caddy/.env) from before `vhosty setup`
  for f in "$SECRETS_FILE" "$VHOSTY_DIR/caddy/.env"; do
    if [ -z "$CF_API_TOKEN" ] && [ -f "$f" ]; then
      CF_API_TOKEN="$(sed -n 's/^CF_API_TOKEN=//p' "$f" | head -1)"
    fi
  done
}

save_token() {
  mkdir -p "$VHOSTY_DIR"
  ( umask 077; printf 'CF_API_TOKEN=%s\n' "$1" >"$SECRETS_FILE" )
  chmod 600 "$SECRETS_FILE"
}

php_enabled() { [ "$VHOSTY_PHP" = "on" ]; }

# Number of labels in the domain = which {labels.N} holds the site name.
# vhosty.link → 2, box.example.com → 3
domain_depth() { printf '%s' "$VHOSTY_DOMAIN" | awk -F. '{print NF}'; }

parked_list() { printf '%s\n' "$VHOSTY_PARKED" | tr ':' '\n' | sed '/^$/d'; }

# ---------------------------------------------------------------------------
# System helpers
# ---------------------------------------------------------------------------
arch_name() { # caddy-style arch name
  case "$(uname -m)" in
    x86_64|amd64) echo amd64 ;;
    arm64|aarch64) echo arm64 ;;
    *) die "Unsupported CPU: $(uname -m)" ;;
  esac
}

tailscale_bin() {
  if command -v tailscale >/dev/null 2>&1; then
    echo tailscale
  elif [ -x /Applications/Tailscale.app/Contents/MacOS/Tailscale ]; then
    echo /Applications/Tailscale.app/Contents/MacOS/Tailscale
  fi
}

ts_ip() {
  local t
  t="$(tailscale_bin)"
  if [ -n "$t" ]; then "$t" ip -4 2>/dev/null | head -1 || true; fi
}

is_tailscale_ip() { # 100.64.0.0/10
  local second
  case "$1" in 100.*) ;; *) return 1 ;; esac
  second="$(printf '%s' "$1" | cut -d. -f2)"
  [ "$second" -ge 64 ] 2>/dev/null && [ "$second" -le 127 ]
}

# Name of the process listening on a TCP port, "?" if it belongs to another user
port_owner() {
  if is_macos; then
    lsof -nP -iTCP:"$1" -sTCP:LISTEN 2>/dev/null | awk 'NR>1 {print $1}' | sort -u | tr '\n' ' ' | sed 's/ $//' || true
  else
    ss -ltnpH "( sport = :$1 )" 2>/dev/null | awk '{
      if (match($0, /users:\(\("[^"]+"/)) { s = substr($0, RSTART + 9, RLENGTH - 10); print s } else print "?"
    }' | sort -u | tr '\n' ' ' | sed 's/ $//' \
      | { IFS= read -r o || true
          # Caddy's port capability hides its sockets from ss; "?" is ours if it's running
          if [ "$o" = "?" ] && [ -f "$UNIT_DIR/vhosty-caddy.service" ] && [ "$(svc_state caddy)" = "running" ]; then o="caddy"; fi
          printf '%s' "$o"; } || true
  fi
}

# Read one value out of JSON. Path uses dots: result.0.id
json_get() {
  local path="$1" input
  input="$(cat)"
  if command -v jq >/dev/null 2>&1; then
    printf '%s' "$input" | jq -r ".$(printf '%s' "$path" | sed -E 's/\.([0-9]+)/[\1]/g') | if . == null then empty else . end" 2>/dev/null
  elif command -v plutil >/dev/null 2>&1; then
    printf '%s' "$input" | plutil -extract "$path" raw -o - - 2>/dev/null || true
  else
    die "Need jq to read API responses (sudo apt install jq)"
  fi
}

download() { # download URL DEST
  if [ -t 2 ]; then curl -fSL --progress-bar --retry 2 -o "$2" "$1"
  else curl -fsSL --retry 2 -o "$2" "$1"; fi
}

open_url() {
  if is_macos; then open "$1"
  elif { [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; } && command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$1" >/dev/null 2>&1 &
  else
    return 1
  fi
}

copy_text() {
  if command -v pbcopy >/dev/null 2>&1; then printf %s "$1" | pbcopy
  elif [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-copy >/dev/null 2>&1; then printf %s "$1" | wl-copy
  elif [ -n "${DISPLAY:-}" ] && command -v xclip >/dev/null 2>&1; then printf %s "$1" | xclip -selection clipboard
  else return 1
  fi
}

# ---------------------------------------------------------------------------
# Cloudflare
# ---------------------------------------------------------------------------
cf() { # cf METHOD PATH [JSON]
  local method="$1" path="$2" body="${3:-}"
  if [ -n "$body" ]; then
    curl -sS -X "$method" "$CF_API/$path" \
      -H "Authorization: Bearer $CF_API_TOKEN" -H "Content-Type: application/json" \
      --data "$body"
  else
    curl -sS -X "$method" "$CF_API/$path" -H "Authorization: Bearer $CF_API_TOKEN"
  fi
}

cf_ok() { [ "$(printf '%s' "$1" | json_get success)" = "true" ]; }

cf_error() { printf '%s' "$1" | json_get errors.0.message; }

cf_verify_token() {
  local r
  r="$(cf GET user/tokens/verify)" || return 1
  cf_ok "$r"
}

# Finds the Cloudflare zone for the domain: vhosty.link, or example.com for box.example.com
cf_zone_id() {
  local candidate="$VHOSTY_DOMAIN" r id
  while [ "$(printf '%s' "$candidate" | awk -F. '{print NF}')" -ge 2 ]; do
    r="$(cf GET "zones?name=$candidate")"
    id="$(printf '%s' "$r" | json_get result.0.id)"
    if [ -n "$id" ]; then
      echo "$id"
      return 0
    fi
    candidate="${candidate#*.}"
  done
  return 1
}

# Creates or updates the *.domain A record → this machine's Tailscale IP, DNS only
dns_sync() {
  local ip zone name r rid current proxied body
  ip="$(ts_ip)"
  [ -n "$ip" ] || die "Couldn't get this machine's Tailscale IP. Is Tailscale running?"
  load_token
  [ -n "$CF_API_TOKEN" ] || die "No Cloudflare token. Run: vhosty setup"

  zone="$(cf_zone_id)" || die "No Cloudflare zone found for $VHOSTY_DOMAIN. Is the domain added to Cloudflare, and does the token have Zone → Read?"
  name="*.$VHOSTY_DOMAIN"
  body="{\"type\":\"A\",\"name\":\"$name\",\"content\":\"$ip\",\"ttl\":1,\"proxied\":false,\"comment\":\"vhosty\"}"

  r="$(cf GET "zones/$zone/dns_records?type=A&name=%2A.$VHOSTY_DOMAIN")"
  rid="$(printf '%s' "$r" | json_get result.0.id)"

  if [ -z "$rid" ]; then
    r="$(cf POST "zones/$zone/dns_records" "$body")"
    cf_ok "$r" || die "Couldn't create $name: $(cf_error "$r")"
    ok "created $name → $ip (DNS only)"
    return 0
  fi

  current="$(printf '%s' "$r" | json_get result.0.content)"
  proxied="$(printf '%s' "$r" | json_get result.0.proxied)"
  if [ "$current" = "$ip" ] && [ "$proxied" = "false" ]; then
    ok "$name → $ip (already correct)"
    return 0
  fi

  if ! is_tailscale_ip "$current"; then
    warn "$name currently points to $current, which isn't a Tailscale address."
    if [ "$(domain_depth)" -eq 2 ]; then
      warn "Something else (a staging server?) may rely on it. Consider a subdomain instead, like box.$VHOSTY_DOMAIN."
    else
      warn "Something else (a staging server?) may rely on it. Consider a different subdomain for vhosty."
    fi
    confirm "Point $name at this machine anyway?" N || die "Left $name unchanged."
  fi

  r="$(cf PUT "zones/$zone/dns_records/$rid" "$body")"
  cf_ok "$r" || die "Couldn't update $name: $(cf_error "$r")"
  if [ "$proxied" = "true" ]; then
    ok "updated $name → $ip and turned off Cloudflare's proxy (it causes 525 errors)"
  else
    ok "updated $name → $ip"
  fi
}

# ---------------------------------------------------------------------------
# Caddy
# ---------------------------------------------------------------------------
# Lets Caddy bind 80/443 as a normal user. Replacing the binary drops it, so
# this runs again after every download.
caddy_allow_ports() {
  is_linux || return 0
  if getcap "$CADDY_BIN" 2>/dev/null | grep -q cap_net_bind_service; then return 0; fi
  info "letting Caddy use ports 80 and 443 without root (asks for your password)"
  sudo setcap cap_net_bind_service=+ep "$CADDY_BIN" || die "setcap failed"
}

install_caddy() {
  local os arch url tmp
  os="darwin"; is_macos || os="linux"
  arch="$(arch_name)"
  url="https://caddyserver.com/api/download?os=$os&arch=$arch&p=github.com%2Fcaddy-dns%2Fcloudflare"
  mkdir -p "$BIN_DIR"
  tmp="$(mktemp)"
  info "downloading Caddy with the Cloudflare DNS plugin ($os/$arch)"
  download "$url" "$tmp" || die "Caddy download failed"
  chmod 755 "$tmp"
  if is_macos; then xattr -d com.apple.quarantine "$tmp" 2>/dev/null || true; fi
  "$tmp" list-modules 2>/dev/null | grep -q dns.providers.cloudflare \
    || die "Downloaded Caddy is missing the Cloudflare plugin, or doesn't run on this system"
  mv "$tmp" "$CADDY_BIN"
  caddy_allow_ports
  ok "Caddy $("$CADDY_BIN" version | awk '{print $1}')"
}

caddy_installed() { [ -x "$CADDY_BIN" ] && "$CADDY_BIN" list-modules 2>/dev/null | grep -q dns.providers.cloudflare; }

# ---------------------------------------------------------------------------
# PHP versions
#   Linux: apt packages (phpX.Y-fpm), side by side
#   macOS: static PHP-FPM builds in ~/.vhosty/bin/php-fpm-X.Y
# ---------------------------------------------------------------------------
fpm_bin() { if is_macos; then echo "$BIN_DIR/php-fpm-$1"; else echo "/usr/sbin/php-fpm$1"; fi; }
fpm_conf() { echo "$PHP_CONF_DIR/$1/php-fpm.conf"; }
fpm_sock() { echo "$RUN_DIR/php-$1.sock"; }
fpm_log() { echo "$LOG_DIR/php-$1.log"; }

php_installed_versions() { # newest first
  local f
  {
    if is_macos; then
      for f in "$BIN_DIR"/php-fpm-*; do [ -x "$f" ] && echo "${f##*/php-fpm-}"; done
    else
      for f in /usr/sbin/php-fpm[0-9]*; do [ -x "$f" ] && echo "${f#/usr/sbin/php-fpm}"; done
    fi
  } | grep -E '^[0-9]+\.[0-9]+$' | sort -t. -k1,1nr -k2,2nr || true
}

php_is_installed() { [ -x "$(fpm_bin "$1")" ]; }

php_default() {
  if [ -n "$VHOSTY_PHP_DEFAULT" ]; then echo "$VHOSTY_PHP_DEFAULT"; else php_installed_versions | head -1; fi
}

# Versions that need a running FPM
php_versions_in_use() {
  php_enabled || return 0
  php_default
}

# PHP on PATH outside vhosty's shim, for picking a default on first setup
php_cli_minor() {
  local p
  for p in /usr/bin/php /usr/local/bin/php "$(command -v php 2>/dev/null || true)"; do
    [ -x "$p" ] || continue
    "$p" -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;' 2>/dev/null && return 0
  done
  return 0
}

# macOS: picks the newest static PHP-FPM build for a minor version (8.5 → php-8.5.x)
php_fpm_file() {
  local minor="$1" arch listing
  case "$(arch_name)" in amd64) arch="x86_64" ;; arm64) arch="aarch64" ;; esac
  listing="$(curl -fsSL "$PHP_DOWNLOADS/")" || die "Couldn't reach $PHP_DOWNLOADS"
  printf '%s' "$listing" \
    | grep -oE "php-$(printf '%s' "$minor" | sed 's/\./\\./')\.[0-9]+-fpm-macos-${arch}\.tar\.gz" \
    | sort -u | awk -F- '{split($2,v,"."); printf "%d %s\n", v[3], $0}' \
    | sort -n | tail -1 | cut -d' ' -f2
}

install_php_fpm() { # install_php_fpm 8.5
  local minor="${1:-}" file tmp found
  [ -n "$minor" ] || minor="$(php_cli_minor)"
  [ -n "$minor" ] || minor="8.5"
  if is_linux; then
    php_is_installed "$minor" && { ok "PHP $minor ($("$(fpm_bin "$minor")" -v 2>/dev/null | head -1 | awk '{print $2}'))"; return 0; }
    die "PHP $minor isn't installed. Install it with apt (e.g. sudo apt install php$minor-fpm php$minor-cli)."
  fi
  file="$(php_fpm_file "$minor")"
  [ -n "$file" ] || die "No PHP $minor FPM build for this Mac at $PHP_DOWNLOADS. Try: vhosty update php <version>"
  info "downloading $file"
  tmp="$(mktemp -d)"
  download "$PHP_DOWNLOADS/$file" "$tmp/php.tar.gz" || die "PHP-FPM download failed"
  tar -xzf "$tmp/php.tar.gz" -C "$tmp"
  found="$(find "$tmp" -type f -name php-fpm | head -1)"
  [ -n "$found" ] || die "$file didn't contain a php-fpm binary"
  mkdir -p "$BIN_DIR"
  chmod +x "$found"
  xattr -d com.apple.quarantine "$found" 2>/dev/null || true
  mv "$found" "$(fpm_bin "$minor")"
  rm -rf "$tmp"
  ok "$("$(fpm_bin "$minor")" -v 2>/dev/null | head -1)"
}

# vhosty 0.1 on macOS kept one build at bin/php-fpm. Give it a versioned name.
migrate_php_fpm() {
  local v
  is_macos && [ -x "$BIN_DIR/php-fpm" ] || return 0
  v="$("$BIN_DIR/php-fpm" -v 2>/dev/null | head -1 | awk '{print $2}' | cut -d. -f1,2)"
  [ -n "$v" ] || return 0
  [ -e "$(fpm_bin "$v")" ] || mv "$BIN_DIR/php-fpm" "$(fpm_bin "$v")"
}

# ---------------------------------------------------------------------------
# php.ini: key = value lines for every PHP version (web and CLI)
# ---------------------------------------------------------------------------
write_default_php_ini() {
  [ -f "$PHP_INI" ] && return 0
  cat >"$PHP_INI" <<'EOF'
; vhosty: PHP settings for every site and every PHP version (web and CLI).
; They apply on top of the distro's php.ini. After editing, run: vhosty rebuild
memory_limit = 512M
upload_max_filesize = 128M
post_max_size = 128M
EOF
}

# Prints key=value pairs from an ini file (comments, sections and blanks dropped)
ini_pairs() {
  [ -f "$1" ] || return 0
  sed -e 's/^[[:space:]]*//' -e '/^[;#[]/d' -e 's/[[:space:]]*$//' "$1" \
    | grep '=' | sed -E 's/^([^=[:space:]]+)[[:space:]]*=[[:space:]]*/\1=/' || true
}

# ---------------------------------------------------------------------------
# Generated config
# ---------------------------------------------------------------------------
write_caddyfile() {
  local depth i=0 dir v ip bind
  depth="$(domain_depth)"
  v="$(php_default)"
  # Listen on the Tailscale address (and localhost) only, not the LAN
  ip="$(ts_ip)"
  bind="127.0.0.1 ::1"; [ -z "$ip" ] || bind="$ip $bind"
  {
    cat <<EOF
# Generated by vhosty. Don't edit: change ~/.vhosty/config, then run \`vhosty rebuild\`.
{
	default_bind $bind
}

*.$VHOSTY_DOMAIN {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	# Ports: 5173.$VHOSTY_DOMAIN → localhost:5173 (Vite and other dev servers)
	@port header_regexp port Host ^(\d+)\.
	handle @port {
		reverse_proxy localhost:{re.port.1}
	}
EOF
    while IFS= read -r dir; do
      [ -n "$dir" ] || continue
      if php_enabled && [ -n "$v" ]; then
        cat <<EOF

	# Parked: $dir (PHP $v, e.g. Laravel)
	@php$i file {
		root "$dir/{labels.$depth}/public"
		try_files index.php
	}
	handle @php$i {
		root * "$dir/{labels.$depth}/public"
		php_fastcgi unix/$(fpm_sock "$v")
		file_server
	}
EOF
      fi
      cat <<EOF

	# Parked: $dir (static: index.html at the folder root)
	@static$i file {
		root "$dir/{labels.$depth}"
		try_files index.html
	}
	handle @static$i {
		root * "$dir/{labels.$depth}"
		file_server
	}
EOF
      i=$((i + 1))
    done <<EOF
$(parked_list)
EOF
    cat <<EOF

	handle {
		respond "vhosty: no site found for {host}" 404
	}
}
EOF
  } >"$CADDYFILE"
}

write_fpm_conf() { # write_fpm_conf 8.5
  local v="$1" kv
  mkdir -p "$PHP_CONF_DIR/$v" "$LOG_DIR" "$RUN_DIR"
  {
    cat <<EOF
; Generated by vhosty. Change ~/.vhosty/config or ~/.vhosty/php.ini, then run \`vhosty rebuild\`.
[global]
pid = $RUN_DIR/php-$v.pid
error_log = $(fpm_log "$v")
daemonize = no

[default]
listen = $(fpm_sock "$v")
listen.mode = 0600
pm = dynamic
pm.max_children = 10
pm.start_servers = 2
pm.min_spare_servers = 1
pm.max_spare_servers = 4
catch_workers_output = yes
clear_env = no
EOF
    ini_pairs "$PHP_INI" | while IFS= read -r kv; do
      printf 'php_value[%s] = %s\n' "${kv%%=*}" "${kv#*=}"
    done
  } >"$(fpm_conf "$v")"
}

write_configs() {
  local v
  write_caddyfile
  for v in $(php_versions_in_use); do write_fpm_conf "$v"; done
}

# ---------------------------------------------------------------------------
# Services
#   Names: caddy, php-8.5, php-8.4, ...
#   Linux: systemd user units (vhosty-caddy, vhosty-php@8.5), no sudo needed
#   macOS: launchd daemons (link.vhosty.caddy, link.vhosty.php-8.5)
# ---------------------------------------------------------------------------
svc_all() { # PHP first, so Caddy starts with its upstreams ready
  local v
  for v in $(php_versions_in_use); do printf 'php-%s\n' "$v"; done
  echo caddy
}

# Turns a user argument (caddy, php, php-8.5, php@8.5, 8.5, all) into service names
svc_resolve() {
  local a="${1:-all}" v
  case "$a" in
    all) svc_all ;;
    caddy) echo caddy ;;
    php|php-fpm|fpm)
      php_enabled || die "PHP is turned off in ~/.vhosty/config"
      for v in $(php_versions_in_use); do echo "php-$v"; done ;;
    php-[0-9]*|php@[0-9]*|[0-9]*.[0-9]*)
      v="${a#php}"; v="${v#[-@]}"
      php_is_installed "$v" || die "PHP $v isn't installed"
      echo "php-$v" ;;
    *) die "Unknown service '$a' (use caddy, php, php-8.x, or all)" ;;
  esac
}

svc_log() { case "$1" in caddy) echo "$CADDY_LOG" ;; php-*) fpm_log "${1#php-}" ;; esac; }

svc_cmd() { # the command line that runs a service
  case "$1" in
    caddy) printf '%s\n' "$CADDY_BIN" run --config "$CADDYFILE" --adapter caddyfile --envfile "$SECRETS_FILE" ;;
    php-*) printf '%s\n' "$(fpm_bin "${1#php-}")" --nodaemonize --fpm-config "$(fpm_conf "${1#php-}")" ;;
  esac
}

# --- Linux: systemd user units ---------------------------------------------
sd() { systemctl --user "$@"; }
unit_of() { case "$1" in caddy) echo vhosty-caddy.service ;; php-*) echo "vhosty-php@${1#php-}.service" ;; esac; }

write_units() {
  mkdir -p "$UNIT_DIR" "$LOG_DIR" "$RUN_DIR"
  cat >"$UNIT_DIR/vhosty-caddy.service" <<EOF
# Generated by vhosty
[Unit]
Description=vhosty: Caddy for *.$VHOSTY_DOMAIN

[Service]
Type=notify
EnvironmentFile=$SECRETS_FILE
ExecStart=$CADDY_BIN run --config $CADDYFILE --adapter caddyfile
ExecReload=$CADDY_BIN reload --config $CADDYFILE --adapter caddyfile --force
Restart=on-failure
RestartSec=3
StandardOutput=append:$CADDY_LOG
StandardError=append:$CADDY_LOG

[Install]
WantedBy=default.target
EOF
  cat >"$UNIT_DIR/vhosty-php@.service" <<EOF
# Generated by vhosty. One instance per PHP version: vhosty-php@8.5
[Unit]
Description=vhosty: PHP %i FPM

[Service]
Type=notify
ExecStart=/usr/sbin/php-fpm%i --nodaemonize --fpm-config $PHP_CONF_DIR/%i/php-fpm.conf
ExecReload=/bin/kill -USR2 \$MAINPID
Restart=on-failure
RestartSec=3
StandardOutput=append:$LOG_DIR/php-%i.log
StandardError=append:$LOG_DIR/php-%i.log

[Install]
WantedBy=default.target
EOF
  sd daemon-reload
}

# Units that exist for PHP versions vhosty no longer uses
sd_stale_php() {
  local u v keep
  keep=" $(php_versions_in_use | tr '\n' ' ') "
  sd list-units 'vhosty-php@*' --all --plain --no-legend 2>/dev/null | awk '{print $1}' | while IFS= read -r u; do
    v="${u#vhosty-php@}"; v="${v%.service}"
    case "$keep" in *" $v "*) ;; *) echo "$u" ;; esac
  done
  { ls "$UNIT_DIR/default.target.wants" 2>/dev/null || true; } | grep '^vhosty-php@' | while IFS= read -r u; do
    v="${u#vhosty-php@}"; v="${v%.service}"
    case "$keep" in *" $v "*) ;; *) echo "$u" ;; esac
  done || true
}

ensure_linger() {
  [ "$(loginctl show-user "$VHOSTY_USER" -p Linger --value 2>/dev/null)" = "yes" ] && return 0
  info "letting your services run at boot, without logging in (asks for your password)"
  sudo loginctl enable-linger "$VHOSTY_USER" || die "loginctl enable-linger failed"
}

# --- macOS: launchd ---------------------------------------------------------
label_of() { echo "$LABEL_PREFIX.$1"; }
plist_for() { echo "$DAEMON_DIR/$(label_of "$1").plist"; }
is_loaded() { sudo launchctl print "system/$(label_of "$1")" >/dev/null 2>&1; }

launchd_field() {
  sudo launchctl print "system/$(label_of "$1")" 2>/dev/null \
    | awk -F'= ' -v key="$2" '$0 ~ "^\t" key " = " {print $2; exit}' || true
}

write_plist() { # write_plist NAME
  local name="$1" args="" a dest
  while IFS= read -r a; do
    args="$args    <string>$a</string>
"
  done <<EOF
$(svc_cmd "$name")
EOF
  dest="$(plist_for "$name")"
  sudo tee "$dest" >/dev/null <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$(label_of "$name")</string>
  <key>UserName</key><string>$VHOSTY_USER</string>
  <key>WorkingDirectory</key><string>$VHOSTY_DIR</string>
  <key>ProgramArguments</key>
  <array>
$args  </array>
  <key>EnvironmentVariables</key>
  <dict><key>HOME</key><string>$VHOSTY_HOME_DIR</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>$(svc_log "$name")</string>
  <key>StandardErrorPath</key><string>$(svc_log "$name")</string>
</dict>
</plist>
EOF
  sudo chown root:wheel "$dest"
  sudo chmod 644 "$dest"
}

# Daemons for services vhosty no longer runs, including 0.1's link.vhosty.php-fpm
launchd_stale() {
  local f name keep
  keep=" $(svc_all | tr '\n' ' ') "
  for f in "$DAEMON_DIR/$LABEL_PREFIX".*.plist; do
    [ -f "$f" ] || continue
    name="${f##*/$LABEL_PREFIX.}"; name="${name%.plist}"
    case "$keep" in *" $name "*) ;; *) echo "$name" ;; esac
  done
}

# --- Common ------------------------------------------------------------------
svc_installed() {
  if is_linux; then [ -f "$UNIT_DIR/vhosty-caddy.service" ]; else [ -f "$(plist_for caddy)" ]; fi
}

svc_state() { # running | stopped | failed | ...
  local s
  if is_linux; then
    s="$(sd show -p ActiveState --value "$(unit_of "$1")" 2>/dev/null || true)"
    case "$s" in active|reloading) echo running ;; inactive|"") echo stopped ;; *) echo "$s" ;; esac
  else
    s="$(launchd_field "$1" state)"
    echo "${s:-stopped}"
  fi
}

svc_pid() {
  if is_linux; then sd show -p MainPID --value "$(unit_of "$1")" 2>/dev/null || true
  else launchd_field "$1" pid; fi
}

svc_start() {
  if is_linux; then sd enable --now --quiet "$(unit_of "$1")"
  elif is_loaded "$1"; then sudo launchctl kickstart "system/$(label_of "$1")"
  else sudo launchctl bootstrap system "$(plist_for "$1")"; fi
}

svc_stop() {
  if is_linux; then sd stop "$(unit_of "$1")"
  elif is_loaded "$1"; then sudo launchctl bootout "system/$(label_of "$1")" 2>/dev/null || true; fi
}

svc_restart() {
  if is_linux; then sd enable --quiet "$(unit_of "$1")"; sd restart "$(unit_of "$1")"
  elif is_loaded "$1"; then sudo launchctl kickstart -k "system/$(label_of "$1")"
  else sudo launchctl bootstrap system "$(plist_for "$1")"; fi
}

# Graceful where the platform allows: Caddy keeps connections, FPM finishes requests
svc_reload() {
  if is_linux; then sd enable --quiet "$(unit_of "$1")"; sd reload-or-restart "$(unit_of "$1")"
  else svc_restart "$1"; fi
}

svc_remove() {
  if is_linux; then
    sd disable --now --quiet "$1" 2>/dev/null || true
  else
    if is_loaded "$1"; then sudo launchctl bootout "system/$(label_of "$1")" 2>/dev/null || true; fi
    sudo rm -f "$(plist_for "$1")"
  fi
}

# Installs or refreshes every service definition, starts what's needed and
# removes what isn't. Used by setup and rebuild.
svc_sync() {
  local s
  mkdir -p "$LOG_DIR" "$RUN_DIR"
  if is_linux; then
    write_units
    for s in $(sd_stale_php | sort -u); do svc_remove "$s"; ok "stopped $s (no longer used)"; done
  else
    sudo -v
    for s in $(launchd_stale); do svc_remove "$s"; ok "removed $(label_of "$s") (no longer used)"; done
    for s in $(svc_all); do
      if is_loaded "$s"; then sudo launchctl bootout "system/$(label_of "$s")" 2>/dev/null || true; fi
      write_plist "$s"
    done
    sleep 1
  fi
}

# Starts what isn't running, reloads what is
svc_apply() {
  local s
  for s in $(svc_all); do
    if [ "$(svc_state "$s")" = "running" ]; then svc_reload "$s"; ok "reloaded $s"
    else svc_start "$s"; ok "started $s"; fi
  done
}

# ---------------------------------------------------------------------------
# Commands: setup
# ---------------------------------------------------------------------------
cmd_setup() {
  local domain="" token="" park="" php="" yes=0 ip o v
  while [ $# -gt 0 ]; do
    case "$1" in
      --domain) domain="$2"; shift 2 ;;
      --token)  token="$2"; shift 2 ;;
      --park)   park="$2"; shift 2 ;;
      --no-php) php="off"; shift ;;
      --php)    php="on"; shift ;;
      -y|--yes) yes=1; shift ;;
      *) die "Unknown option '$1'. Usage: vhosty setup [--domain D] [--token T] [--park DIR] [--no-php] [--yes]" ;;
    esac
  done
  [ "$yes" = "1" ] && export VHOSTY_YES=1

  load_config

  printf "%svhosty setup%s (%s)\n" "$B" "$N" "$PLATFORM"

  step "Checking this machine"
  ip="$(ts_ip)"
  [ -n "$ip" ] || die "Tailscale isn't running, or its CLI wasn't found. Install and sign in first: https://tailscale.com/download"
  ok "Tailscale IP: $ip"
  if is_linux; then
    command -v jq >/dev/null 2>&1 || die "vhosty needs jq: sudo apt install jq"
    command -v systemctl >/dev/null 2>&1 || die "vhosty on Linux needs systemd"
  fi
  o="$(port_owner 443)"
  if [ -n "$o" ] && [ "$o" != "caddy" ]; then
    warn "port 443 is in use by: $o"
    warn "Herd, Valet, nginx and Apache use 443. Stop them, or vhosty's Caddy can't start."
    confirm "Continue anyway?" N || exit 1
  fi
  migrate_config
  migrate_php_fpm

  step "Domain"
  info "A domain whose DNS is on Cloudflare. vhosty points *.domain at this machine."
  info "Already using the domain's wildcard for something else? Use a subdomain, like box.example.com."
  [ -n "$domain" ] || domain="$(ask "Domain" "$VHOSTY_DOMAIN")"
  domain="$(printf '%s' "$domain" | tr '[:upper:]' '[:lower:]' | sed -E 's#^https?://##; s#^\*\.##; s#/.*$##')"
  printf '%s' "$domain" | grep -qE '^[a-z0-9-]+(\.[a-z0-9-]+)+$' || die "'$domain' doesn't look like a domain"
  VHOSTY_DOMAIN="$domain"

  step "Cloudflare API token"
  load_token
  if [ -n "$token" ]; then
    CF_API_TOKEN="$token"
  elif [ -n "$CF_API_TOKEN" ] && confirm "Use the saved token?" Y; then
    :
  else
    info "Create one at dash.cloudflare.com → My Profile → API Tokens → 'Edit zone DNS'."
    info "It needs Zone → Read and DNS → Edit for $VHOSTY_DOMAIN."
    CF_API_TOKEN="$(ask_secret "Token")"
  fi
  [ -n "$CF_API_TOKEN" ] || die "A token is required"
  cf_verify_token || die "Cloudflare rejected that token"
  save_token "$CF_API_TOKEN"
  ok "token is valid (saved to $SECRETS_FILE, readable only by you)"

  step "Parked folders"
  info "Each folder inside becomes https://<folder>.$VHOSTY_DOMAIN"
  [ -n "$park" ] || park="$(ask "Folder to park" "$(parked_list | head -1 | grep . || echo "$VHOSTY_HOME_DIR/Sites")")"
  park="$(eval echo "$park")"
  [ -d "$park" ] || { mkdir -p "$park"; ok "created $park"; }
  park="$(cd "$park" && pwd)"
  case ":$VHOSTY_PARKED:" in
    *":$park:"*) ;;
    *) VHOSTY_PARKED="${VHOSTY_PARKED:+$VHOSTY_PARKED:}$park" ;;
  esac
  parked_list | while IFS= read -r o; do ok "parked $o"; done

  step "PHP"
  if [ -z "$php" ]; then
    if confirm "Serve PHP sites (Laravel etc.) with PHP-FPM?" Y; then php="on"; else php="off"; fi
  fi
  VHOSTY_PHP="$php"
  if php_enabled; then
    v="$(php_default)"
    [ -n "$v" ] || v="$(php_cli_minor)"
    php_is_installed "${v:-none}" || install_php_fpm "$v"
    v="$(php_default)"
    [ -n "$v" ] || die "No PHP-FPM found"
    VHOSTY_PHP_DEFAULT="$v"
    ok "default PHP: $v ($(php_installed_versions | tr '\n' ' ' | sed 's/ $//') installed)"
    write_default_php_ini
    info "PHP settings for every site: $PHP_INI"
  fi
  save_config

  step "Caddy"
  if caddy_installed; then
    caddy_allow_ports
    ok "Caddy already installed ($("$CADDY_BIN" version | awk '{print $1}'))"
  else
    install_caddy
  fi

  step "DNS"
  dns_sync

  step "Config"
  write_configs
  cmd_validate >/dev/null || { cmd_validate || true; die "Generated config didn't validate"; }
  ok "wrote $CADDYFILE"

  if is_linux; then
    step "Services (systemd, as $VHOSTY_USER)"
    ensure_linger
  else
    step "Services (asks for your password)"
  fi
  svc_sync
  svc_apply

  step "Waiting for the certificate"
  local n=0
  while [ $n -lt 45 ]; do
    if find "$CADDY_CERTS" -name "wildcard_.$VHOSTY_DOMAIN.crt" 2>/dev/null | grep -q .; then
      ok "got a certificate for *.$VHOSTY_DOMAIN"
      break
    fi
    sleep 2; n=$((n + 1))
  done
  [ $n -lt 45 ] || warn "no certificate yet. Check: vhosty logs caddy"

  printf "\n%sDone.%s Folders in %s are live at https://<folder>.%s\n" "$G" "$N" "$park" "$VHOSTY_DOMAIN"
  printf "Dev servers on a port are at https://<port>.%s (e.g. 5173 for Vite).\n" "$VHOSTY_DOMAIN"
  printf "Run %svhosty doctor%s any time to check everything.\n" "$B" "$N"
}

# ---------------------------------------------------------------------------
# Commands: parked folders
# ---------------------------------------------------------------------------
cmd_park() {
  need_config
  local dir="${1:-$PWD}"
  dir="$(cd "$dir" 2>/dev/null && pwd)" || die "No such folder: ${1:-$PWD}"
  case ":$VHOSTY_PARKED:" in
    *":$dir:"*) warn "$dir is already parked"; return 0 ;;
  esac
  VHOSTY_PARKED="${VHOSTY_PARKED:+$VHOSTY_PARKED:}$dir"
  save_config
  ok "parked $dir"
  cmd_rebuild
}

cmd_unpark() {
  need_config
  local dir="${1:-$PWD}" new="" d
  dir="$(cd "$dir" 2>/dev/null && pwd || echo "$dir")"
  case ":$VHOSTY_PARKED:" in
    *":$dir:"*) ;;
    *) die "$dir isn't parked. Run: vhosty parked" ;;
  esac
  while IFS= read -r d; do
    [ "$d" = "$dir" ] || new="${new:+$new:}$d"
  done <<EOF
$(parked_list)
EOF
  VHOSTY_PARKED="$new"
  save_config
  ok "unparked $dir"
  cmd_rebuild
}

cmd_parked() {
  need_config
  [ -n "$VHOSTY_PARKED" ] || { info "Nothing parked. Run: vhosty park <folder>"; return 0; }
  parked_list | sed 's/^/  /'
}

cmd_rebuild() {
  need_config
  write_configs
  ok "regenerated config"
  if svc_installed; then
    cmd_validate >/dev/null || { cmd_validate || true; die "Not applying. Fix the errors above."; }
    svc_sync
    svc_apply
  fi
}

# ---------------------------------------------------------------------------
# Commands: services
# ---------------------------------------------------------------------------
need_installed() {
  svc_installed || die "Services aren't installed. Run: vhosty setup"
}

cmd_start() {
  need_config; need_installed
  local s
  for s in $(svc_resolve "${1:-all}"); do svc_start "$s"; ok "started $s"; done
}

cmd_stop() {
  need_config
  local s
  for s in $(svc_resolve "${1:-all}"); do
    if [ "$(svc_state "$s")" = "running" ]; then svc_stop "$s"; ok "stopped $s"
    else warn "$s isn't running"; fi
  done
}

cmd_restart() {
  need_config; need_installed
  local s
  cmd_validate >/dev/null || { cmd_validate || true; die "Not restarting. Fix the errors above."; }
  for s in $(svc_resolve "${1:-all}"); do svc_restart "$s"; ok "restarted $s"; done
}

cmd_status() {
  need_config
  is_macos && sudo -v
  local ip s st p o v
  ip="$(ts_ip)"
  printf "%svhosty%s  *.%s  →  %s\n" "$B" "$N" "$VHOSTY_DOMAIN" "${ip:-tailscale not running}"
  head_ "Services"
  for s in $(svc_all); do
    st="$(svc_state "$s")"
    p="$(svc_pid "$s")"
    if [ "$st" = "running" ]; then ok "$s running (pid $p)"
    else bad "$s $st (run: vhosty start, or see: vhosty logs $s)"; fi
  done
  head_ "Listening"
  o="$(port_owner 443)"; if [ -n "$o" ]; then ok "443 → $o"; else bad "nothing listening on 443"; fi
  for v in $(php_versions_in_use); do
    if [ -S "$(fpm_sock "$v")" ]; then ok "PHP $v → $(fpm_sock "$v")"; else bad "no socket for PHP $v"; fi
  done
  echo
}

# ---------------------------------------------------------------------------
# Commands: logs
# ---------------------------------------------------------------------------
log_files() {
  local s
  for s in $(svc_resolve "${1:-all}"); do svc_log "$s"; done
}

existing_logs() {
  local f
  for f in $(log_files "${1:-all}"); do
    if [ -f "$f" ]; then echo "$f"; fi
  done
}

cmd_logs() {
  local files
  files="$(existing_logs "${1:-all}")"
  [ -n "$files" ] || die "No log files yet"
  # shellcheck disable=SC2086
  tail -n "${2:-100}" $files
}

cmd_tail() {
  local files
  files="$(existing_logs "${1:-all}")"
  [ -n "$files" ] || die "No log files yet"
  # shellcheck disable=SC2086
  tail -n 30 -f $files
}

# ---------------------------------------------------------------------------
# Commands: sites
# ---------------------------------------------------------------------------
cmd_sites() {
  need_config
  local dir p name re='^[A-Za-z0-9-]+$'
  [ -n "$VHOSTY_PARKED" ] || die "Nothing parked. Run: vhosty park <folder>"
  while IFS= read -r dir; do
    head_ "$dir"
    for p in "$dir"/*/; do
      [ -d "$p" ] || continue
      name="$(basename "$p")"
      if ! [[ $name =~ $re ]]; then
        info "$name (not a valid hostname: use letters, numbers, dashes)"
      elif php_enabled && [ -f "$p/public/index.php" ]; then
        printf "  https://%s.%s  %s(PHP %s)%s\n" "$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')" "$VHOSTY_DOMAIN" "$D" "$(php_default)" "$N"
      elif [ -f "$p/index.html" ]; then
        printf "  https://%s.%s  %s(static)%s\n" "$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')" "$VHOSTY_DOMAIN" "$D" "$N"
      else
        info "$name (no public/index.php or index.html)"
      fi
    done
  done <<EOF
$(parked_list)
EOF
  echo
}

site_url() {
  need_config
  local name="${1:-}"
  [ -n "$name" ] || name="$(basename "$PWD")"
  echo "https://$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]').$VHOSTY_DOMAIN"
}

cmd_open() {
  local u
  u="$(site_url "${1:-}")"
  if open_url "$u"; then ok "opened $u"; else echo "$u"; fi
}

cmd_url() {
  local u
  u="$(site_url "${1:-}")"
  echo "$u"
  if copy_text "$u" 2>/dev/null; then info "(copied to clipboard)"; fi
}

# ---------------------------------------------------------------------------
# Commands: config
# ---------------------------------------------------------------------------
cmd_validate() {
  local target="${1:-all}" rc=0 v out
  if [ "$target" = "all" ] || [ "$target" = "caddy" ]; then
    load_token
    if out="$(CF_API_TOKEN="$CF_API_TOKEN" "$CADDY_BIN" validate --config "$CADDYFILE" --adapter caddyfile 2>&1)"; then
      ok "Caddyfile is valid"
    else
      bad "Caddyfile has errors:"
      printf '%s\n' "$out" | grep -iE 'error' | tail -5 | sed 's/^/      /' || true
      rc=1
    fi
  fi
  case "$target" in all|php|php-fpm)
    for v in $(php_versions_in_use); do
      if out="$("$(fpm_bin "$v")" -t --fpm-config "$(fpm_conf "$v")" 2>&1)"; then
        ok "PHP $v FPM config is valid"
      else
        bad "PHP $v FPM config has errors:"
        printf '%s\n' "$out" | tail -5 | sed 's/^/      /'
        rc=1
      fi
    done ;;
  esac
  return $rc
}

cmd_edit() {
  need_config
  case "${1:-config}" in
    config) ${EDITOR:-nano} "$CONFIG_FILE"; load_config; cmd_rebuild ;;
    php|ini|php.ini) write_default_php_ini; ${EDITOR:-nano} "$PHP_INI"; cmd_rebuild ;;
    env|token) ${EDITOR:-nano} "$SECRETS_FILE"; chmod 600 "$SECRETS_FILE"; svc_restart caddy; ok "restarted caddy" ;;
    *) die "Unknown file '$1' (use config, php, or env)" ;;
  esac
}

cmd_cert() {
  need_config
  local crt
  crt="$(find "$CADDY_CERTS" -name "wildcard_.$VHOSTY_DOMAIN.crt" 2>/dev/null | head -1 || true)"
  if [ -z "$crt" ]; then
    bad "No certificate for *.$VHOSTY_DOMAIN yet (check: vhosty logs caddy)"
    return 1
  fi
  ok "certificate for *.$VHOSTY_DOMAIN"
  openssl x509 -in "$crt" -noout -issuer -enddate 2>/dev/null | sed 's/^/      /'
}

cmd_dns() {
  need_config
  case "${1:-sync}" in
    sync)
      dns_sync
      # Caddy listens on the Tailscale IP, so a new IP needs a new Caddyfile
      if svc_installed && ! grep -q "default_bind $(ts_ip) " "$CADDYFILE" 2>/dev/null; then cmd_rebuild; fi
      ;;
    *) die "Usage: vhosty dns sync" ;;
  esac
}

cmd_update() {
  need_config
  case "${1:-all}" in
    caddy) install_caddy ;;
    php|php-fpm)
      php_enabled || die "PHP is turned off"
      is_macos || die "On Linux, PHP comes from apt: sudo apt update && sudo apt upgrade"
      install_php_fpm "${2:-$(php_default)}" ;;
    all)
      install_caddy
      if php_enabled && is_macos; then install_php_fpm "$(php_default)"; fi ;;
    *) die "Usage: vhosty update [caddy|php [8.x]]" ;;
  esac
  if svc_installed; then cmd_restart all; fi
}

cmd_paths() {
  local s
  cat <<EOF
  vhosty dir    $VHOSTY_DIR
  Config        $CONFIG_FILE
  PHP settings  $PHP_INI
  Token         $SECRETS_FILE
  Caddyfile     $CADDYFILE
  FPM configs   $PHP_CONF_DIR/<version>/php-fpm.conf
  Binaries      $BIN_DIR
  Logs          $LOG_DIR
  Sockets       $RUN_DIR
EOF
  if is_linux; then
    printf "  Services      %s/vhosty-caddy.service\n" "$UNIT_DIR"
    printf "                %s/vhosty-php@.service\n" "$UNIT_DIR"
  else
    printf "  Services      %s\n" "$(plist_for caddy)"
    for s in $(svc_all); do [ "$s" = caddy ] || printf "                %s\n" "$(plist_for "$s")"; done
  fi
  printf "  Certificates  %s\n" "$CADDY_CERTS"
}

# ---------------------------------------------------------------------------
# Command: doctor
# ---------------------------------------------------------------------------
cmd_doctor() {
  need_config
  FAILED=0
  is_macos && sudo -v
  local ip probe resolved s st code o v
  ip="$(ts_ip)"
  probe="vhosty-doctor.$VHOSTY_DOMAIN"
  printf "%svhosty doctor%s  (*.%s)\n" "$B" "$N" "$VHOSTY_DOMAIN"

  head_ "Network"
  if [ -n "$ip" ]; then ok "Tailscale IP: $ip"; else bad "Tailscale isn't running, or its CLI wasn't found"; fi
  resolved="$(dig +short "$probe" A 2>/dev/null | tail -1 || true)"
  if [ -z "$resolved" ]; then
    bad "*.$VHOSTY_DOMAIN doesn't resolve. Run: vhosty dns sync"
  elif [ -n "$ip" ] && [ "$resolved" != "$ip" ]; then
    bad "*.$VHOSTY_DOMAIN resolves to $resolved, expected $ip. Run: vhosty dns sync"
  else
    ok "*.$VHOSTY_DOMAIN resolves to $resolved"
  fi

  head_ "Caddy"
  if [ -x "$CADDY_BIN" ]; then ok "binary: $("$CADDY_BIN" version 2>/dev/null | awk '{print $1}')"; else bad "Caddy missing. Run: vhosty update caddy"; fi
  if "$CADDY_BIN" list-modules 2>/dev/null | grep -q dns.providers.cloudflare; then ok "Cloudflare DNS plugin"; else bad "Caddy is missing the Cloudflare plugin. Run: vhosty update caddy"; fi
  if is_linux; then
    if getcap "$CADDY_BIN" 2>/dev/null | grep -q cap_net_bind_service; then ok "allowed to use ports 80 and 443"; else bad "Caddy can't bind 80/443. Run: vhosty setup"; fi
  fi
  if [ -s "$SECRETS_FILE" ]; then ok "token file present"; else bad "Missing $SECRETS_FILE. Run: vhosty setup"; fi
  cmd_validate caddy || true
  cmd_cert || true

  if php_enabled; then
    head_ "PHP"
    for v in $(php_versions_in_use); do
      if php_is_installed "$v"; then ok "PHP $v: $("$(fpm_bin "$v")" -v 2>/dev/null | head -1 | awk '{print $2}')"
      else bad "PHP $v isn't installed"; fi
    done
    cmd_validate php || true
  fi

  head_ "Services"
  if is_linux; then
    if [ "$(loginctl show-user "$VHOSTY_USER" -p Linger --value 2>/dev/null)" = "yes" ]; then ok "start at boot (linger on)"
    else bad "services won't start until you log in. Run: vhosty setup"; fi
  fi
  for s in $(svc_all); do
    st="$(svc_state "$s")"
    if [ "$st" = "running" ]; then ok "$s running"
    elif svc_installed; then bad "$s $st. Run: vhosty start (logs: vhosty logs $s)"
    else bad "$s not installed. Run: vhosty setup"; fi
  done
  o="$(port_owner 443)"; if [ -n "$o" ]; then ok "443 → $o"; else bad "nothing listening on 443"; fi
  for v in $(php_versions_in_use); do
    if [ -S "$(fpm_sock "$v")" ]; then ok "PHP $v socket"; else bad "no socket for PHP $v"; fi
  done

  head_ "End to end"
  code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 8 "https://$probe/" 2>/dev/null || true)"
  if [ -n "$code" ] && [ "$code" != "000" ]; then
    ok "https://$probe answered with HTTP $code"
  else
    bad "Couldn't reach https://$probe (TLS or connection failed)"
  fi

  echo
  if [ "$FAILED" = "0" ]; then
    printf "%sAll good.%s\n" "$G" "$N"
  else
    printf "%sSome checks failed. See above.%s\n" "$R" "$N"
    return 1
  fi
}

# ---------------------------------------------------------------------------
# Command: uninstall
# ---------------------------------------------------------------------------
cmd_uninstall() {
  local s
  confirm "Stop and remove the vhosty services? (~/.vhosty and your DNS record stay)" N || { info "Cancelled."; return 0; }
  if is_linux; then
    for s in $(sd list-unit-files 'vhosty-*' --plain --no-legend 2>/dev/null | awk '{print $1}'; sd list-units 'vhosty-php@*' --all --plain --no-legend 2>/dev/null | awk '{print $1}'); do
      svc_remove "$s"
    done
    rm -f "$UNIT_DIR/vhosty-caddy.service" "$UNIT_DIR/vhosty-php@.service"
    sd daemon-reload
    ok "removed the systemd user services"
    info "Linger stays on (other user services may need it). To turn it off: sudo loginctl disable-linger $VHOSTY_USER"
  else
    for s in $(svc_all) $(launchd_stale); do
      if [ -f "$(plist_for "$s")" ]; then svc_remove "$s"; ok "removed $(label_of "$s")"; fi
    done
  fi
  info "To remove everything: rm -rf $VHOSTY_DIR, and delete the *.$VHOSTY_DOMAIN record in Cloudflare."
}

# ---------------------------------------------------------------------------
# Help
# ---------------------------------------------------------------------------
usage() {
  cat <<EOF
${B}vhosty${N} $VHOSTY_VERSION: Herd for your tailnet

${B}Setup${N}
  vhosty setup [--domain D] [--token T] [--park DIR] [--no-php] [--yes]
  vhosty uninstall                   Remove the services (keeps your files)

${B}Sites${N}
  vhosty park [dir]                  Serve every folder in dir (default: current)
  vhosty unpark [dir]                Stop serving a parked folder
  vhosty parked                      List parked folders
  vhosty sites                       List sites and their URLs
  vhosty open [site|port]            Open in the browser (default: current folder)
  vhosty url  [site|port]            Print the URL and copy it

${B}Services${N}
  vhosty start   [caddy|php|php-8.x] Start services (default: all)
  vhosty stop    [caddy|php|php-8.x] Stop services
  vhosty restart [caddy|php|php-8.x] Validate config, then restart
  vhosty status                      Service state, PIDs, and sockets
  vhosty logs [service] [N]          Show the last N log lines (default 100)
  vhosty tail [service]              Follow logs live

${B}Config${N}
  vhosty edit [config|php|env]       Edit settings, PHP settings, or the token, then apply
  vhosty rebuild                     Regenerate config and reload services
  vhosty dns sync                    Point *.domain at this machine's Tailscale IP
  vhosty update [caddy|php [8.x]]    Re-download Caddy (or PHP-FPM, on macOS)
  vhosty validate                    Check the generated config
  vhosty cert                        Show the wildcard certificate and expiry
  vhosty doctor                      Check DNS, certs, services, and HTTPS end to end
  vhosty ip | domain | paths         Quick lookups
  vhosty version
EOF
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
main() {
  local cmd="${1:-help}"
  if [ $# -gt 0 ]; then shift; fi
  load_config

  case "$cmd" in
    setup)              cmd_setup "$@" ;;
    park|link)          cmd_park "${1:-}" ;;
    unpark|unlink)      cmd_unpark "${1:-}" ;;
    parked)             cmd_parked ;;
    sites|ls)           cmd_sites ;;
    open)               cmd_open "${1:-}" ;;
    url)                cmd_url "${1:-}" ;;
    start|stop|restart) "cmd_$cmd" "${1:-all}" ;;
    status|st)          cmd_status ;;
    logs|log)           cmd_logs "${1:-all}" "${2:-100}" ;;
    tail|follow)        cmd_tail "${1:-all}" ;;
    edit)               cmd_edit "${1:-config}" ;;
    rebuild)            cmd_rebuild ;;
    dns)                cmd_dns "${1:-sync}" ;;
    update)             cmd_update "${1:-all}" "${2:-}" ;;
    validate|check)     need_config; cmd_validate "${1:-all}" ;;
    cert|certs)         cmd_cert ;;
    doctor|dr)          cmd_doctor ;;
    ip)                 local ip; ip="$(ts_ip)"; [ -n "$ip" ] || die "Tailscale isn't running"; echo "$ip" ;;
    domain)             need_config; echo "$VHOSTY_DOMAIN" ;;
    paths)              cmd_paths ;;
    uninstall)          cmd_uninstall ;;
    version|-v|--version) echo "vhosty $VHOSTY_VERSION" ;;
    help|-h|--help)     usage ;;
    *) die "Unknown command '$cmd'. Run: vhosty help" ;;
  esac
}

main "$@"
